<?xml version="1.0"?>
<!-- SCAN-Planner for SimEnv: local collision-aware B-spline planner (navi_mode=1: goal-based). -->
<launch>
  <arg name="navi_mode" default="1"/>
  <arg name="sensor_type" default="lidar"/>
  <arg name="max_vel" default="1.5"/>
  <arg name="max_acc" default="2.0"/>
  <arg name="command_topic" default="/cmd_vel"/>
  <arg name="manual_goal_use_current_height" default="false"/>

  <arg name="body_pose_topic" default="/Odometry_gazebo"/>
  <arg name="sensor_pose_topic" default="/Odometry_gazebo"/>
  <arg name="cloud_topic" default="/registered_scan"/>
  <arg name="cloud_is_world" default="true"/>

  <param name="body_pose_topic" value="$(arg body_pose_topic)" type="str"/>

  <include file="$(find scan_planner)/launch/advanced_param.xml">
    <arg name="sensor_type" value="$(arg sensor_type)"/>
    <arg name="body_pose_topic" value="$(arg body_pose_topic)"/>
    <arg name="sensor_pose_topic" value="$(arg sensor_pose_topic)"/>
    <arg name="cloud_topic" value="$(arg cloud_topic)"/>
    <arg name="cloud_is_world" value="$(arg cloud_is_world)"/>
    <arg name="depth_topic" value="/camera/aligned_depth_to_color/image_raw"/>
    <arg name="cx" value="317.19"/>
    <arg name="cy" value="256.48"/>
    <arg name="fx" value="609.59"/>
    <arg name="fy" value="609.22"/>
    <arg name="is_real_world" value="true"/>
    <arg name="navi_mode" value="$(arg navi_mode)"/>
    <arg name="max_vel" value="$(arg max_vel)"/>
    <arg name="max_acc" value="$(arg max_acc)"/>
    <arg name="manual_goal_use_current_height"
         value="$(arg manual_goal_use_current_height)"/>
  </include>

  <node pkg="scan_planner" name="closed_loop_controller" type="closed_loop_controller" output="screen">
    <remap from="cmd_vel" to="$(arg command_topic)"/>
  </node>
</launch>
