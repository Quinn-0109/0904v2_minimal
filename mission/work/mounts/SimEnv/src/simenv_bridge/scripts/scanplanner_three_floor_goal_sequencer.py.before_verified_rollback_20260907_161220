        self._plane_attitude_slowdown_upright_z = min(
            1.0, max(0.0, float(rospy.get_param(
                "~plane_attitude_slowdown_upright_z", 0.97))))
        self._plane_attitude_hold_upright_z = min(
            self._plane_attitude_slowdown_upright_z - 1.0e-6,
            max(0.0, float(rospy.get_param(
                "~plane_attitude_hold_upright_z", 0.90))))
