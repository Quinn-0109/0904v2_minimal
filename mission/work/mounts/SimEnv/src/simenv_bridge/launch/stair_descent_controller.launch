<?xml version="1.0"?>
<!--
  Shared F3 -> F2 -> F1 physical stair-RL controller.

  Both the complete exploration mission and the isolated descent smoke test
  include this file, so a smoke-test pass exercises the same manager and tune
  used by the real mission.  Only the trigger source and entry-guide mode are
  launch-specific.
-->
<launch>
  <arg name="output_dir"/>
  <arg name="odom_topic" default="/Odometry_gazebo"/>
  <arg name="stair_policy"/>
  <arg name="stair_model_sdf"/>
  <arg name="layout_metadata"/>
  <arg name="mission_trigger_topic"/>
  <arg name="mission_trigger_token"/>
  <arg name="truth_entry_guide" default="true"/>
  <arg name="skip_entry_guide" default="false"/>
  <arg name="trigger_timeout_sec" default="2400.0"/>
  <arg name="descent_speed_mps" default="0.80"/>

  <node pkg="simenv_bridge" type="stair_descent_manager.py"
        name="stair_descent_manager" output="screen" required="false">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="stair_policy" value="$(arg stair_policy)"/>
    <param name="start_floor_number" value="3"/>
    <param name="end_floor_number" value="1"/>
    <param name="mission_trigger_topic" value="$(arg mission_trigger_topic)"/>
    <param name="mission_trigger_token" value="$(arg mission_trigger_token)"/>
    <param name="state_topic" value="/simenv/third_to_first_floor_stair_state"/>
    <param name="transition_log_basename" value="stair_descent.json"/>
    <param name="segment_one_log_basename" value="third_to_second_floor_stair_transition.json"/>
    <param name="segment_two_log_basename" value="second_to_first_floor_stair_transition.json"/>
    <param name="offline_stair_model_sdf" value="$(arg stair_model_sdf)"/>
    <param name="offline_truth_layout_metadata" value="$(arg layout_metadata)"/>
    <param name="truth_entry_guide" value="$(arg truth_entry_guide)"/>
    <param name="skip_entry_guide" value="$(arg skip_entry_guide)"/>
    <param name="truth_two_stage_guide" value="true"/>
    <param name="descent_speed_mps" value="$(arg descent_speed_mps)"/>
    <param name="descent_maximum_speed_mps" value="0.80"/>
    <param name="descent_segment_timeout_sec" value="600.0"/>
    <param name="truth_descent_trigger_timeout_sec" value="$(arg trigger_timeout_sec)"/>
    <param name="pre_descent_stand_seconds" value="0.25"/>
    <param name="policy_switch_settle_seconds" value="0.45"/>
    <param name="policy_switch_settle_timeout_sec" value="6.0"/>
    <param name="policy_switch_max_joint_velocity_rms" value="0.35"/>
    <param name="policy_switch_fixed_stand_timeout_sec" value="12.0"/>
    <param name="policy_switch_fast_fixed_stand" value="true"/>
    <param name="policy_switch_fast_fixed_stand_duration_seconds" value="0.50"/>
    <param name="policy_switch_fast_fixed_stand_settle_seconds" value="0.00"/>
    <param name="policy_switch_fast_fixed_stand_minimum_elapsed_seconds" value="0.50"/>
    <param name="policy_switch_fast_fixed_stand_stable_seconds" value="0.50"/>
    <!-- The target is the just-captured current pose, so a 0.75 impedance
         floor adds no position jump.  It removes the low-gain single-support
         window that rolled final_v3 seed-2 over before FixedStand became ready. -->
    <param name="policy_switch_fast_fixed_stand_minimum_gain_ratio" value="0.75"/>
    <param name="policy_switch_queue_hold_seconds" value="0.25"/>
    <param name="policy_switch_reentry_timeout_sec" value="20.0"/>
    <!-- Fresh locomotion-ready already proves that the 0.75/0.25 s stair
         takeover blend completed.  Retain an additional bounded hold, but
         do not charge the old redundant 1.2 s default before another stand. -->
    <param name="policy_warmup_seconds" value="0.75"/>
    <param name="truth_descent_entry_guide_speed_mps" value="1.15"/>
    <param name="truth_descent_stall_seconds" value="3.0"/>
    <!-- Peak at 0.80 m/s only after the first contact cycle, then slow for
         the last few treads or whenever body tilt grows. -->
    <param name="truth_descent_flight_initial_speed_mps" value="0.55"/>
    <param name="truth_descent_flight_initial_hold_drop_m" value="0.18"/>
    <param name="truth_descent_flight_initial_ramp_end_drop_m" value="0.45"/>
    <param name="truth_descent_flight_end_slowdown_drop_m" value="0.95"/>
    <param name="truth_descent_flight_end_speed_mps" value="0.60"/>
    <!-- A normal planted stair pose repeatedly reaches about 0.45 rad.  The
         intermediate cap starts at 0.48 rad and retains 0.55 m/s contact
         speed; the unchanged 0.60 rad severe guard still drops immediately
         to 0.30 m/s. -->
    <param name="truth_descent_flight_tilt_slowdown_rad" value="0.48"/>
    <param name="truth_descent_flight_tilt_speed_mps" value="0.55"/>
    <param name="truth_descent_flight_tilt_hold_sec" value="0.60"/>
    <param name="truth_descent_flight_severe_tilt_rad" value="0.60"/>
    <param name="truth_descent_flight_severe_tilt_speed_mps" value="0.30"/>
    <param name="truth_descent_flight_severe_tilt_hold_sec" value="0.80"/>
    <!-- Segment two already completed both flights at 0.80 m/s without these
         periodic holds; removing them makes segment one follow the same
         proven continuous profile instead of adding a ramp after every step. -->
    <param name="truth_descent_step_pause_seconds" value="0.00"/>
    <param name="truth_descent_step_pause_interval_m" value="0.18"/>
    <param name="truth_descent_backoff_escalation_m" value="0.15"/>
    <param name="truth_descent_gain_up_drop_m" value="0.35"/>
    <param name="truth_descent_flight_a_end_y" value="1.75"/>
    <param name="truth_descent_final_landing_settle_seconds" value="1.0"/>
    <param name="truth_descent_final_landing_timeout_sec" value="20.0"/>
    <param name="truth_descent_final_landing_minimum_upright_z" value="0.75"/>
    <param name="truth_descent_final_landing_max_tilt_rad" value="0.45"/>
    <param name="truth_descent_final_landing_min_body_height_m" value="0.20"/>
    <param name="truth_descent_final_landing_max_body_height_m" value="1.00"/>
    <param name="truth_descent_max_center_error_m" value="0.40"/>
    <param name="truth_descent_side_slip_pause_sec" value="0.50"/>
    <!-- Run at 0.80 m/s while centred.  Before a lateral error reaches the
         hard guard, trade a little forward speed for stronger steering. -->
    <param name="truth_descent_flight_center_steer_gain" value="1.00"/>
    <param name="truth_descent_flight_center_steer_max_rad" value="0.24"/>
    <param name="truth_descent_flight_heading_gain" value="0.55"/>
    <param name="truth_descent_flight_max_yaw_rate_rps" value="0.14"/>
    <param name="truth_descent_flight_center_correction_error_m" value="0.22"/>
    <param name="truth_descent_flight_center_correction_speed_mps" value="0.50"/>
    <param name="truth_descent_flight_center_correction_yaw_rate_rps" value="0.20"/>
    <param name="truth_descent_flight_heading_correction_error_rad" value="0.22"/>
    <param name="truth_descent_flight_heading_correction_speed_mps" value="0.40"/>
    <param name="truth_descent_flight_heading_correction_yaw_rate_rps" value="0.30"/>
    <param name="truth_descent_landing_heading_tolerance_rad" value="0.18"/>
    <param name="truth_descent_landing_position_tolerance_m" value="0.12"/>
    <param name="truth_descent_landing_recenter_speed_mps" value="0.40"/>
    <param name="truth_descent_landing_minimum_x_speed_mps" value="0.30"/>
    <param name="truth_descent_landing_minimum_yaw_rate_rps" value="0.34"/>
    <!-- Both successful turns re-planted immediately with no slip recovery.
         Keep 1.5 s of zero-command landing stabilization, then use the same
         1.20 rad/s bounded flat-platform turn cap proven on both ascents. -->
    <param name="truth_descent_landing_settle_seconds" value="1.50"/>
    <param name="truth_descent_landing_turn_speed_rps" value="1.20"/>
    <param name="truth_descent_landing_slip_max_attempts" value="4"/>
    <param name="truth_descent_turn_start_y" value="5.05"/>
    <param name="truth_descent_turn_forward_speed_mps" value="0.08"/>
    <param name="truth_descent_turn_forward_y_limit_m" value="4.82"/>
    <param name="truth_descent_segment_turn_yaw_rate_rps" value="1.00"/>
    <param name="truth_descent_segment_turn_lateral_speed_mps" value="0.40"/>
    <param name="truth_descent_segment_turn_side_speed_mps" value="0.40"/>
    <param name="truth_descent_segment_turn_drift_limit_m" value="0.40"/>
    <param name="truth_descent_segment_turn_progress_timeout_sec" value="2.8"/>
    <param name="truth_descent_segment_turn_progress_min_improvement_rad" value="0.11"/>
    <!-- The stair gait ignores a 0.13 m residual flat-landing side command;
         accept it inside the existing 0.25 m safety envelope and recover if
         a genuinely larger alignment command makes no progress. -->
    <param name="truth_descent_segment_turn_position_tolerance_m" value="0.16"/>
    <param name="truth_descent_segment_turn_alignment_progress_timeout_sec" value="3.0"/>
    <param name="truth_descent_segment_turn_alignment_progress_min_m" value="0.025"/>
    <param name="truth_descent_segment_turn_x_safe_tolerance_m" value="0.25"/>
    <param name="truth_descent_segment_turn_y_safe_high_m" value="1.95"/>
    <param name="truth_descent_segment_turn_alignment_minimum_speed_mps" value="0.30"/>
    <param name="truth_descent_east_align_minimum_x_speed_mps" value="0.30"/>
    <param name="truth_descent_east_align_tread_drop_m" value="0.05"/>
    <param name="truth_descent_minimum_upright_z" value="0.55"/>
    <param name="command_topic" value="/cmd_vel"/>
  </node>
</launch>
