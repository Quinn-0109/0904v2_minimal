<?xml version="1.0"?>
<package format="2">
  <name>simenv_bridge</name>
  <version>0.1.0</version>
  <description>Bridge nodes connecting SimEnv navigation to Unitree A1, including a three-floor plane/stair RL gait mission.</description>
  <maintainer email="bridge@simenv.local">simenv bridge</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <test_depend>rostest</test_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_sensor_msgs</exec_depend>
  <exec_depend>building_generator_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
</package>
