        self.door_heading_tolerance = float(rospy.get_param(
            "~door_heading_tolerance", 0.10))
        self.enable_door_commit = bool(rospy.get_param(
            "~enable_door_commit", True))
        self.motion_topology_interval = float(rospy.get_param(
            "~motion_topology_interval", 0.45))
        self.enable_door_attention = bool(rospy.get_param(
            "~enable_door_attention", True))
        self.door_attention_observation_frames = int(rospy.get_param(
            "~door_attention_observation_frames", 3))
        self.door_attention_timeout = float(rospy.get_param(
            "~door_attention_timeout", 3.0))
        self.enable_opposite_door_attention = bool(rospy.get_param(
            "~enable_opposite_door_attention", True))
        self.opposite_door_station_tolerance = float(rospy.get_param(
            "~opposite_door_station_tolerance", 0.90))
        self.enable_execution_safety_monitor = bool(rospy.get_param(
            "~enable_execution_safety_monitor", True))
        self.execution_safety_interval = float(rospy.get_param(
            "~execution_safety_interval", 0.20))
        self.execution_safety_lookahead = float(rospy.get_param(
            "~execution_safety_lookahead", 0.55))
        self.execution_max_cross_track_error = float(rospy.get_param(
            "~execution_max_cross_track_error", 0.35))
        self.execution_safety_confirmation_cycles = int(rospy.get_param(
            "~execution_safety_confirmation_cycles", 2))
        self.room_maximum_macro_goals = int(rospy.get_param(
            "~room_maximum_macro_goals", 3))
        self.door_channel_transient_retry_cycles = int(rospy.get_param(
            "~door_channel_transient_retry_cycles", 3))
        # A channel fit may correct voxel quantisation around one aperture, but
        # may never search far enough to turn a different corridor gap into
        # the candidate's door.  The previous adaptive bounds reached 3--5 m.
        self.door_channel_max_tangent_adjustment = float(rospy.get_param(
            "~door_channel_max_tangent_adjustment", 0.60))
        self.door_channel_max_normal_adjustment = float(rospy.get_param(
            "~door_channel_max_normal_adjustment", 0.35))
        self.door_sweep_jitter_max_footprint_collisions = int(rospy.get_param(
            "~door_sweep_jitter_max_footprint_collisions", 2))
        # Corridor-network routes may include ninety-degree junction turns.
        # A point-sized A* path can clip the inside corner even though every
        # centre cell is free, so use a wider planning stencil before the
        # authoritative oriented-footprint validation.  Keep this separate
        # from room-local planning, where a circular approximation would
        # unnecessarily discard useful viewpoints.
        self.corridor_network_clearance = float(rospy.get_param(
            "~corridor_network_clearance", 0.40))
        self.initial_unknown_footprint_grace = float(rospy.get_param(
