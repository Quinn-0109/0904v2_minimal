        rospy.on_shutdown(self._shutdown)

    def elapsed(self) -> float:
        return 0.0 if not self.start_wall else time.monotonic() - self.start_wall

    @staticmethod
    def _atomic_json(path: str, payload) -> None:
        temporary = path + ".tmp"
        with open(temporary, "w", encoding="utf-8") as stream:
            json.dump(payload, stream, ensure_ascii=False, indent=2, sort_keys=True)
            stream.write("\n")
        os.replace(temporary, path)

    @staticmethod
    def _load_json(path: str):
        try:
            with open(path, encoding="utf-8") as stream:
                return json.load(stream)
        except (OSError, ValueError):
            return None

    def _event(self, name: str, **extra) -> None:
        payload = {"t": round(self.elapsed(), 3), "event": name,
                   "phase": self.phase.value}
        payload.update(extra)
        self.events.append(payload)
        self.state_pub.publish(String(data=json.dumps(payload, sort_keys=True)))
        rospy.loginfo("Structured exploration: %s phase=%s", name, self.phase.value)

    @staticmethod
    def _door_commit_goals(door: Doorway, outside_distance: float,
                           inside_distance: float) -> dict:
        """Build every traversal goal once from one immutable door plane."""
        nx, ny = door.normal
        outside = [door.center[0] - outside_distance * nx,
                   door.center[1] - outside_distance * ny]
        inside = [door.center[0] + inside_distance * nx,
                  door.center[1] + inside_distance * ny]
        return {
            "approach_door": list(outside),
            "door_attention_verify": list(outside),
            "door_precise_alignment": list(outside),
            "cross_door": list(inside),
        }

    def _record_door_commit(self, action: str, *, unlock_reason=None,
                            detected_center=None, difference_distance=None,
                            ignored=None, door_goal=None,
                            snapshot: Optional[dict] = None) -> None:
        commit = snapshot if snapshot is not None else self.door_commit
        pose = None if self.pose is None else {
            key: float(self.pose[key]) for key in ("x", "y", "z", "yaw")}
        record = {
            "timestamp": round(self.elapsed(), 3),
            "action": action,
            "door_locked": bool(self.door_locked),
            "door_id": None if commit is None else commit["door_id"],
            "door_center": None if commit is None else commit["center"],
            "door_normal": None if commit is None else commit["normal"],
            "door_width": None if commit is None else commit["width"],
            "door_inside_direction": (
                None if commit is None else commit["inside_direction"]),
            "door_goal": (door_goal if door_goal is not None else
                          None if commit is None else commit["goals"]),
            "robot_pose": pose,
            "current_state": self.phase.value,
            "unlock_reason": unlock_reason,
        }
        if detected_center is not None:
            record.update({
                "detected_center": [float(detected_center[0]),
                                    float(detected_center[1])],
                "locked_center": list(commit["center"]),
                "difference_distance": float(difference_distance),
                "ignored": bool(ignored),
            })
        self.door_commit_history.append(record)

    def _restore_committed_door(self, door: Optional[Doorway]) -> Optional[Doorway]:
        commit = self.door_commit
        if (door is None or not self.enable_door_commit or
                not self.door_locked or commit is None or
                door.door_id != commit["door_id"]):
            return door
        for attribute in (
                "center", "normal_direction", "width", "left_frame_point",
                "right_frame_point", "corridor_side", "interior_side"):
            setattr(door, attribute, commit[attribute])
        door.geometry_locked = True
        return door

    def _committed_goal(self, door: Doorway, state: str,
                        fallback: Point) -> Point:
        if (not self.enable_door_commit or not self.door_locked or
                self.door_commit is None or
                door.door_id != self.door_commit["door_id"]):
            return fallback
        goal = tuple(self.door_commit["goals"][state])
        self._record_door_commit(
            "committed_goal_used", door_goal={state: list(goal)})
        return goal

    def _allow_door_geometry_refresh(self, door: Doorway) -> None:
        if (self.door_locked and self.door_commit is not None and
                door.door_id == self.door_commit["door_id"]):
            self._restore_committed_door(door)
            return
        door.geometry_locked = False

    def _lock_current_door(self, reason: str) -> bool:
        if not self.enable_door_commit:
            return False
        if self.door_locked:
            self._restore_committed_door(self._door(self.current_door_id))
            return self.door_commit is not None
        door = next((item for item in self.topology.doors
                     if item.door_id == self.current_door_id), None)
        if door is None:
            self._event("door_commit_lock_failed", door_id=self.current_door_id,
                        reason="selected_door_missing")
            return False
        nx, ny = door.normal
        self.door_commit = {
            "door_id": door.door_id,
            "center": tuple(door.center),
            "normal_direction": float(door.normal_direction),
            "normal": (float(nx), float(ny)),
            "inside_direction": (float(nx), float(ny)),
            "width": float(door.width),
            "left_frame_point": tuple(door.left_frame_point),
            "right_frame_point": tuple(door.right_frame_point),
            "corridor_side": tuple(door.corridor_side),
            "interior_side": tuple(door.interior_side),
            "previous_geometry_locked": bool(door.geometry_locked),
            "goals": self._door_commit_goals(
                door, self.p.door_outside_distance,
                self.p.door_inside_distance),
        }
        self.door_locked = True
        door.geometry_locked = True
        self._restore_committed_door(door)
        self._record_door_commit("lock")
        self._event("door_commit_locked", door_id=door.door_id,
                    center=door.center, normal=door.normal, width=door.width,
                    reason=reason)
        return True

    def _unlock_door_commit(self, reason: str,
                            preserve_entry_geometry: bool = False) -> None:
        if not self.door_locked or self.door_commit is None:
            return
        commit = self.door_commit
        self.door_staging_route_overrides.discard(commit["door_id"])
        door = next((item for item in self.topology.doors
                     if item.door_id == commit["door_id"]), None)
        self._restore_committed_door(door)
        if door is not None:
            door.geometry_locked = bool(
                preserve_entry_geometry or commit["previous_geometry_locked"])
        self.door_locked = False
        self._record_door_commit(
            "unlock", unlock_reason=reason, snapshot=commit)
        self._event("door_commit_unlocked", door_id=commit["door_id"],
                    reason=reason,
                    preserve_entry_geometry=preserve_entry_geometry)
        self.door_commit = None

    def _maybe_unlock_completed_door_commit(self, pose: dict) -> None:
        if not self.door_locked or self.door_commit is None:
            return
        commit = self.door_commit
        if (self.current_door_id != commit["door_id"] or
                self.current_room_id is None):
            return
        delta = (pose["x"] - commit["center"][0],
                 pose["y"] - commit["center"][1])
        signed_depth = dot(delta, commit["inside_direction"])
        center_distance = math.hypot(delta[0], delta[1])
        if signed_depth > 1.50 and center_distance > 1.50:
            self._unlock_door_commit(
                "robot_inside_beyond_1.5m", preserve_entry_geometry=True)

    def _transition(self, phase: MissionPhase, reason: str) -> None:
        # A safety failure is terminal.  Nested path callers may still return
        # False and attempt their normal recovery transition; never allow that
        # to revive a mission after _fail_mission().
        if self.phase == MissionPhase.FINISHED and phase != MissionPhase.FINISHED:
            return
        if self.phase == phase:
            return
        old = self.phase
        self.previous_phase = old
        self.phase = phase
        if (self.door_locked and phase in (
                MissionPhase.RECOVERY, MissionPhase.GLOBAL_RECOVERY)):
            self._unlock_door_commit(
                "door_traversal_failed_entered_{}".format(phase.value.lower()))
        elif (self.door_locked and phase == MissionPhase.SELECT_NEXT_ROOM and
              old in (MissionPhase.APPROACH_DOOR, MissionPhase.CROSS_DOOR)):
            self._unlock_door_commit("current_door_explicitly_abandoned")
        if phase == MissionPhase.APPROACH_DOOR:
            self._lock_current_door(reason)
        if phase == MissionPhase.GLOBAL_RECOVERY:
            self.global_no_candidate_cycles = 0
        if phase == MissionPhase.RECOVERY:
            self.no_candidate_cycles = 0
            self.recovery_escape_failed_targets = []
            self.recovery_failed_targets = []
            self.recovery_escape_attempts = 0
        self._event("state_transition", previous=old.value, reason=reason)

    def _fail_mission(self, reason: str) -> None:
        self.exploration_complete = False
        self.termination_reason = reason
        self._transition(MissionPhase.FINISHED, reason)

    def _first_room_entry_timeout_reached(self) -> bool:
        # Once a strong portal has taken control, finish that bounded entry
        # attempt instead of letting the older global first-room deadline
        # cancel it mid-alignment.
        if self.door_candidate_takeover is not None and not self.rooms:
            return False
        return first_room_entry_timeout_reached(
            self.elapsed(), len(self.rooms), self.first_room_entry_timeout)

    def _on_grid(self, message: OccupancyGrid) -> None:
        expected = int(message.info.width) * int(message.info.height)
        if expected <= 0 or len(message.data) != expected:
            return
        array = np.asarray(message.data, dtype=np.int16).reshape(
            (int(message.info.height), int(message.info.width)))
        grid = OccupancyMap(array, float(message.info.resolution),
                            float(message.info.origin.position.x),
                            float(message.info.origin.position.y))
        with self.lock:
            self.grid = grid
            self.grid_frame = message.header.frame_id or self.grid_frame
            self.grid_stamp = time.monotonic()
            self.grid_sequence += 1

    def _on_odom(self, message: Odometry) -> None:
        p, q = message.pose.pose.position, message.pose.pose.orientation
        pose = {"x": float(p.x), "y": float(p.y), "z": float(p.z),
                "yaw": quaternion_yaw(q.x, q.y, q.z, q.w)}
        if not all(math.isfinite(value) for value in pose.values()):
            return
        now = time.monotonic()
        with self.lock:
            previous = self.pose
            self.pose = pose
            self.pose_stamp = now
            self.pose_frame = message.header.frame_id or self.pose_frame
            if not self.trajectory or now - self.trajectory[-1]["wall"] >= 0.10:
                sample = {"t": round(self.elapsed(), 3), **pose, "wall": now,
                          "stamp": float(message.header.stamp.to_sec())}
                self.trajectory.append(sample)
                cell = (int(round(pose["x"] / 0.25)), int(round(pose["y"] / 0.25)))
                if cell not in self.visited_cells:
                    self.visited_cells.add(cell)
                    self.last_visited_growth = now
            if previous is not None:
                self._record_door_crossings((previous["x"], previous["y"]),
                                            (pose["x"], pose["y"]))
                if self.command_active and self.grid is not None and distance(
                        (previous["x"], previous["y"]), (pose["x"], pose["y"])) > 0.02:
                    actual = validate_path(
                        self.grid,
                        [(previous["x"], previous["y"]), (pose["x"], pose["y"])],
                        spacing=self.p.path_sample_spacing,
                    )
                    if not actual.valid:
                        self.path_history.append({
                            "t": round(self.elapsed(), 3),
                            "phase": self.phase.value,
                            "source": "actual_trajectory_segment",
                            "path": [(previous["x"], previous["y"]),
                                     (pose["x"], pose["y"])],
                            "execution_authorized": True,
                            "actual_execution": True,
                            **actual.to_dict(),
                        })
            self._maybe_unlock_completed_door_commit(pose)

    def _on_ground_truth(self, message: Odometry) -> None:
        """Record passive simulator truth for post-run plots only."""
        if not self.start_wall:
            return
        p, q = message.pose.pose.position, message.pose.pose.orientation
        sample = {
            "t": round(self.elapsed(), 3),
            "x": float(p.x), "y": float(p.y), "z": float(p.z),
            "yaw": quaternion_yaw(q.x, q.y, q.z, q.w),
            "wall": time.monotonic(),
            "stamp": float(message.header.stamp.to_sec()),
        }
        if not all(math.isfinite(sample[key]) for key in ("x", "y", "z", "yaw")):
            return
        with self.lock:
            if (not self.ground_truth_trajectory or
                    sample["wall"] - self.ground_truth_trajectory[-1]["wall"] >= 0.10):
                self.ground_truth_trajectory.append(sample)

    def _record_door_crossings(self, previous: Point, current: Point) -> None:
        candidates = []
        for door in self.topology.doors:
            if not door.confirmed:
                continue
            current_depth = door.signed_depth(current)
            current_side = 1 if current_depth >= 0.08 else (
                -1 if current_depth <= -0.08 else 0)
            if current_side == 0:
                continue
            stable = self.door_stable_sides.get(door.door_id)
            if stable is None:
                self.door_stable_sides[door.door_id] = (current_side, current)
                continue
            previous_side, stable_point = stable
            self.door_stable_sides[door.door_id] = (current_side, current)
            if current_side == previous_side:
                continue
            a, b = door.signed_depth(stable_point), current_depth
            denominator = abs(a) + abs(b)
            alpha = 0.5 if denominator < 1e-8 else abs(a) / denominator
            crossing = (
                stable_point[0] + alpha * (current[0] - stable_point[0]),
                stable_point[1] + alpha * (current[1] - stable_point[1]))
            lateral = abs(door.lateral_offset(crossing))
            if lateral > 0.5 * door.width + 0.45:
                continue
            legal = lateral <= max(0.0, 0.5 * door.width - 0.05)
            candidates.append((lateral, door, crossing,
                               legal, "enter" if current_side > previous_side else "exit"))
        if not candidates:
            return
        legal_candidates = [item for item in candidates if item[3]]
        _, door, crossing, legal, direction = min(
            legal_candidates or candidates, key=lambda item: item[0])
        item = {
            "t": round(self.elapsed(), 3), "door_id": door.door_id,
            "point": crossing, "legal": legal, "direction": direction,
            "source": "actual_trajectory",
        }
        self.door_traversal_history.append(item)

    @staticmethod
    def _decode_depth(message: Image) -> Optional[np.ndarray]:
        try:
            if message.encoding in ("32FC1", "32FC"):
                return np.frombuffer(message.data, dtype=np.float32).reshape(
                    message.height, message.step // 4)[:, :message.width].copy()
            if message.encoding in ("16UC1", "mono16"):
                raw = np.frombuffer(message.data, dtype=np.uint16).reshape(
                    message.height, message.step // 2)[:, :message.width]
                return raw.astype(np.float32) * 0.001
        except (ValueError, TypeError):
            return None
        return None

    def _on_depth(self, message: Image) -> None:
        depth = self._decode_depth(message)
        if depth is None:
            return
        observation = depth_geometry_observation(depth)
        now = message.header.stamp.to_sec() if message.header.stamp else rospy.Time.now().to_sec()
        with self.lock:
            pose = dict(self.pose) if self.pose else None
            corridor_confidence = (self.current_corridor.confidence
                                   if self.current_corridor else 0.0)
            visible_doors = []
            projected_depth = []
            projected_rooms = []
            if pose is not None:
                for door in self.topology.doors:
                    bearing = math.atan2(door.center[1] - pose["y"],
                                         door.center[0] - pose["x"])
                    bearing_offset = wrap_angle(bearing - pose["yaw"])
                    range_m = distance(door.center, (pose["x"], pose["y"]))
                    if range_m <= 8.0 and abs(bearing_offset) <= math.radians(28.0):
                        visible_doors.append(door)
                        center_fraction = 0.5 + bearing_offset / math.radians(60.0)
                        angular_width = 2.0 * math.atan2(0.5 * door.width, max(range_m, 0.2))
                        roi_fraction = float(np.clip(
                            angular_width / math.radians(60.0) * 1.4, 0.12, 0.38))
                        door_depth = depth_geometry_observation(
                            depth, center_fraction=center_fraction,
                            roi_fraction=roi_fraction)
                        door_depth["door_id"] = door.door_id
                        door_depth["bearing_offset_rad"] = bearing_offset
                        door_depth["range_to_candidate_m"] = range_m
                        projected_depth.append(door_depth)
                        if door_depth.get("door_confidence_depth", 0.0) >= 0.65:
                            self.pending_depth_doors.add(door.door_id)
                for candidate in self.room_candidates.values():
                    target = candidate.portal_center or candidate.centroid
                    bearing = math.atan2(target[1] - pose["y"],
                                         target[0] - pose["x"])
                    bearing_offset = wrap_angle(bearing - pose["yaw"])
                    range_m = distance(target, (pose["x"], pose["y"]))
                    if range_m > 8.0 or abs(bearing_offset) > math.radians(28.0):
                        continue
                    center_fraction = 0.5 + bearing_offset / math.radians(60.0)
                    angular_width = 2.0 * math.atan2(
                        0.5 * max(candidate.portal_width, 1.0), max(range_m, 0.2))
                    roi_fraction = float(np.clip(
                        angular_width / math.radians(60.0) * 1.5, 0.14, 0.42))
                    room_depth = depth_geometry_observation(
                        depth, center_fraction=center_fraction,
                        roi_fraction=roi_fraction)
                    visible_depth = float(room_depth.get("visible_free_depth") or 0.0)
                    range_support = min(1.0, visible_depth / max(range_m, 0.5))
                    opening_support = float(room_depth.get(
                        "door_confidence_depth", 0.0))
                    depth_confidence = min(
                        1.0, 0.55 * opening_support + 0.45 * range_support)
                    candidate.depth_confidence = max(
                        candidate.depth_confidence, depth_confidence)
                    if depth_confidence >= 0.58:
                        candidate.depth_confirmations += 1
                    self._fuse_room_candidate(candidate)
                    room_depth.update({
                        "room_candidate_id": candidate.candidate_id,
                        "bearing_offset_rad": bearing_offset,
                        "range_to_candidate_m": range_m,
                        "room_confidence_depth": depth_confidence,
                        "fused_room_confidence": candidate.fused_confidence,
                    })
                    projected_rooms.append(room_depth)
            if projected_depth:
                observation = max(projected_depth,
                                  key=lambda item: item.get("door_confidence_depth", 0.0))
            payload = {
                "timestamp": now,
                "corridor_confidence_geometry": corridor_confidence,
                "door_confidence_geometry": max(
                    (door.confidence for door in visible_doors), default=0.0),
                "room_expansion_confidence": max(
                    [room.expansion_confidence for room in self.rooms.values()]
                    + [candidate.fused_confidence
                       for candidate in self.room_candidates.values()], default=0.0),
                "visible_door_ids": [door.door_id for door in visible_doors],
                "door_depth_observations": projected_depth,
                "room_depth_observations": projected_rooms,
                "confirmed_room_candidate_ids": [
                    candidate.candidate_id
                    for candidate in self.room_candidates.values()
                    if candidate.confirmed],
                "use_depth_door_confirmation": self.use_depth,
                "use_rgb_semantic_confirmation": self.use_rgb,
                **observation,
            }
            self.latest_depth = payload
            self.semantic_history.append(payload)
            self.last_depth_stamp = time.monotonic()

    def _on_execution_result(self, message: String) -> None:
        try:
            payload = json.loads(message.data)
        except (ValueError, TypeError):
            return
        with self.lock:
            self.result_sequence += 1
            payload["sequence"] = self.result_sequence
            self.execution_results.append(payload)
            if len(self.execution_results) > 1000:
                self.execution_results = self.execution_results[-1000:]

    @staticmethod
    def _goal_result_matches(candidate: dict, expected_sequence: int,
                             expected_stamp: float, point: Point,
                             require_identity: bool = True) -> bool:
        """Correlate an asynchronous executor result to exactly one command."""
        try:
            returned_goal = candidate.get("goal") or {}
            coordinates_match = (
                abs(float(returned_goal.get("x", math.inf)) - point[0]) <= 0.05 and
                abs(float(returned_goal.get("y", math.inf)) - point[1]) <= 0.05)
            # rospy overwrites Header.seq when publishing.  A unique
            # manager-generated wall-clock stamp plus the already-required
            # target coordinates is therefore the transport-stable identity;
            # goal_sequence remains useful only as audit metadata.
            has_identity = "goal_stamp" in candidate
            identity_match = (
                has_identity and
                abs(float(candidate.get("goal_stamp")) -
                    float(expected_stamp)) <= 1e-6)
        except (TypeError, ValueError, OverflowError):
            return False
        if not coordinates_match:
            return False
        if require_identity:
            return identity_match
        return identity_match or not has_identity

    def _cancel_goal_and_wait(self, expected_sequence: int,
                              expected_stamp: float, point: Point,
                              reason: str, result_baseline: int) -> dict:
        """Stop one exact executor goal and require a bounded result ack."""
        payload = {
            "goal_sequence": int(expected_sequence),
            "goal_stamp": float(expected_stamp),
            "goal_x": float(point[0]),
            "goal_y": float(point[1]),
            "reason": str(reason),
        }
        deadline = time.monotonic() + max(0.1, self.cancel_ack_timeout)
        next_publish = 0.0
        acknowledgement = None
        while not rospy.is_shutdown() and time.monotonic() < deadline:
            now = time.monotonic()
            if now >= next_publish:
                self.cancel_goal_pub.publish(
                    String(data=json.dumps(payload, sort_keys=True)))
                next_publish = now + 0.25
            with self.lock:
                candidates = [dict(item) for item in self.execution_results
                              if int(item.get("sequence", 0)) > result_baseline]
            acknowledgement = next((item for item in candidates
                                    if self._goal_result_matches(
                                        item, expected_sequence, expected_stamp,
                                        point, True)), None)
            if acknowledgement is not None:
                break
            time.sleep(0.02)
        result = {
            "requested": True,
            "acknowledged": acknowledgement is not None,
            "goal_sequence": int(expected_sequence),
            "goal_stamp": float(expected_stamp),
            "reason": str(reason),
        }
        if acknowledgement is not None:
            result["executor_result"] = acknowledgement
        self._event("goal_cancel_ack" if result["acknowledged"] else
                    "goal_cancel_unacknowledged", **result)
        return result

    def _on_voxel_map_saved(self, message: Bool) -> None:
        if not message.data:
            return
        with self.lock:
            self.voxel_saved_sequence += 1

    def _request_final_voxel_snapshot(self, timeout: float = 15.0) -> bool:
        """Request an atomic .bt/statistics snapshot before final safety audit."""
        with self.lock:
            baseline = self.voxel_saved_sequence
            baseline_grid_stamp = self.grid_stamp
        requested_at = time.monotonic()
        self.final_voxel_snapshot = {
            "requested": True, "acknowledged": False,
            "request_t": round(self.elapsed(), 3), "timeout_seconds": timeout,
        }
        self.finalize_voxel_pub.publish(Bool(data=True))
        deadline = requested_at + max(0.1, timeout)
        while not rospy.is_shutdown() and time.monotonic() < deadline:
            with self.lock:
                acknowledged = self.voxel_saved_sequence > baseline
                projection_refreshed = self.grid_stamp > baseline_grid_stamp
            if acknowledged and projection_refreshed:
                map_exists = os.path.isfile(self.map_file)
                statistics_exists = os.path.isfile(self.statistics_file)
                self.final_voxel_snapshot.update({
                    "acknowledged": True,
                    "projection_refreshed": True,
                    "ack_latency_seconds": round(time.monotonic() - requested_at, 3),
                    "map_file_exists": map_exists,
                    "statistics_file_exists": statistics_exists,
                    "complete": map_exists and statistics_exists,
                })
                return map_exists and statistics_exists
            time.sleep(0.05)
        self.final_voxel_snapshot.update({
            "reason": "voxel_snapshot_ack_timeout",
            "projection_refreshed": self.grid_stamp > baseline_grid_stamp,
            "complete": False,
            "map_file_exists": os.path.isfile(self.map_file),
            "statistics_file_exists": os.path.isfile(self.statistics_file),
        })
        return False

    def _wait_ready(self) -> bool:
        deadline = time.monotonic() + self.startup_timeout
        while not rospy.is_shutdown() and time.monotonic() < deadline:
            with self.lock:
                ready = (self.grid is not None and self.pose is not None and
                         time.monotonic() - self.grid_stamp < 2.0 and
                         time.monotonic() - self.pose_stamp < 0.6 and
                         (not self.use_depth or
                          time.monotonic() - self.last_depth_stamp < 2.0))
                frames_match = self.grid_frame == self.pose_frame
            if ready and frames_match and os.path.isfile(self.map_file):
                return True
            if ready and not frames_match:
                rospy.logwarn_throttle(5.0, "Grid/odom frame mismatch: %s != %s",
                                       self.grid_frame, self.pose_frame)
            time.sleep(0.25)
        return False

    def _room_candidate_matches(
        self,
        tracked: RoomExpansionObservation,
        observed: RoomExpansionObservation,
    ) -> bool:
        if tracked.corridor_id != observed.corridor_id or tracked.side != observed.side:
            return False
        # A wall-side free-space component can extend over much of a long
        # room.  Interval overlap alone consequently merged separate rooms on
        # the same corridor side and allowed a later portal to overwrite the
        # earlier door station.  Once both observations have a portal, that
        # local aperture is the strongest association key.
        if tracked.portal_center is not None and observed.portal_center is not None:
            portal_tolerance = max(0.60, min(
                0.90,
                0.25 * (tracked.portal_width + observed.portal_width) + 0.30))
            return distance(tracked.portal_center,
                            observed.portal_center) <= portal_tolerance
        if distance(tracked.centroid, observed.centroid) > 3.0:
            return False
        overlap = min(tracked.longitudinal_max, observed.longitudinal_max) - max(
            tracked.longitudinal_min, observed.longitudinal_min)
        gap = max(0.0, max(tracked.longitudinal_min, observed.longitudinal_min)
                  - min(tracked.longitudinal_max, observed.longitudinal_max))
        return overlap >= -0.20 or gap <= 0.75

    @staticmethod
    def _fuse_room_candidate(candidate: RoomExpansionObservation) -> None:
        temporal = min(1.0, candidate.observations / 3.0)
        depth = min(1.0, candidate.depth_confirmations / 3.0)
        candidate.fused_confidence = min(
            1.0,
            0.58 * candidate.geometry_confidence
            + 0.14 * candidate.portal_confidence
            + 0.14 * temporal
            + 0.14 * max(candidate.depth_confidence, depth),
        )
        # Depth is positive corroboration when the candidate is visible, not a
        # mandatory gate: a side-facing room can remain outside the camera FOV
        # while LiDAR/OctoMap supplies strong repeated geometric evidence.
        candidate.confirmed = (
            candidate.observations >= 2
            and (candidate.geometry_confidence >= 0.68 or
                 (candidate.geometry_confidence >= 0.60
                  and candidate.depth_confirmations >= 2))
            and (candidate.depth_confirmations >= 2 or candidate.observations >= 3)
            and candidate.fused_confidence >= 0.68
        )

    def _update_room_candidates(
        self, observations: Sequence[RoomExpansionObservation],
        grid_sequence: Optional[int] = None,
        observer_position: Optional[Point] = None,
    ) -> List[RoomExpansionObservation]:
        updated = []
        matched_this_grid = set()
        for observed in observations:
            compatible = [
                candidate for candidate in self.room_candidates.values()
                if self._room_candidate_matches(candidate, observed)]
            match = next((candidate for candidate in compatible
                          if candidate.candidate_id not in matched_this_grid), None)
            # Connected-component fragmentation can produce two observations
            # for the same physical room in one projection.  Fuse at most one
            # of them temporally; do not create a duplicate track or increment
            # confirmation twice from the same map sequence.
            if match is None and compatible:
                continue
            if match is None:
                self.room_candidate_sequence += 1
                observed.candidate_id = "room_candidate_{:02d}".format(
                    self.room_candidate_sequence)
                if grid_sequence is not None:
                    observed.last_observed_grid_sequence = int(grid_sequence)
                observed.last_observer_position = observer_position
                match = observed
                self.room_candidates[match.candidate_id] = match
            else:
                if (grid_sequence is not None and
                        match.last_observed_grid_sequence == int(grid_sequence)):
                    continue
                weight = 1.0 / float(match.observations + 1)
                match.centroid = (
                    (1.0 - weight) * match.centroid[0] + weight * observed.centroid[0],
                    (1.0 - weight) * match.centroid[1] + weight * observed.centroid[1],
                )
                match.core_area = max(match.core_area, observed.core_area)
                match.longitudinal_min = min(
                    match.longitudinal_min, observed.longitudinal_min)
                match.longitudinal_max = max(
                    match.longitudinal_max, observed.longitudinal_max)
                match.lateral_expansion_depth = max(
                    match.lateral_expansion_depth, observed.lateral_expansion_depth)
                match.maximum_clearance = max(
                    match.maximum_clearance, observed.maximum_clearance)
                match.expansion_ratio = max(match.expansion_ratio,
                                            observed.expansion_ratio)
                match.geometry_confidence = max(
                    match.geometry_confidence, observed.geometry_confidence)
                if observed.portal_confidence >= match.portal_confidence:
                    match.portal_center = observed.portal_center
                    match.portal_width = observed.portal_width
                    match.portal_normal_direction = observed.portal_normal_direction
                    match.portal_confidence = observed.portal_confidence
                match.observations += 1
                if grid_sequence is not None:
                    match.last_observed_grid_sequence = int(grid_sequence)
                match.last_observer_position = observer_position
            self._fuse_room_candidate(match)
            updated.append(match)
            matched_this_grid.add(match.candidate_id)
        return updated

    def _promote_room_candidates_to_doors(
        self, grid: OccupancyMap, grid_sequence: int,
        candidate_id: Optional[str] = None,
    ) -> List[Doorway]:
        """Validate confirmed room portals and expose only safe door channels."""
        promoted = []
        for candidate in self.room_candidates.values():
            if candidate_id is not None and candidate.candidate_id != candidate_id:
                continue
            if candidate.door_id:
                tracked = self._door(candidate.door_id)
                owned_by_candidate = bool(
                    tracked is not None and
                    tracked.source_room_candidate_id in
                    (None, candidate.candidate_id))
                if (owned_by_candidate and tracked.confirmed and
                        tracked.traversable):
                    promoted.append(tracked)
                    continue
                # Never let two room candidates retain the same promoted door.
                # Re-evaluate this candidate against its own local evidence.
                if tracked is not None and not owned_by_candidate:
                    candidate.door_id = None
            previous = candidate.channel_validation or {}
            last_sequence = int(previous.get("grid_sequence", -1000000))
            # A rejected channel may become observable as mapping advances, but
            # invoking the external 3-D validator on every projection update is
            # unnecessary.  Retry after three distinct maps.
            if grid_sequence - last_sequence < 3:
                continue
            if not candidate.confirmed:
                continue
            raw_portal_center = candidate.portal_center
            corridor = self._corridor(candidate.corridor_id)
            support = (select_independent_door_support(
                candidate, corridor, self.topology.doors, self.p)
                       if corridor is not None else None)
            attended_candidate_fallback = bool(
                support is None and corridor is not None and
                attended_room_candidate_channel_eligible(
                    candidate,
                    candidate.candidate_id in self.door_attention_attempted))
            reached_attention_views = len(
                self.door_attention_reached_views.get(
                    candidate.candidate_id, set()))
            multiview_traversability_fallback = bool(
                attended_candidate_fallback and reached_attention_views >= 1)
            if support is None and not attended_candidate_fallback:
                candidate.channel_validation = {
                    "grid_sequence": int(grid_sequence),
                    "safe": False,
                    "reason": "independent_framed_door_support_missing",
                    "raw_portal_center": raw_portal_center,
                }
                self._event(
                    "room_candidate_channel_rejected",
                    candidate_id=candidate.candidate_id,
                    two_dimensional_reason=
                    "independent_framed_door_support_missing",
                    voxel_reason=None, safe=False)
                continue
            if support is not None:
                candidate.portal_center = support.center
                candidate.portal_width = support.width
                candidate.portal_normal_direction = support.normal_direction
                candidate.portal_confidence = max(
                    candidate.portal_confidence, support.confidence)
            door = doorway_from_room_candidate(candidate, self.p)
            if door is None:
                continue
            measured_support_center = (
                support.center if support is not None else
                tuple(candidate.portal_center))
            door = align_candidate_door_to_corridor(
                door, candidate, corridor, self.p,
                preserve_measured_center=True)
            corridor_aligned_center = door.center
            door, two_d, fit = self._fit_executable_room_channel(
                grid, door, candidate,
                require_frame_evidence=bool(
                    attended_candidate_fallback and
                    not multiview_traversability_fallback),
                allow_unframed_adjustment=
                multiview_traversability_fallback)
            channel = [door.corridor_side, door.center, door.interior_side]
            voxel = ({"safe": False, "reason": "two_dimensional_channel_invalid",
                      "skipped": True}
                     if not two_d.valid else
                     self._voxel_validate_path(
                         channel, "room_candidate_channel_" + candidate.candidate_id,
                         required_clearance=0.27))
            safe = bool(two_d.valid and voxel.get("safe"))
            candidate.channel_validation = {
                "grid_sequence": int(grid_sequence),
                "channel": channel,
                "raw_portal_center": raw_portal_center,
                "independent_support_center": measured_support_center,
                "corridor_aligned_center": corridor_aligned_center,
                "alignment_center_shift_m": distance(
                    measured_support_center, corridor_aligned_center),
                "preserved_independent_support_center": True,
                "channel_fit": fit,
                "support_source": (
                    "independent_raw_door" if support is not None else
                    "multiview_traversable_room_portal"
                    if multiview_traversability_fallback else
                    "attended_multisensor_room_candidate"),
                "entry_policy": (
                    "low_speed_probe" if multiview_traversability_fallback else
                    "standard_door_traversal"),
                "reached_attention_views": reached_attention_views,
                "independent_door_support_id": (
                    support.door_id if support is not None else None),
                "independent_door_support_observations": (
                    support.observations if support is not None else 0),
                "attended_candidate_fallback": attended_candidate_fallback,
                "multiview_traversability_fallback":
                multiview_traversability_fallback,
                "required_clearance_m": 0.27,
                "two_dimensional": two_d.to_dict(),
                "voxel": voxel,
                "safe": safe,
            }
            self._event(
                "room_candidate_channel_validated" if safe else
                "room_candidate_channel_rejected",
                candidate_id=candidate.candidate_id,
                two_dimensional_reason=two_d.reason,
                voxel_reason=voxel.get("reason"), safe=safe,
                entry_policy=candidate.channel_validation["entry_policy"],
                reached_attention_views=reached_attention_views)
            if not safe:
                continue
            duplicate_owner = next((existing for existing in self.topology.doors
                                    if existing.source_room_candidate_id not in
                                    (None, candidate.candidate_id)
                                    and distance(existing.center, door.center) <= 0.75
                                    and angle_distance(
                                        existing.normal_direction,
                                        door.normal_direction) <=
                                    math.radians(30.0)), None)
            if duplicate_owner is not None:
                candidate.channel_validation.update({
                    "safe": False,
                    "reason": "duplicate_portal_owned_by_room_candidate",
                    "duplicate_door_id": duplicate_owner.door_id,
                    "duplicate_owner_candidate_id":
                    duplicate_owner.source_room_candidate_id,
                })
                self._event(
                    "room_candidate_channel_rejected",
                    candidate_id=candidate.candidate_id,
                    two_dimensional_reason=
                    "duplicate_portal_owned_by_room_candidate",
                    duplicate_door_id=duplicate_owner.door_id,
                    safe=False)
                continue
            # When an independent raw gap supplied the portal, preserve that
            # track's identity.  Re-running spatial association after fitting
            # used to merge it into a nearby already-owned door and silently
            # transfer ownership between room candidates.
            tracked = (support if support is not None else
                       self.topology.update_doors([door])[0])
            self._apply_door_geometry(tracked, door)
            tracked.confirmed = True
            tracked.traversable = True
            tracked.corridor_id = candidate.corridor_id
            tracked.adjacent_region_id = "room_" + candidate.candidate_id
            tracked.source_room_candidate_id = candidate.candidate_id
            tracked.last_validated_grid_sequence = int(grid_sequence)
            tracked.channel_validation = dict(candidate.channel_validation)
            tracked.estimated_unknown_size = max(
                tracked.estimated_unknown_size, candidate.core_area)
            candidate.door_id = tracked.door_id
            if tracked.door_id not in self.room_queue and not tracked.visited:
                self.room_queue.append(tracked.door_id)
            promoted.append(tracked)
            self._event("room_candidate_promoted_to_door",
                        candidate_id=candidate.candidate_id,
                        door_id=tracked.door_id,
                        room_id=tracked.adjacent_region_id,
                        channel=channel,
                        entry_policy=tracked.channel_validation.get(
                            "entry_policy"))
        return promoted

    def _fit_executable_room_channel(
        self, grid: OccupancyMap, seed: Doorway,
        candidate: RoomExpansionObservation,
        require_frame_evidence: bool = False,
        allow_unframed_adjustment: bool = False,
    ) -> Tuple[Doorway, object, dict]:
        """Snap noisy wall-gap geometry to an observed free, framed channel."""
        seed_channel = [seed.corridor_side, seed.center, seed.interior_side]
        seed_validity = validate_path(
            grid, seed_channel, [seed], required_door_id=seed.door_id,
            spacing=self.p.path_sample_spacing, check_footprint=True)
        frame_radius = max(0.22, 1.25 * grid.resolution)
        seed_framed = bool(
            grid.has_occupied_near(seed.left_frame_point, frame_radius) and
            grid.has_occupied_near(seed.right_frame_point, frame_radius))
        if seed_validity.valid and (
                seed_framed or not require_frame_evidence):
            return seed, seed_validity, {
                "adjusted": False, "tangent_offset_m": 0.0,
                "normal_offset_m": 0.0,
                "frame_evidence": seed_framed,
            }

        nx, ny = seed.normal
        tx, ty = seed.tangent
        step = max(grid.resolution, 0.15)
        tangent_limit = max(
            step, self.door_channel_max_tangent_adjustment)
        normal_limit = max(
            step, self.door_channel_max_normal_adjustment)
        tangent_offsets = np.arange(-tangent_limit, tangent_limit + 0.5 * step, step)
        normal_offsets = np.arange(-normal_limit, normal_limit + 0.5 * step, step)
        offsets = sorted(
            ((float(t), float(n)) for t in tangent_offsets for n in normal_offsets),
            key=lambda item: (abs(item[0]) + 1.5 * abs(item[1]), abs(item[0])))
        checked = 0
        framed = 0
        for tangent_offset, normal_offset in offsets:
            if abs(tangent_offset) < 1e-9 and abs(normal_offset) < 1e-9:
                continue
            dx = tangent_offset * tx + normal_offset * nx
            dy = tangent_offset * ty + normal_offset * ny
            center = (seed.center[0] + dx, seed.center[1] + dy)
            # The expansion centroid must remain on the proposed room side;
            # this prevents snapping to an unrelated opposite-facing gap.
            if dot((candidate.centroid[0] - center[0],
                    candidate.centroid[1] - center[1]), (nx, ny)) <= 0.5:
                continue
            shifted = Doorway(
                **{**seed.to_dict(),
                   "center": center,
                   "left_frame_point": (seed.left_frame_point[0] + dx,
                                        seed.left_frame_point[1] + dy),
                   "right_frame_point": (seed.right_frame_point[0] + dx,
                                         seed.right_frame_point[1] + dy),
                   "corridor_side": (center[0] - self.p.door_outside_distance * nx,
                                     center[1] - self.p.door_outside_distance * ny),
                   "interior_side": (center[0] + self.p.door_inside_distance * nx,
                                     center[1] + self.p.door_inside_distance * ny)})
            # A free strip in a hall is not a doorway.  Both ends of the
            # measured aperture must have occupied wall/frame support.
            shifted_framed = bool(
                grid.has_occupied_near(shifted.left_frame_point, frame_radius) and
                grid.has_occupied_near(shifted.right_frame_point, frame_radius))
            if not shifted_framed and not allow_unframed_adjustment:
                continue
            framed += int(shifted_framed)
            channel = [shifted.corridor_side, shifted.center, shifted.interior_side]
            checked += 1
            validity = validate_path(
                grid, channel, [shifted], required_door_id=shifted.door_id,
                spacing=self.p.path_sample_spacing, check_footprint=True)
            if validity.valid:
                return shifted, validity, {
                    "adjusted": True,
                    "tangent_offset_m": tangent_offset,
                    "normal_offset_m": normal_offset,
                    "frame_evidence": shifted_framed,
                    "unframed_traversability_adjustment":
                    not shifted_framed,
                    "framed_hypotheses": framed,
                    "validated_hypotheses": checked,
                }
        return seed, seed_validity, {
            "adjusted": False,
            "reason": ("no_safe_traversable_channel_found"
                       if allow_unframed_adjustment else
                       "no_framed_free_channel_found"),
            "framed_hypotheses": framed, "validated_hypotheses": checked,
        }

    def _apply_door_geometry(self, target: Doorway, source: Doorway) -> None:
        """Copy one validated door plane without replacing tracker state."""
        if (self.enable_door_commit and self.door_locked and
                self.door_commit is not None and
                target.door_id == self.door_commit["door_id"]):
            difference = distance(source.center, self.door_commit["center"])
            self._record_door_commit(
                "redetection_ignored", detected_center=source.center,
                difference_distance=difference, ignored=True)
            self._restore_committed_door(target)
            return
        for attribute in (
                "center", "normal_direction", "width", "left_frame_point",
                "right_frame_point", "corridor_side", "interior_side"):
            setattr(target, attribute, getattr(source, attribute))

    def _record_locked_door_redetections(
            self, observations: Sequence[Doorway], source: str) -> None:
        """Audit live detections that cannot move the committed door plane."""
        if not self.door_locked or self.door_commit is None:
            return
        commit = self.door_commit
        for observed in observations:
            center_difference = distance(observed.center, commit["center"])
            normal_difference = abs(wrap_angle(
                observed.normal_direction - commit["normal_direction"]))
            if (center_difference > 1.50 or
                    normal_difference > math.radians(30.0)):
                continue
            self._record_door_commit(
                "redetection_ignored", detected_center=observed.center,
                difference_distance=center_difference, ignored=True)
            self.door_commit_history[-1].update({
                "detected_normal": list(observed.normal),
                "normal_difference_rad": float(normal_difference),
                "detection_source": source,
            })

    def _candidate_for_door(
        self, door: Doorway
    ) -> Optional[RoomExpansionObservation]:
        candidate_id = door.source_room_candidate_id
        if candidate_id:
            return self.room_candidates.get(candidate_id)
        return next((candidate for candidate in self.room_candidates.values()
                     if candidate.door_id == door.door_id), None)

    def _activate_entered_room(self, door: Doorway, reason: str) -> None:
        """Lock the measured entrance and hand control to room exploration."""
        if self.door_candidate_takeover is not None:
            takeover = self.door_candidate_takeover
            takeover["status"] = "entered"
            takeover["door_id"] = door.door_id
            takeover["finished_t"] = round(self.elapsed(), 3)
            self.door_candidate_takeover_history.append(dict(takeover))
            self._event(
                "door_candidate_entry_takeover_succeeded",
                candidate_id=takeover["candidate_id"],
                door_id=door.door_id,
                duration=round(
                    self.elapsed() - float(takeover["started_t"]), 3))
            self.door_candidate_takeover = None
        door.geometry_locked = True
        self._event("room_entry_door_geometry_locked", door_id=door.door_id,
                    center=door.center, normal_direction=door.normal_direction,
                    corridor_side=door.corridor_side,
                    interior_side=door.interior_side,
                    validated_grid_sequence=door.last_validated_grid_sequence,
                    entry_reason=reason)
        self._register_opposite_door_attention(door)
        room_id = door.adjacent_region_id or "room_" + door.door_id
        door.adjacent_region_id = room_id
        room = self.rooms.setdefault(room_id, RoomRegion(room_id, door.door_id))
        self.current_door_id = door.door_id
        self.current_room_id = room_id
        self.pending_room_macro = None
        self.room_macro_failed_targets.setdefault(room_id, [])
        self.room_macro_attempts.setdefault(room_id, 0)
        self.room_exit_failures = 0
        self.return_corridor_failures = 0
        room.state = RoomState.ENTERING
        room.no_goal_cycles = 0
        room.no_goal_map_sequences = []
        self._refresh_room_geometry(
            room, door, (self.pose["x"], self.pose["y"]))
        if (door.signed_depth((self.pose["x"], self.pose["y"])) >=
                self.p.inside_depth_min and room.expansion_confidence > 0.0):
            room.state = RoomState.EXPLORING
            self._transition(MissionPhase.EXPLORE_ROOM_LOCAL, reason)
            return
        room.unreachable_attempt_count += 1
        room.unreachable_confirmed = room.unreachable_attempt_count >= 3
        room.unreachable_reason = "room_geometry_not_confirmed_after_door_crossing"
        door.blacklist_until = self.elapsed() + min(
            120.0, 20.0 * room.unreachable_attempt_count)
        room.state = RoomState.TEMPORARILY_UNREACHABLE
        self._transition(MissionPhase.EXIT_ROOM, "room_confirmation_failed")

    def _adopt_embodied_room_candidate_entry(self) -> bool:
        """Recover state after motion has already crossed a candidate portal."""
        if self.current_room_id or len(self.trajectory) < 2:
            return False
        cutoff = self.elapsed() - 25.0
        recent = [(item["x"], item["y"]) for item in self.trajectory
                  if item.get("t", -math.inf) >= cutoff]
        matches = []
        for candidate in self.room_candidates.values():
            evidence = room_candidate_entry_evidence(candidate, recent, self.p)
            if evidence.get("confirmed"):
                matches.append((float(evidence.get("lateral_offset", math.inf)),
                                candidate, evidence))
        if not matches:
            return False
        _, candidate, evidence = min(matches, key=lambda item: item[0])
        seed = doorway_from_room_candidate(candidate, self.p)
        if seed is None:
            return False
        # Actual traversal is stronger evidence of free body clearance than a
        # noisy projection after the robot has already passed the wall plane.
        seed.confirmed = True
        seed.traversable = True
        seed.geometry_locked = True
        seed.channel_validation = {
            "safe": True,
            "stage": "embodied_candidate_crossing",
            "grid_sequence": int(self.grid_sequence),
            "evidence": evidence,
        }
        tracked = self.topology.update_doors(
            [seed], grid_sequence=self.grid_sequence,
            observer_position=(self.pose["x"], self.pose["y"]))[0]
        self._apply_door_geometry(tracked, seed)
        tracked.confirmed = True
        tracked.traversable = True
        tracked.geometry_locked = True
        tracked.corridor_id = candidate.corridor_id
        tracked.adjacent_region_id = "room_" + candidate.candidate_id
        tracked.source_room_candidate_id = candidate.candidate_id
        tracked.last_validated_grid_sequence = int(self.grid_sequence)
        tracked.channel_validation = dict(seed.channel_validation)
        tracked.estimated_unknown_size = max(
            tracked.estimated_unknown_size, candidate.core_area)
        candidate.door_id = tracked.door_id
        candidate.channel_validation = dict(seed.channel_validation)
        self.door_traversal_history.append({
            "t": round(self.elapsed(), 3), "door_id": tracked.door_id,
            "point": evidence["crossing"], "legal": True,
            "direction": "enter", "source": "embodied_room_candidate",
        })
        source_corridor = self._corridor(candidate.corridor_id)
        if source_corridor is not None:
            self.current_corridor = source_corridor
        self._event("embodied_room_candidate_entry_adopted",
                    candidate_id=candidate.candidate_id,
                    door_id=tracked.door_id, evidence=evidence)
        self._activate_entered_room(
            tracked, "embodied_candidate_crossing_confirmed")
        return True

    def _door_channel_retry_pending(self, door: Doorway, stage: str,
                                    refresh: dict) -> bool:
        """Treat a few latest-map channel failures as transient evidence."""
        key = "{}:{}".format(door.door_id, stage)
        cycles = self.door_channel_failure_cycles.get(key, 0) + 1
        self.door_channel_failure_cycles[key] = cycles
        if cycles > max(0, self.door_channel_transient_retry_cycles):
            self.door_channel_failure_cycles.pop(key, None)
            return False
        self._event(
            "door_channel_transient_retry", door_id=door.door_id,
            stage=stage, retry_cycle=cycles,
            maximum_retry_cycles=self.door_channel_transient_retry_cycles,
            two_dimensional_reason=refresh.get("two_dimensional_reason"),
            voxel_reason=refresh.get("voxel_reason"))
        time.sleep(0.75)
        return True

    def _refresh_candidate_door_channel(self, door: Doorway, stage: str) -> dict:
        """Refit and revalidate a candidate door against the newest live map."""
        if door.geometry_locked:
            return {"safe": True, "locked": True, "geometry_changed": False,
                    "grid_sequence": door.last_validated_grid_sequence}
        candidate = self._candidate_for_door(door)
        if candidate is None:
            return {"safe": bool(door.confirmed and door.traversable),
                    "reason": "not_a_room_candidate_door",
                    "geometry_changed": False}
        with self.lock:
            grid = self.grid
            grid_sequence = self.grid_sequence
        if grid is None:
            return {"safe": False, "reason": "latest_grid_missing",
                    "geometry_changed": False}
        if (door.last_validated_grid_sequence == grid_sequence and
                door.channel_validation.get("safe")):
            return {"safe": True, "locked": False, "cached": True,
                    "geometry_changed": False,
                    "grid_sequence": grid_sequence}
        old_center = door.center
        previous_validation = dict(door.channel_validation)
        seed = Doorway(**door.to_dict())
        corridor = self._corridor(candidate.corridor_id)
        if corridor is not None:
            seed = align_candidate_door_to_corridor(
                seed, candidate, corridor, self.p,
                preserve_measured_center=True)
        fitted, two_d, fit = self._fit_executable_room_channel(
            grid, seed, candidate,
            allow_unframed_adjustment=bool(
                previous_validation.get("entry_policy") ==
                "low_speed_probe"))
        channel = [fitted.corridor_side, fitted.center, fitted.interior_side]
        voxel = ({"safe": False, "reason": "two_dimensional_channel_invalid",
                  "skipped": True}
                 if not two_d.valid else
                 self._voxel_validate_path(
                     channel, "{}_latest_{}".format(stage, door.door_id),
                     required_clearance=0.27))
        safe = bool(two_d.valid and voxel.get("safe"))
        validation = {
            "stage": stage,
            "grid_sequence": int(grid_sequence),
            "channel": channel,
            "channel_fit": fit,
            "required_clearance_m": 0.27,
            "two_dimensional": two_d.to_dict(),
            "voxel": voxel,
            "safe": safe,
            "support_source": previous_validation.get("support_source"),
            "entry_policy": previous_validation.get(
                "entry_policy", "standard_door_traversal"),
            "multiview_traversability_fallback": bool(
                previous_validation.get(
                    "multiview_traversability_fallback", False)),
            "reached_attention_views": previous_validation.get(
                "reached_attention_views", 0),
        }
        candidate.channel_validation = dict(validation)
        door.channel_validation = dict(validation)
        door.last_validated_grid_sequence = int(grid_sequence)
        geometry_changed = distance(old_center, fitted.center) > 0.10
        if safe:
            self._apply_door_geometry(door, fitted)
            door.traversable = True
        else:
            # Do not keep a stale authorization alive.  Topology updates may
            # refit and promote this same remembered candidate on a later map.
            door.traversable = False
        self._event(
            "door_channel_latest_map_validated" if safe else
            "door_channel_latest_map_rejected",
            door_id=door.door_id, candidate_id=candidate.candidate_id,
            stage=stage, grid_sequence=grid_sequence,
            geometry_changed=geometry_changed,
            old_center=old_center, fitted_center=fitted.center,
            two_dimensional_reason=two_d.reason,
            voxel_reason=voxel.get("reason"))
        return {"safe": safe, "locked": False,
                "geometry_changed": geometry_changed,
                "grid_sequence": grid_sequence,
                "two_dimensional": two_d.to_dict(),
                "voxel": voxel,
                "two_dimensional_reason": two_d.reason,
                "voxel_reason": voxel.get("reason")}

    def _room_reference_corridor(self, pose: dict) -> Optional[CorridorRegion]:
        """Select and odometry-stabilize a corridor frame for room geometry.

        Room detection must not disappear merely because the local wall
        detector misses one update.  The selected axis is still map-derived;
        odometry only scores alignment with the actually traversed motion and
        extends the longitudinal support to the current robot station.
        """
        choices = list(self.topology.corridors)
        if not choices:
            return None
        if len(self.trajectory) >= 20:
            points = np.asarray([[item["x"], item["y"]]
                                 for item in self.trajectory[-2000:]], dtype=float)
            centered = points - np.mean(points, axis=0)
            covariance = np.cov(centered.T)
            values, vectors = np.linalg.eigh(covariance)
            principal = vectors[:, int(np.argmax(values))]
            motion_angle = math.atan2(principal[1], principal[0])
            if float(np.max(values)) < 0.25:
                motion_angle = None
        else:
            motion_angle = None

        def score(corridor):
            length = distance(corridor.centerline[0], corridor.centerline[-1])
            alignment = (0.0 if motion_angle is None else
                         angle_distance(corridor.principal_direction, motion_angle))
            return (1.0 if corridor.confirmed else 0.0) + corridor.confidence + min(
                length / 10.0, 1.0) - 2.5 * alignment

        source = max(choices, key=score)
        axis = unit(source.principal_direction)
        origin = source.centerline[0]
        endpoints = list(source.centerline)
        projections = [dot((point[0] - origin[0], point[1] - origin[1]), axis)
                       for point in endpoints]
        robot_station = dot((pose["x"] - origin[0], pose["y"] - origin[1]), axis)
        # The robot's traversed station is authoritative free-space evidence.
        # A short look-ahead lets already observed side rooms form a complete
        # core without inventing occupancy or a doorway.
        maximum = max(max(projections), robot_station + 2.0 * source.estimated_width)
        minimum = min(min(projections), robot_station)
        return CorridorRegion(
            corridor_id=source.corridor_id,
            centerline=[(origin[0] + minimum * axis[0], origin[1] + minimum * axis[1]),
                        (origin[0] + maximum * axis[0], origin[1] + maximum * axis[1])],
            principal_direction=source.principal_direction,
            estimated_width=source.estimated_width,
            forward_extent=source.forward_extent,
            left_wall=list(source.left_wall), right_wall=list(source.right_wall),
            confidence=source.confidence, confirmed=source.confirmed,
            observations=source.observations,
        )

    def _update_topology(self, allow_promotion: bool = True,
                         update_source: str = "planning") -> None:
        with self.lock:
            # The voxel projection can change both origin and array extent as
            # the mapped world grows.  Topology extraction performs several
            # NumPy/OpenCV passes and must see one immutable shape throughout
            # the cycle; retaining the callback-owned object allowed a newer
            # 236-column projection to be combined with a 238-column mask.
            grid = (None if self.grid is None else OccupancyMap(
                np.array(self.grid.data, dtype=np.int16, copy=True),
                self.grid.resolution, self.grid.origin_x, self.grid.origin_y))
            pose = dict(self.pose) if self.pose else None
            grid_sequence = self.grid_sequence
            # Temporal confirmation means distinct Voxel projection updates,
            # not repeated manager iterations over one immutable grid.
            if grid_sequence == self.last_topology_grid_sequence:
                return
            self.last_topology_grid_sequence = grid_sequence
            depth_ids = set(self.pending_depth_doors)
            self.pending_depth_doors.clear()
        if grid is None or pose is None:
            return
        topology_phases = {
            MissionPhase.EXPLORE_GENERIC, MissionPhase.EXPLORE_CORRIDOR_AWARE,
            MissionPhase.RECOVERY,
            MissionPhase.CORRIDOR_INITIALIZE, MissionPhase.CORRIDOR_DISCOVERY,
            MissionPhase.CORRIDOR_END_CONFIRM, MissionPhase.BUILD_ROOM_QUEUE,
            MissionPhase.APPROACH_DOOR, MissionPhase.RETURN_TO_CORRIDOR,
            MissionPhase.SELECT_NEXT_ROOM, MissionPhase.GLOBAL_RECOVERY,
        }
        corridor = None
        tracked_corridors = []
        room_expansion_observations = []
        discover_branches = False
        if self.phase in topology_phases:
            discover_branches = (
                self.current_corridor is None or
                self.phase in (MissionPhase.EXPLORE_GENERIC, MissionPhase.RECOVERY,
                               MissionPhase.CORRIDOR_INITIALIZE,
                               MissionPhase.CORRIDOR_END_CONFIRM,
                               MissionPhase.GLOBAL_RECOVERY) or
                self.current_corridor.corridor_id in self.completed_corridors)
            if discover_branches:
                observations = self.corridor_detector.detect_candidates(
                    grid, (pose["x"], pose["y"]))
            else:
                observed = self.corridor_detector.detect(
                    grid, (pose["x"], pose["y"]),
                    self.current_corridor.principal_direction)
                observations = [observed] if observed is not None else []
            for observed in observations:
                tracked = self.topology.update_corridor(observed)
                if tracked is None:
                    continue
                tracked_corridors.append(tracked)
            for tracked in tracked_corridors:
                door_observations = self.door_detector.detect(grid, tracked)
                door_observations = [
                    item for item in door_observations
                    if distance(item.center, (pose["x"], pose["y"])) <=
                    self.p.door_observation_max_distance]
                room_door_observations = []
                for door_observation in door_observations:
                    door_observation.corridor_id = tracked.corridor_id
                    junction = corridor_junction_target(
                        door_observation, tracked.corridor_id,
                        self.topology.corridors)
                    if junction:
                        edge = tuple(sorted((tracked.corridor_id, junction)))
                        if edge not in self.corridor_edges:
                            self.corridor_edges.add(edge)
                            self._event("corridor_branch_registered",
                                        corridor_ids=edge)
                    else:
                        room_door_observations.append(door_observation)
                self._record_locked_door_redetections(
                    room_door_observations, update_source)
                updated_doors = self.topology.update_doors(
                    room_door_observations, depth_ids if self.use_depth else (),
                    grid_sequence=grid_sequence,
                    observer_position=(pose["x"], pose["y"]))
                for door in updated_doors:
                    door.corridor_id = tracked.corridor_id
            retained_doors = []
            candidate_door_ids = {
                item.door_id for item in self.room_candidates.values()
                if item.door_id
            }
            for door in self.topology.doors:
                if door.door_id in candidate_door_ids:
                    retained_doors.append(door)
                    continue
                junction = corridor_junction_target(
                    door, door.corridor_id, self.topology.corridors)
                if (junction and door.corridor_id and
                        door.door_id != self.current_door_id):
                    edge = tuple(sorted((door.corridor_id, junction)))
                    self.corridor_edges.add(edge)
                    continue
                retained_doors.append(door)
            self.topology.doors = retained_doors
            unfinished = [item for item in tracked_corridors
                          if item.corridor_id not in self.completed_corridors]
            confirmed_unfinished = [item for item in unfinished if item.confirmed]
            choices = confirmed_unfinished or unfinished
            if choices:
                corridor = max(choices, key=lambda item: (
                    item.confidence, item.forward_extent))
                self.current_corridor = corridor
            elif tracked_corridors:
                corridor = max(tracked_corridors,
                               key=lambda item: item.confidence)
                if self.current_corridor is None:
                    self.current_corridor = corridor
        # Age raw wall-gap hypotheses during room crossing/exploration too.
        # Otherwise a one-frame corridor false positive survives for the
        # whole room visit merely because corridor detection is paused there.
        candidate_door_ids = {
            item.door_id for item in self.room_candidates.values()
            if item.door_id
        }
        protected_door_ids = set(candidate_door_ids)
        if self.current_door_id:
            protected_door_ids.add(self.current_door_id)
        removed_stale_doors = self.topology.prune_stale_doors(
            grid_sequence, protected_door_ids)
        if removed_stale_doors:
            self._event("stale_unconfirmed_doors_removed",
                        door_ids=removed_stale_doors,
                        grid_sequence=grid_sequence)
        room_reference = self._room_reference_corridor(pose)
        if room_reference is not None:
            detected_expansions = self.room_expansion_detector.detect(
                grid, room_reference)
            detected_expansions = [
                item for item in detected_expansions
                if distance(
                    item.portal_center if item.portal_center is not None
                    else item.centroid,
                    (pose["x"], pose["y"])) <=
                self.p.door_observation_max_distance]
            for observation in detected_expansions:
                observation.first_observer_position = (pose["x"], pose["y"])
            room_expansion_observations.extend(detected_expansions)
        updated_room_candidates = self._update_room_candidates(
            room_expansion_observations, grid_sequence,
            (pose["x"], pose["y"]))
        promoted_room_doors = (self._promote_room_candidates_to_doors(
            grid, grid_sequence) if allow_promotion else [])
        self.corridor_history.append({
            "t": round(self.elapsed(), 3),
            "observation": None if corridor is None else corridor.to_dict(),
            "observations": [item.to_dict() for item in tracked_corridors],
            "branch_discovery": discover_branches,
            "update_source": update_source,
        })
        self.doorway_history.append({
            "t": round(self.elapsed(), 3),
            "doors": [door.to_dict() for door in self.topology.doors],
        })
        self.room_candidate_history.append({
            "t": round(self.elapsed(), 3),
            "observations": [item.to_dict() for item in updated_room_candidates],
            "tracked_candidates": [item.to_dict()
                                   for item in self.room_candidates.values()],
            "promoted_door_ids": [item.door_id for item in promoted_room_doors],
            "update_source": update_source,
            "sensor_inputs": {
                "lidar_octomap_projection": True,
                "odometry_corridor_pose": True,
                "depth_camera_recent": (
                    self.use_depth and time.monotonic() - self.last_depth_stamp < 2.0),
            },
        })
        if self.current_room_id and self.current_door_id:
            room = self.rooms[self.current_room_id]
            door = self._door(self.current_door_id)
            if door:
                self._refresh_room_geometry(room, door, (pose["x"], pose["y"]))
                self.room_history.append({"t": round(self.elapsed(), 3),
                                          "room": room.to_dict()})
        signature = (len(self.topology.corridors), len(self.topology.doors),
                     len(self.rooms))
        if signature != self.last_topology_signature:
            self.last_topology_signature = signature
            self.global_no_candidate_cycles = 0
            self._event("new_topology_candidate", signature=signature)

    def _door(self, door_id: Optional[str]) -> Optional[Doorway]:
        door = next((door for door in self.topology.doors
                     if door.door_id == door_id), None)
        return self._restore_committed_door(door)

    @staticmethod
    def _room_resolved(room: RoomRegion) -> bool:
        """Only completed rooms or explicitly proven unreachable rooms resolve."""
        return (room.state == RoomState.COMPLETED or
                (room.state == RoomState.TEMPORARILY_UNREACHABLE and
                 room.unreachable_confirmed and
                 bool(room.unreachable_reason)))

    def _corridor(self, corridor_id: Optional[str]):
        return next((item for item in self.topology.corridors
                     if item.corridor_id == corridor_id), None)

    def _path_stays_in_corridor(self, path: Sequence[Point], margin: float = 0.16) -> bool:
        corridor = self.current_corridor
        if not path or corridor is None or not corridor.centerline:
            return False
        axis = unit(corridor.principal_direction)
        normal = (-axis[1], axis[0])
        origin = corridor.centerline[0]
        limit = max(0.20, 0.5 * corridor.estimated_width - float(margin))
        return all(abs((point[0] - origin[0]) * normal[0] +
                       (point[1] - origin[1]) * normal[1]) <= limit
                   for point in path)

    @staticmethod
    def _point_in_corridor_region(
        point: Point, corridor, margin: float = 0.10,
    ) -> bool:
        if corridor is None or len(corridor.centerline) < 2:
            return False
        start, end = corridor.centerline[0], corridor.centerline[-1]
        axis = unit(corridor.principal_direction)
        normal = (-axis[1], axis[0])
        longitudinal = ((point[0] - start[0]) * axis[0] +
                        (point[1] - start[1]) * axis[1])
        length = distance(start, end)
        lateral = abs((point[0] - start[0]) * normal[0] +
                      (point[1] - start[1]) * normal[1])
        return (-0.5 <= longitudinal <= length + 0.5 and
                lateral <= max(0.20, 0.5 * corridor.estimated_width - margin))

    def _path_stays_in_corridor_union(self, path: Sequence[Point]) -> bool:
        corridors = [item for item in self.topology.corridors if item.confirmed]
        samples = interpolate_polyline(path, self.p.path_sample_spacing)
        return bool(samples and corridors and all(
            any(self._point_in_corridor_region(point, corridor)
                for corridor in corridors) for point in samples))

    def _path_reenters_corridor_union(self, path: Sequence[Point]) -> bool:
        """Allow a safe outside prefix whose sole purpose is corridor re-entry.

        Requiring every sample to be in the inferred corridor union makes
        recovery impossible precisely when execution drift leaves that union.
        The path may therefore start outside, but it must enter a confirmed
        corridor and every sample after the first entry must remain inside.
        Occupancy and voxel clearance are still validated separately before
        this path can be executed.
        """
        corridors = [item for item in self.topology.corridors if item.confirmed]
        samples = interpolate_polyline(path, self.p.path_sample_spacing)
        if not samples or not corridors:
            return False
        inside = [any(self._point_in_corridor_region(point, corridor)
                      for corridor in corridors) for point in samples]
        try:
            first_inside = inside.index(True)
        except ValueError:
            return False
        return all(inside[first_inside:])

    @staticmethod
    def _nearest_corridor_point(point: Point, corridor) -> Point:
        start, end = corridor.centerline[0], corridor.centerline[-1]
        segment = (end[0] - start[0], end[1] - start[1])
        length_squared = segment[0] ** 2 + segment[1] ** 2
        alpha = 0.0 if length_squared < 1e-9 else float(np.clip(
            ((point[0] - start[0]) * segment[0] +
             (point[1] - start[1]) * segment[1]) / length_squared,
            0.0, 1.0))
        return (start[0] + alpha * segment[0],
                start[1] + alpha * segment[1])

    def _corridor_recovery_escape_goal(self) -> Optional[dict]:
        """Build a short map-validated escape independent of FUEL frontiers.

        The corridor centreline is a topology reference, not a rail.  Recenter
        only when the robot approaches the usable lateral boundary; otherwise
        prefer a longitudinal step that creates new sensor coverage.
        """
        if self.grid is None or self.pose is None:
            return None
        current = (self.pose["x"], self.pose["y"])
        corridors = [item for item in self.topology.corridors
                     if item.confirmed and len(item.centerline) >= 2]
        ranked = sorted(
            corridors,
            key=lambda item: (
                not self._point_in_corridor_region(current, item),
                distance(current, self._nearest_corridor_point(current, item)),
                -item.confidence))
        for corridor in ranked:
            projection = self._nearest_corridor_point(current, corridor)
            lateral_distance = distance(current, projection)
            recenter_threshold = max(
                0.30, 0.5 * corridor.estimated_width - 0.35)
            for index, target in enumerate(corridor_recovery_targets(
                    current, corridor, step_distance=1.20,
                    recenter_threshold=recenter_threshold)):
                if any(distance(target, failed) < 0.30
                       for failed in self.recovery_escape_failed_targets[-8:]):
                    continue
                # Recentring is normally a short lateral line.  If that line
                # meets an occupied centre cell, allow A* to find a free bend.
                # An outside prefix is permitted only until the first safe
                # re-entry into the confirmed corridor union.
                path = [current, target]
                validity = validate_path(
                    self.grid, path, spacing=self.p.path_sample_spacing,
                    initial_unknown_footprint_grace=
                    self.initial_unknown_footprint_grace,
                    check_footprint=False)
                if not validity.valid:
                    path = astar_free_path(
                        self.grid, current, target,
                        allow_unknown_at_start=True)
                    validity = validate_path(
                        self.grid, path, spacing=self.p.path_sample_spacing,
                        initial_unknown_footprint_grace=
                        self.initial_unknown_footprint_grace,
                        check_footprint=False)
                if (not path or distance(path[0], path[-1]) < 0.25 or
                        not validity.valid or
                        not self._path_reenters_corridor_union(path)):
                    continue
                self.current_corridor = corridor
                is_recenter = bool(
                    lateral_distance >= recenter_threshold and
                    distance(target, projection) < 0.15)
                return {
                    "position": target,
                    "path": path,
                    "source": ("corridor_recovery_recenter" if is_recenter else
                               "corridor_recovery_step"),
                    "corridor_id": corridor.corridor_id,
                }
        return None

    def _door_candidate_takeover_candidate(
            self) -> Optional[RoomExpansionObservation]:
        """Latch the first strong portal candidate until entry or hard failure.

        A confirmed room expansion with a measured portal is actionable
        evidence, even before an independent wall-gap track is stable.  Once
        latched, generic/corridor FUEL must not carry the robot past it.
        """
        if self.door_locked:
            return None
        active = self.door_candidate_takeover
        if active is not None:
            candidate = self.room_candidates.get(active["candidate_id"])
            if candidate is not None:
                return candidate
            self._finish_door_candidate_takeover_failure(
                "door_candidate_track_lost_after_takeover")
            return None
        eligible = [
            candidate for candidate in self.room_candidates.values()
            if candidate.confirmed and candidate.portal_center is not None and
            candidate.portal_confidence >= 0.70 and
            candidate.observations >= 2 and not candidate.door_id
        ]
        if not eligible or self.pose is None:
            return None
        current = (self.pose["x"], self.pose["y"])
        candidate = min(
            eligible,
            key=lambda item: distance(current, item.portal_center))
        started = self.elapsed()
        self.door_candidate_takeover = {
            "candidate_id": candidate.candidate_id,
            "portal_center": list(candidate.portal_center),
            "portal_confidence": candidate.portal_confidence,
            "started_t": round(started, 3),
            "deadline_t": round(
                started + max(10.0, self.door_candidate_entry_timeout), 3),
            "attention_attempts": 0,
            "obstacle_confirmations": 0,
            "last_block_reason": None,
            "status": "active",
        }
        self._event(
            "door_candidate_entry_takeover_started",
            candidate_id=candidate.candidate_id,
            portal_center=candidate.portal_center,
            portal_confidence=candidate.portal_confidence,
            deadline_t=self.door_candidate_takeover["deadline_t"],
            policy="suspend_fuel_until_entered_or_obstacle_confirmed")
        return candidate

    def _door_candidate_takeover_expired(self) -> bool:
        active = self.door_candidate_takeover
        return bool(
            active is not None and
            self.elapsed() >= float(active["deadline_t"]))

    def _door_owned_by_candidate_takeover(self, door: Doorway) -> bool:
        active = self.door_candidate_takeover
        return bool(
            active is not None and
            door.source_room_candidate_id == active["candidate_id"])

    def _finish_door_candidate_takeover_failure(self, reason: str) -> None:
        active = self.door_candidate_takeover
        if active is None:
            return
        active["status"] = "failed"
        active["failure_reason"] = reason
        active["finished_t"] = round(self.elapsed(), 3)
        self.door_candidate_takeover_history.append(dict(active))
        self._event(
            "door_candidate_entry_takeover_failed",
            candidate_id=active["candidate_id"],
            reason=reason,
            attention_attempts=active["attention_attempts"],
            last_block_reason=active.get("last_block_reason"))
        self.termination_reason = reason
        self.exploration_complete = False
        self._transition(MissionPhase.FINISHED, reason)

    @staticmethod
    def _channel_has_occupied_evidence(
            two_dimensional: Optional[dict], voxel: Optional[dict]) -> bool:
        """Return true only for measured occupied cells/samples in a channel."""
        two_dimensional = two_dimensional or {}
        voxel = voxel or {}
        return bool(
            int(two_dimensional.get("occupied_intersections", 0) or 0) > 0 or
            int(voxel.get("occupied_samples", 0) or 0) > 0)

    def _handle_candidate_takeover_channel_failure(
            self, door: Doorway, reason: str,
            two_dimensional: Optional[dict] = None,
            voxel: Optional[dict] = None) -> bool:
        """Keep a candidate-owned door committed unless occupancy is repeated.

        Unknown cells, a temporarily incomplete map, executor no-progress, and
        a single noisy occupied sample are not permission to resume corridor
        exploration.  Two consecutive channel checks containing measured
        occupied evidence are treated as an actually blocked entrance.
        """
        if not self._door_owned_by_candidate_takeover(door):
            return False
        active = self.door_candidate_takeover
        if active is None:
            return False
        occupied = self._channel_has_occupied_evidence(
            two_dimensional, voxel)
        active["last_block_reason"] = reason
        if occupied:
            active["obstacle_confirmations"] = int(
                active.get("obstacle_confirmations", 0)) + 1
        else:
            active["obstacle_confirmations"] = 0
        confirmations = int(active["obstacle_confirmations"])
        self._event(
            "door_candidate_entry_channel_retry",
            candidate_id=active["candidate_id"],
            door_id=door.door_id,
            reason=reason,
            occupied_evidence=occupied,
            obstacle_confirmations=confirmations,
            deadline_t=active["deadline_t"],
            fuel_suppressed=True)
        if confirmations >= 2:
            self._finish_door_candidate_takeover_failure(
                "door_candidate_channel_obstacle_confirmed")
        return True

    def _door_attention_goal(
            self, forced_candidate_id: Optional[str] = None) -> Optional[dict]:
        """Return one safe corridor-centre observation point for a side opening."""
        if self.door_locked:
            # Attention is a pre-selection confirmation step.  Once a door is
            # committed, never let another observation target interrupt its
            # fixed approach/alignment/crossing sequence.
            self._record_door_commit("door_attention_suppressed_after_lock")
            return None
        if not self.enable_door_attention or self.pose is None:
            return None
        current = (self.pose["x"], self.pose["y"])
        choices = []
        for candidate in self.room_candidates.values():
            forced = candidate.candidate_id == forced_candidate_id
            if (not forced and
                    candidate.candidate_id in self.door_attention_attempted or
                    self.elapsed() < self.door_attention_retry_after.get(
                        candidate.candidate_id, 0.0) or
                    (forced_candidate_id is not None and not forced) or
                    candidate.door_id or not candidate.confirmed or
                    candidate.portal_center is None or
                    candidate.observations < 2 or
                    candidate.portal_confidence < 0.70):
                continue
            corridor = self._corridor(candidate.corridor_id)
            if corridor is None or not corridor.confirmed:
                continue
            target = self._nearest_corridor_point(candidate.portal_center, corridor)
            range_m = distance(current, target)
            # Attend while passing the opening.  Very old hypotheses are kept
            # in topology for later global recovery but must not cause a large
            # immediate corridor reversal.
            if range_m > 5.5 and not forced:
                continue
            # When already beside the opening, inflated A* may reject the
            # exact centreline station even though holding position is safe.
            # Accumulate independent sensor frames here instead of driving
            # away and losing the aperture.
            if (range_m <= 1.20 and
                    self._point_in_corridor_region(current, corridor)):
                score = (candidate.fused_confidence +
                         0.15 * min(candidate.observations, 4) -
                         0.04 * range_m + 0.25)
                choices.append((score, candidate, current, [current], forced))
                continue
            path = astar_free_path(
                self.grid, current, target,
                clearance_radius=self.corridor_network_clearance,
                allow_unknown_at_start=True)
            if not path and forced:
                # The confirmed portal owns the mission now.  A conservative
                # corridor inflation may reject a perfectly free observation
                # station, so retry with the robot footprint radius; normal
                # 2-D/3-D execution validation remains authoritative.
                path = astar_free_path(
                    self.grid, current, target,
                    clearance_radius=0.16,
                    allow_unknown_at_start=True)
            if not path or (not forced and
                            not self._path_stays_in_corridor_union(path)):
                continue
            score = (candidate.fused_confidence +
                     0.15 * min(candidate.observations, 4) - 0.04 * range_m)
            choices.append((score, candidate, target, path, forced))
        if not choices:
            return None
        _, candidate, target, path, forced = max(
            choices, key=lambda item: item[0])
        return {"candidate": candidate, "target": target, "path": path,
                "forced_takeover": forced}

    def _observe_door_attention(self, candidate_id: str) -> int:
        """Consume several independent map projections at the attention station."""
        observed_sequences = set()
        deadline = time.monotonic() + max(0.2, self.door_attention_timeout)
        while (not rospy.is_shutdown() and time.monotonic() < deadline and
               len(observed_sequences) < self.door_attention_observation_frames):
            with self.lock:
                sequence = self.grid_sequence
            if sequence not in observed_sequences:
                before = self.last_topology_grid_sequence
                self._update_topology(
                    allow_promotion=False, update_source="door_attention")
                if self.last_topology_grid_sequence != before:
                    observed_sequences.add(sequence)
            time.sleep(0.08)
        with self.lock:
            grid, sequence = self.grid, self.grid_sequence
        if grid is not None:
            self._promote_room_candidates_to_doors(
                grid, sequence, candidate_id=candidate_id)
        self._event("door_attention_completed", candidate_id=candidate_id,
                    independent_grid_frames=len(observed_sequences))
        return len(observed_sequences)

    def _door_attention_multiview_targets(
        self, candidate: RoomExpansionObservation,
    ) -> List[Tuple[str, Point]]:
        """Generate corridor-side views around one fixed inferred portal."""
        corridor = self._corridor(candidate.corridor_id)
        if corridor is None or candidate.portal_center is None:
            return []
        portal = tuple(candidate.portal_center)
        base = self._nearest_corridor_point(portal, corridor)
        axis = unit(corridor.principal_direction)
        toward_portal = unit(math.atan2(
            portal[1] - base[1], portal[0] - base[0]))
        proposals = [
            ("left_offset", (base[0] + 0.40 * axis[0],
                             base[1] + 0.40 * axis[1])),
            ("right_offset", (base[0] - 0.40 * axis[0],
                              base[1] - 0.40 * axis[1])),
            ("forward_offset", (base[0] + 0.50 * toward_portal[0],
                                base[1] + 0.50 * toward_portal[1])),
        ]
        nx, ny = unit(candidate.portal_normal_direction)
        accepted = []
        for view_id, target in proposals:
            # Keep every attention point on the corridor/outside half-plane.
            # This is an observation manoeuvre, never an inferred-door cross.
            signed_depth = ((target[0] - portal[0]) * nx +
                            (target[1] - portal[1]) * ny)
            yaw = math.atan2(portal[1] - target[1], portal[0] - target[0])
            if (signed_depth > -0.10 or
                    not self._point_in_corridor_region(target, corridor) or
                    not self.grid.footprint_safe(target, yaw)):
                self.door_attention_multiview.append({
                    "t": round(self.elapsed(), 3),
                    "candidate_id": candidate.candidate_id,
                    "view_id": view_id,
                    "view_position": target,
                    "reached": False,
                    "door_confirmed": False,
                    "reject_reason": "unsafe_or_not_corridor_side",
                    "frame_evidence_count": 0,
                    "frame_support_count": 0,
                    "frame_evidence_observations": 0,
                })
                continue
            accepted.append((view_id, target))
        return accepted

    def _door_attention_view_path(
        self, candidate: RoomExpansionObservation, target: Point,
    ) -> Tuple[List[Point], str]:
        """Return a live safe A* path that remains outside the inferred portal."""
        current = (self.pose["x"], self.pose["y"])
        corridor = self._corridor(candidate.corridor_id)
        if corridor is None or candidate.portal_center is None:
            return [], "candidate_geometry_unavailable"
        path = ([current] if distance(current, target) <= 0.20 else
                astar_free_path(
                    self.grid, current, target,
                    clearance_radius=self.corridor_network_clearance,
                    allow_unknown_at_start=True))
        if not path:
            return [], "astar_unreachable"
        if not self._path_stays_in_corridor_union(path):
            return [], "path_leaves_corridor_union"
        validity = validate_path(
            self.grid, path, spacing=self.p.path_sample_spacing,
            initial_unknown_footprint_grace=
            self.initial_unknown_footprint_grace)
        if not validity.valid:
            return [], "path_" + validity.reason
        portal = tuple(candidate.portal_center)
        nx, ny = unit(candidate.portal_normal_direction)
        if any(((point[0] - portal[0]) * nx +
                (point[1] - portal[1]) * ny) > -0.10 for point in path):
            return [], "path_crosses_inferred_portal_plane"
        return path, "safe"

    def _record_door_attention_view(
        self, candidate_id: str, view_id: str, view_position: Point,
        reached: bool, independent_grid_frames: int = 0,
        motion_reject_reason: Optional[str] = None,
    ) -> Optional[Doorway]:
        """Record the unchanged Door Confirm result after one attention view."""
        candidate = self.room_candidates.get(candidate_id)
        corridor = (self._corridor(candidate.corridor_id)
                    if candidate is not None else None)
        support = (select_independent_door_support(
            candidate, corridor, self.topology.doors, self.p)
                   if candidate is not None and corridor is not None else None)
        door = (self._door(candidate.door_id)
                if candidate is not None and candidate.door_id else None)
        confirmed = bool(door is not None and door.confirmed and door.traversable)
        validation = (dict(candidate.channel_validation)
                      if candidate is not None else {})
        channel_fit = validation.get("channel_fit", {})
        independent_support_observations = int(
            validation.get("independent_door_support_observations", 0))
        frame_evidence_count = int(
            channel_fit.get("framed_hypotheses", 0))
        if support is not None:
            independent_support_observations = max(
                independent_support_observations, int(support.observations))
            frame_evidence_count = max(frame_evidence_count, 1)
        reject_reason = motion_reject_reason
        if reject_reason is None and not confirmed:
            reject_reason = str(validation.get("reason") or
                                validation.get("two_dimensional", {}).get("reason") or
                                validation.get("voxel", {}).get("reason") or
                                "door_confirm_not_satisfied")
        self.door_attention_multiview.append({
            "t": round(self.elapsed(), 3),
            "candidate_id": candidate_id,
            "view_id": view_id,
            "view_position": view_position,
            "reached": bool(reached),
            "independent_grid_frames": int(independent_grid_frames),
            "door_confirmed": confirmed,
            "door_id": door.door_id if door is not None else None,
            "reject_reason": None if confirmed else reject_reason,
            "frame_evidence_count": frame_evidence_count,
            "frame_support_count": int(
                support is not None or
                validation.get("independent_door_support_id") is not None),
            "frame_evidence_observations": independent_support_observations,
            "channel_validation": validation,
        })
        return door if confirmed else None

    def _activate_attention_door(self, door: Doorway) -> None:
        self.current_door_id = door.door_id
        self.room_queue = [door.door_id] + [
            item for item in self.room_queue if item != door.door_id]
        self._transition(
            MissionPhase.APPROACH_DOOR,
            "active_door_attention_confirmed_executable_door")

    def _execute_door_attention_goal(self, attention: dict) -> bool:
        """Run adaptive multi-view attention for one retained room candidate."""
        candidate = attention["candidate"]
        forced_takeover = bool(attention.get("forced_takeover"))
        if (forced_takeover and self.door_candidate_takeover is not None and
                self.door_candidate_takeover["candidate_id"] ==
                candidate.candidate_id):
            self.door_candidate_takeover["attention_attempts"] += 1
        self._event(
            "door_attention_started",
            candidate_id=candidate.candidate_id,
            portal_center=candidate.portal_center,
            observation_target=attention["target"],
            observations=candidate.observations,
            sensor_strategy="stationary_360_lidar_plus_available_depth",
            motion_strategy="corridor_short_segments_with_heading_settle",
            maximum_segment_distance=0.45,
            goal_tolerance=0.15,
            forced_takeover=forced_takeover)
        self.speed_pub.publish(Float32(data=self.door_speed))
        reached = (distance(
            (self.pose["x"], self.pose["y"]), attention["target"]) <= 0.35 or
            self._execute_path(
                attention["path"], "door_attention_verify",
                metadata={
                    "room_candidate_id": candidate.candidate_id,
                    "attention_motion_policy":
                    "short_corridor_segments_with_heading_settle",
                },
                # This is corridor travel to an observation station, not a
                # door crossing.  The path already stays in the confirmed
                # corridor union and retains live 2-D centreline plus OctoMap
                # validation.  A current-yaw footprint hard gate rejected the
                # first attempt on one quantised wall cell before any motion.
                strict_footprint=False,
                maximum_segment_distance=0.45,
                goal_tolerance=0.15,
                require_segment_heading=True))
        any_reached = bool(reached)
        if reached:
            # Mark attendance before promotion so the unchanged strict local
            # framed-channel validator can consume the new LiDAR projections.
            self.door_attention_attempted.add(candidate.candidate_id)
            self.door_attention_reached_views.setdefault(
                candidate.candidate_id, set()).add("primary")
            frames = self._observe_door_attention(candidate.candidate_id)
            door = self._record_door_attention_view(
                candidate.candidate_id, "primary", attention["target"],
                True, independent_grid_frames=frames)
            if door is not None:
                self._activate_attention_door(door)
                return True
        else:
            self._record_door_attention_view(
                candidate.candidate_id, "primary", attention["target"], False,
                motion_reject_reason="primary_view_motion_failed")

        # The first view failed to confirm a door.  Keep this exact candidate
        # and portal; acquire independent geometry from offset corridor views.
        refreshed = self.room_candidates.get(candidate.candidate_id, candidate)
        for view_id, target in self._door_attention_multiview_targets(refreshed):
            path, path_reason = self._door_attention_view_path(refreshed, target)
            if not path:
                self._record_door_attention_view(
                    refreshed.candidate_id, view_id, target, False,
                    motion_reject_reason=path_reason)
                continue
            view_reached = (distance(
                (self.pose["x"], self.pose["y"]), target) <= 0.35 or
                self._execute_path(
                    path, "door_attention_verify",
                    metadata={
                        "room_candidate_id": refreshed.candidate_id,
                        "attention_view_id": view_id,
                        "attention_motion_policy":
                        "adaptive_multiview_corridor_side",
                    },
                    strict_footprint=False,
                    maximum_segment_distance=0.45,
                    goal_tolerance=0.15,
                    require_segment_heading=True))
            any_reached = any_reached or view_reached
            if not view_reached:
                self._record_door_attention_view(
                    refreshed.candidate_id, view_id, target, False,
                    motion_reject_reason="view_motion_failed")
                continue
            self.door_attention_attempted.add(refreshed.candidate_id)
            self.door_attention_reached_views.setdefault(
                refreshed.candidate_id, set()).add(view_id)
            frames = self._observe_door_attention(refreshed.candidate_id)
            door = self._record_door_attention_view(
                refreshed.candidate_id, view_id, target, True,
                independent_grid_frames=frames)
            if door is not None:
                self._activate_attention_door(door)
                return True
            refreshed = self.room_candidates.get(
                refreshed.candidate_id, refreshed)

        # No executable door was produced.  A reached view must not leave the
        # candidate permanently in door_attention_attempted: that was the
        # reason strong portals were observed once and then silently skipped
        # for the rest of the run.  Keep retrying the exact latched candidate.
        self.door_attention_attempted.discard(candidate.candidate_id)
        self.door_attention_retry_after[candidate.candidate_id] = (
            self.elapsed() + (2.0 if forced_takeover else 15.0))
        refreshed = self.room_candidates.get(
            candidate.candidate_id, candidate)
        validation = refreshed.channel_validation or {}
        two_d = validation.get("two_dimensional") or {}
        voxel = validation.get("voxel") or {}
        obstacle_blocked = bool(
            int(two_d.get("occupied_intersections", 0)) > 0 or
            int(voxel.get("occupied_samples", 0)) > 0)
        if forced_takeover and self.door_candidate_takeover is not None:
            takeover = self.door_candidate_takeover
            takeover["last_block_reason"] = (
                validation.get("reason") or two_d.get("reason") or
                voxel.get("reason") or
                ("attention_motion_failed" if not any_reached else
                 "door_not_yet_executable"))
            if obstacle_blocked:
                takeover["obstacle_confirmations"] += 1
            else:
                takeover["obstacle_confirmations"] = 0
            if takeover["obstacle_confirmations"] >= 2:
                self._finish_door_candidate_takeover_failure(
                    "door_candidate_channel_obstacle_confirmed")
        self._event(
            "door_attention_failed",
            candidate_id=candidate.candidate_id,
            strategy="adaptive_multiview",
            views_recorded=sum(
                record.get("candidate_id") == candidate.candidate_id
                for record in self.door_attention_multiview),
            retry_after=self.door_attention_retry_after.get(
                candidate.candidate_id),
            forced_takeover=forced_takeover,
            obstacle_blocked=obstacle_blocked)
        return any_reached

    def _run_door_candidate_entry_takeover(self) -> bool:
        """Own planning after a strong portal appears; never fall back to FUEL."""
        candidate = self._door_candidate_takeover_candidate()
        if candidate is None:
            return self.phase == MissionPhase.FINISHED
        if self._door_candidate_takeover_expired():
            self._finish_door_candidate_takeover_failure(
                "door_candidate_entry_timeout")
            return True
        if candidate.door_id:
            door = self._door(candidate.door_id)
            if door is not None and door.confirmed and door.traversable:
                self.current_door_id = door.door_id
                self.room_queue = [door.door_id] + [
                    item for item in self.room_queue
                    if item != door.door_id]
                self._event(
                    "door_candidate_entry_takeover_promoted",
                    candidate_id=candidate.candidate_id,
                    door_id=door.door_id)
                self._transition(
                    MissionPhase.APPROACH_DOOR,
                    "forced_room_candidate_door_entry")
                return True
            if door is None:
                # The topology tracker may replace a transient Doorway while
                # the room candidate itself remains stable.  Re-run attention
                # for the same candidate instead of waiting forever on a stale
                # door id or returning to FUEL.
                candidate.door_id = None
                if self.door_candidate_takeover is not None:
                    self.door_candidate_takeover["last_block_reason"] = (
                        "promoted_door_track_disappeared")
        attention = self._door_attention_goal(
            forced_candidate_id=candidate.candidate_id)
        if attention is not None:
            self._execute_door_attention_goal(attention)
            return True
        active = self.door_candidate_takeover
        if active is not None:
            active["last_block_reason"] = "attention_observation_path_unavailable"
        if self.last_door_candidate_takeover_grid_sequence != self.grid_sequence:
            self.last_door_candidate_takeover_grid_sequence = self.grid_sequence
            self._event(
                "door_candidate_entry_takeover_waiting",
                candidate_id=candidate.candidate_id,
                reason="attention_observation_path_unavailable_or_retry_delay",
                deadline_t=(active.get("deadline_t") if active else None),
                fuel_suppressed=True)
        time.sleep(0.35)
        return True

    def _register_opposite_door_attention(self, door: Doorway) -> None:
        """Remember the opposite wall as a soft inspection region only."""
        if (not self.enable_opposite_door_attention or
                door.door_id in self.opposite_door_attentions):
            return
        corridor = self._corridor(door.corridor_id)
        if corridor is None or not corridor.confirmed:
            return
        geometry = opposite_door_attention_geometry(door, corridor)
        attention = {
            "source_door_id": door.door_id,
            "corridor_id": corridor.corridor_id,
            "observation_target": geometry["observation_target"],
            "expected_center": geometry["expected_center"],
            "expected_normal_direction": geometry["expected_normal_direction"],
            "station_tolerance": self.opposite_door_station_tolerance,
            "created_t": round(self.elapsed(), 3),
            "created_grid_sequence": self.grid_sequence,
            "status": "waiting_for_room_exit",
            "attempts": 0,
            "independent_grid_frames": 0,
            "matched_door_ids": [],
            "matched_candidate_ids": [],
        }
        self.opposite_door_attentions[door.door_id] = attention
        self._event(
            "opposite_door_attention_registered",
            source_door_id=door.door_id,
            corridor_id=corridor.corridor_id,
            observation_target=geometry["observation_target"],
            expected_center=geometry["expected_center"],
            expected_normal_direction=geometry["expected_normal_direction"])

    def _opposite_attention_matches(self, attention: dict) -> Tuple[List[Doorway], List[str]]:
        expected = attention["expected_center"]
        expected_normal = unit(attention["expected_normal_direction"])
        tolerance = float(attention["station_tolerance"])
        corridor_id = attention["corridor_id"]
        minimum_alignment = math.cos(math.radians(
            self.p.door_angle_tolerance_deg + 5.0))
        doors = [door for door in self.topology.doors
                 if door.door_id != attention["source_door_id"] and
                 door.corridor_id == corridor_id and
                 distance(door.center, expected) <= tolerance and
                 dot(door.normal, expected_normal) >= minimum_alignment]
        candidates = []
        for candidate in self.room_candidates.values():
            if (candidate.corridor_id != corridor_id or
                    candidate.portal_center is None or
                    distance(candidate.portal_center, expected) > tolerance):
                continue
            if candidate.portal_normal_direction is not None and dot(
                    unit(candidate.portal_normal_direction),
                    expected_normal) < minimum_alignment:
                continue
            candidates.append(candidate.candidate_id)
        return doors, candidates

    def _observe_opposite_door_attention(self, attention: dict) -> int:
        observed_sequences = set()
        deadline = time.monotonic() + max(0.2, self.door_attention_timeout)
        while (not rospy.is_shutdown() and time.monotonic() < deadline and
               len(observed_sequences) < self.door_attention_observation_frames):
            with self.lock:
                sequence = self.grid_sequence
            if sequence not in observed_sequences:
                before = self.last_topology_grid_sequence
                self._update_topology(
                    allow_promotion=False,
                    update_source="opposite_door_attention")
                if self.last_topology_grid_sequence != before:
                    observed_sequences.add(sequence)
            time.sleep(0.08)
        with self.lock:
            grid, sequence = self.grid, self.grid_sequence
        if grid is not None:
            # This is the normal evidence gate.  The paired-room prior never
            # bypasses wall-gap, room-expansion, or 3-D channel validation.
            self._promote_room_candidates_to_doors(grid, sequence)
        return len(observed_sequences)

    def _run_opposite_door_attention(self) -> bool:
        """Inspect one opposite wall region after completing its paired room."""
        if not self.enable_opposite_door_attention or self.pose is None:
            return False
        pending = []
        for attention in self.opposite_door_attentions.values():
            if attention["status"] != "pending":
                continue
            source = self._door(attention["source_door_id"])
            if source is None or not source.visited:
                continue
            pending.append(attention)
        if not pending:
            return False
        current = (self.pose["x"], self.pose["y"])
        attention = min(pending, key=lambda item: distance(
            current, item["observation_target"]))
        matched_doors, matched_candidates = self._opposite_attention_matches(attention)
        executable = [door for door in matched_doors
                      if door.confirmed and door.traversable and
                      door.source_room_candidate_id]
        if executable:
            attention["status"] = "resolved_existing_door"
            attention["matched_door_ids"] = [door.door_id for door in executable]
            attention["matched_candidate_ids"] = matched_candidates
            self._event("opposite_door_attention_resolved_existing",
                        source_door_id=attention["source_door_id"],
                        matched_door_ids=attention["matched_door_ids"])
            return False
        target = tuple(attention["observation_target"])
        path = astar_free_path(
            self.grid, current, target,
            clearance_radius=self.corridor_network_clearance,
            allow_unknown_at_start=True)
        if (distance(current, target) > self.generic_goal_tolerance and
                (not path or not self._path_stays_in_corridor_union(path))):
            attention["status"] = "observation_station_unreachable"
            self._event("opposite_door_attention_unreachable",
                        source_door_id=attention["source_door_id"],
                        observation_target=target)
            return False
        attention["attempts"] += 1
        attention["status"] = "observing"
        self._event("opposite_door_attention_started",
                    source_door_id=attention["source_door_id"],
                    expected_center=attention["expected_center"],
                    observation_target=target)
        if distance(current, target) > self.generic_goal_tolerance:
            self.speed_pub.publish(Float32(data=self.door_speed))
            if not self._execute_path(path, "opposite_door_attention_verify"):
                attention["status"] = "observation_execution_failed"
                self._event("opposite_door_attention_failed",
                            source_door_id=attention["source_door_id"],
                            reason="observation_execution_failed")
                return True
        attention["independent_grid_frames"] = self._observe_opposite_door_attention(
            attention)
        matched_doors, matched_candidates = self._opposite_attention_matches(attention)
        attention["matched_door_ids"] = [door.door_id for door in matched_doors]
        attention["matched_candidate_ids"] = matched_candidates
        executable = [door for door in matched_doors
                      if door.confirmed and door.traversable and
                      door.source_room_candidate_id]
        stable_gaps = [door for door in matched_doors if door.confirmed]
        if executable:
            attention["status"] = "executable_door_confirmed"
        elif stable_gaps:
            attention["status"] = "stable_wall_gap_only"
        elif matched_candidates:
            attention["status"] = "room_candidate_only"
        else:
            attention["status"] = "no_confirmed_door_evidence"
        self._event(
            "opposite_door_attention_completed",
            source_door_id=attention["source_door_id"],
            status=attention["status"],
            independent_grid_frames=attention["independent_grid_frames"],
            matched_door_ids=attention["matched_door_ids"],
            matched_candidate_ids=matched_candidates)
        return True

    def _refresh_room_geometry(self, room: RoomRegion, door: Doorway,
                               robot_pose: Point) -> None:
        new_map_sample = room.last_map_sequence != self.grid_sequence
        update_room_geometry(room, self.grid, door, robot_pose,
                             map_sequence=self.grid_sequence)
        seed = (door.center[0] + max(1.05, room.maximum_inside_depth) * door.normal[0],
                door.center[1] + max(1.05, room.maximum_inside_depth) * door.normal[1])
        region = set(room_free_region(self.grid, door, seed))
        visited_in_room = 0
        for cell_x, cell_y in self.visited_cells:
            world = (cell_x * 0.25, cell_y * 0.25)
            grid_cell = self.grid.world_to_cell(world)
            visited_in_room += int(grid_cell in region)
        room.visited_free_area = visited_in_room * 0.25 ** 2
        if new_map_sample:
            room.visited_growth_history.append(room.visited_free_area)
            if len(room.visited_growth_history) > 10:
                room.visited_growth_history = room.visited_growth_history[-10:]

    def _write_fuel_history(self) -> str:
        path = os.path.join(self.output_dir, "fuel_execution_history.csv")
        with open(path, "w", newline="", encoding="utf-8") as stream:
            writer = csv.writer(stream)
            writer.writerow(["# x", "y", "source"])
            for item in self.trajectory[::10]:
                writer.writerow([item["x"], item["y"], "trajectory"])
            for item in self.goal_history:
                position = item.get("position") or []
                if len(position) >= 2 and item.get("success"):
                    writer.writerow([position[0], position[1], "goal"])
        return path

    def _run_fuel(self, mode: str) -> Tuple[List[dict], dict, str]:
        with self.lock:
            pose = dict(self.pose)
            frame = self.pose_frame
        self.planner_cycle += 1
        output = os.path.join(self.cycle_dir, "cycle_{:04d}_{}".format(
            self.planner_cycle, mode.lower()))
        os.makedirs(output, exist_ok=True)
        history = self._write_fuel_history()
        exploration_mode = ("ROOM_EXPLORATION" if mode == "room"
                            else mode.upper())
        command = [
            "rosrun", "simenv_competitor", "fuel_lite_planner",
            "__name:=structured_fuel_{:04d}".format(self.planner_cycle),
            "_map_file:=" + self.map_file, "_output_dir:=" + output,
            "_frame_id:=" + frame, "_use_pose_parameters:=true",
            "_exit_after_plan:=true", "_robot_x:={:.9f}".format(pose["x"]),
            "_robot_y:={:.9f}".format(pose["y"]),
            "_robot_z:={:.9f}".format(pose["z"]),
            "_frontier_slice_half_height:=0.30", "_minimum_cluster_size:=6",
            "_maximum_clusters:=100", "_candidates_per_cluster:=8",
            "_candidate_min_distance:=0.25", "_candidate_max_distance:=2.5",
            "_safety_clearance:=0.40", "_adaptive_clearance:=0.25",
            "_minimum_information_gain:=" + (
                "2.0" if mode == "corridor" else
                "0.0" if mode == "room_recovery" else "0.5"),
            "_exploration_mode:=" + exploration_mode,
            "_enable_room_information_gain:=" +
            str(self.enable_room_information_gain).lower(),
            "_room_unknown_decay_lambda:={:.9f}".format(
                self.room_unknown_decay_lambda),
            "_history_file:=" + history, "_sensor_range:=6.0",
            "_alpha:=0.25", "_beta:=0.3", "_gamma:=1.0",
            "_unknown_weight:=5.0", "_cluster_weight:=1.0",
            "_novelty_weight:=500.0", "_revisit_weight:=400.0",
            "/exploration_goal:=/simenv/structured_planner_raw_goal",
        ]
        try:
            with open(os.path.join(output, "planner.log"), "w", encoding="utf-8") as log:
                first_room_remaining = (
                    self.first_room_entry_timeout - self.elapsed()
                    if self.first_room_entry_timeout > 0.0 and not self.rooms
                    else self.planner_timeout)
                completed = subprocess.run(command, stdout=log, stderr=subprocess.STDOUT,
                                           timeout=max(0.1, min(
                                               self.planner_timeout,
                                               first_room_remaining)),
                                           check=False)
            if completed.returncode != 0:
                return [], {}, output
        except (OSError, subprocess.TimeoutExpired):
            return [], {}, output
        candidates = self._load_json(os.path.join(output, "candidate_viewpoints.json")) or []
        scores = self._load_json(os.path.join(output, "exploration_score.json")) or {}
        by_score = {int(item.get("candidate_id", -1)): item
                    for item in scores.get("scores") or []}
        for candidate in candidates:
            decomposition = by_score.get(int(candidate.get("id", -1)), {})
            candidate["score_decomposition"] = decomposition
            candidate["manager_score"] = float(decomposition.get("score", -1e18))
        candidates.sort(key=lambda item: item["manager_score"], reverse=True)
        diagnostic = self._load_json(
            os.path.join(output, "frontier_filter_diagnostic.json")) or {}
        clusters = diagnostic.get("clusters") or []
        if clusters:
            self.large_reachable_unknown = any(
                int(item.get("size", 0)) >= 24 and
                int(item.get("candidate_count_after_connectivity", 0)) > 0
                for item in clusters)
        else:
            # Older planner artifacts do not carry connectivity counts. Be
            # conservative in that compatibility case.
            self.large_reachable_unknown = any(
                int(item.get("size", 0)) >= 24 for item in (
                    self._load_json(os.path.join(output, "frontiers.json")) or []))
        return candidates, scores, output

    def _select_fuel_goal(self, mode: str) -> Optional[dict]:
        candidates, _, output = self._run_fuel(mode)
        with self.lock:
            grid, pose = self.grid, dict(self.pose)
        if grid is None:
            return None
        current = (pose["x"], pose["y"])
        room = self.rooms.get(self.current_room_id) if self.current_room_id else None
        door = self._door(self.current_door_id)
        corridor = self.current_corridor
        room_cells = set()
        # All non-room candidates share one pool.  Confirmed structure only
        # contributes bonuses; missing corridor evidence leaves generic FUEL
        # terms intact and can never reject a candidate.
        if not mode.startswith("room"):
            trajectory = [(item["x"], item["y"]) for item in self.trajectory]
            recent_corridor_goals = [
                tuple(item["path"][-1]) for item in self.path_history
                if (item.get("execution_authorized") and
                    item.get("source") == "fuel_corridor_aware" and
                    item.get("path"))
            ][-8:]
            for candidate in candidates:
                score = candidate.get("score_decomposition") or {}
                position = candidate.get("position") or [math.inf, math.inf]
                corridor_bonus = 0.0
                doorway_bonus = 0.0
                room_entry_bonus = 0.0
                if corridor is not None and corridor.confirmed and len(position) >= 2:
                    axis = unit(corridor.principal_direction)
                    progress = ((position[0] - current[0]) * axis[0] +
                                (position[1] - current[1]) * axis[1])
                    corridor_bonus = max(0.0, min(3.0, progress))
                for known_door in self.topology.doors:
                    if (known_door.confirmed and known_door.traversable and
                            not known_door.visited and len(position) >= 2):
                        proximity = max(0.0, 1.0 - distance(position, known_door.center) / 2.0)
                        doorway_bonus = max(doorway_bonus, proximity)
                        if known_door.estimated_unknown_size > 0.0:
                            room_entry_bonus = max(room_entry_bonus, proximity)
                candidate["corridor_progress_bonus"] = corridor_bonus
                candidate["doorway_bonus"] = doorway_bonus
                candidate["room_entry_bonus"] = room_entry_bonus
                candidate["local_score"] = unified_candidate_score(
                    float(score.get("information_gain", 0.0)),
                    float(score.get("local_unknown_volume", 0.0)),
                    float(score.get("novelty_bonus", 0.0)),
                    float(score.get("distance_cost", candidate.get("distance_to_robot", 0.0))),
                    float(score.get("collision_cost", 0.0)),
                    float(score.get("revisit_penalty", 0.0)),
                    corridor_bonus, doorway_bonus, room_entry_bonus)
                if (len(position) >= 2 and not self.rooms and
                        mode in ("generic", "generic_recovery", "corridor_aware")):
                    candidate["progress_guard"] = forward_progress_guard(
                        (float(position[0]), float(position[1])), trajectory,
                        corridor if corridor and corridor.confirmed else None,
                        maximum_backtrack=1.25)
                if len(position) >= 2 and mode == "corridor_aware":
                    candidate["recent_corridor_goal_distance"] = min(
                        (distance(position, old) for old in recent_corridor_goals),
                        default=math.inf)
                    candidate["recent_corridor_duplicate"] = (
                        candidate["recent_corridor_goal_distance"] < 1.0)
            candidates = order_candidates_with_progress_fallback(candidates)
        if mode.startswith("room") and room and door:
            seed = (door.center[0] + max(1.2, room.maximum_inside_depth) * door.normal[0],
                    door.center[1] + max(1.2, room.maximum_inside_depth) * door.normal[1])
            room_cells = set(room_free_region(grid, door, seed))
            for candidate in candidates:
                score = candidate.get("score_decomposition") or {}
                position = candidate.get("position") or [math.inf, math.inf]
                separation = min(
                    (distance(position, old) for old in room.successful_goals),
                    default=3.0)
                candidate["local_score"] = (
                    float(score.get("information_gain", 0.0))
                    + 5.0 * float(score.get("local_unknown_volume", 0.0))
                    + 2.0 * float(score.get("novelty_bonus", 0.0))
                    + min(3.0, separation)
                    - 0.30 * float(score.get("distance_cost", 0.0))
                    - float(score.get("collision_cost", 0.0))
                    - 2.0 * float(score.get("revisit_penalty", 0.0)))
            candidates.sort(key=lambda item: item.get("local_score", -math.inf),
                            reverse=True)
        rejected = []
        # Generic FUEL exploration already enforces 3-D connectivity and a
        # 0.40 m candidate clearance.  Its 2-D projection can contain narrow
        # unknown slivers even where the 3-D map is clear, so use centreline
        # occupancy plus the authoritative OctoMap path check here.  Keep the
        # full oriented footprint for room/corridor/door topology manoeuvres.
        # Corridor geometry contributes direction/progress scoring, but is not
        # a hard centreline tube.  FUEL already supplies connected candidates
        # with 0.40 m clearance; A* below stays in observed free space and the
        # authoritative OctoMap validation runs before execution.  Keeping the
        # oriented 2-D footprint hard gate here rejected nearly every useful
        # side-offset corridor viewpoint when projection quantisation changed.
        strict_footprint = mode.startswith("room")
        for candidate in candidates:
            position = candidate.get("position") or []
            if len(position) < 2:
                continue
            target = (float(position[0]), float(position[1]))
            if ("recovery" in mode and any(
                    distance(target, failed) < 0.60
                    for failed in self.recovery_failed_targets[-12:])):
                rejected.append({"id": candidate.get("id"),
                                 "reason": "recovery_target_blacklisted"})
                continue
            if distance(current, target) < max(
                    0.25, 0.8 * self.generic_goal_tolerance):
                rejected.append({"id": candidate.get("id"),
                                 "reason": "zero_progress_execution_prefix"})
                continue
            if mode.startswith("corridor"):
                if corridor is None or len(corridor.centerline) < 2:
                    continue
                axis = unit(corridor.principal_direction)
                forward = ((target[0] - current[0]) * axis[0] +
                           (target[1] - current[1]) * axis[1])
                # Prevent large backtracking, but do not reject safe lateral
                # offsets merely because they are away from the inferred line.
                if forward < -0.35:
                    rejected.append({"id": candidate.get("id"),
                                     "reason": "corridor_large_backtrack"})
                    continue
                path = astar_free_path(
                    grid, current, target, clearance_radius=0.24,
                    allow_unknown_at_start=True)
            elif mode.startswith("room"):
                cell = grid.world_to_cell(target)
                if not room or not door or cell not in room_cells or door.signed_depth(target) < 1.0:
                    rejected.append({"id": candidate.get("id"), "reason": "outside_room"})
                    continue
                if room.successful_goals and min(distance(target, old)
                                                 for old in room.successful_goals) < self.p.room_goal_baseline_min:
                    rejected.append({"id": candidate.get("id"), "reason": "viewpoint_baseline"})
                    continue
                path = astar_free_path(grid, current, target,
                                       allowed_side=(door, 1, 0.08),
                                       allow_unknown_at_start=True)
                if path and any(grid.world_to_cell(point) not in room_cells
                                for point in path[1:]):
                    rejected.append({"id": candidate.get("id"),
                                     "reason": "path_leaves_current_room_region"})
                    self._record_rejected_candidate_path(
                        path, mode, candidate.get("id"),
                        "path_leaves_current_room_region")
                    continue
            else:
                path = astar_free_path(
                    grid, current, target, allow_unknown_at_start=True)
                if (mode.endswith("recovery") and
                        any(item.confirmed for item in self.topology.corridors) and
                        not self._path_reenters_corridor_union(path)):
                    rejected.append({
                        "id": candidate.get("id"),
                        "reason": "global_recovery_leaves_confirmed_corridor_network",
                    })
                    self._record_rejected_candidate_path(
                        path, mode, candidate.get("id"),
                        "global_recovery_leaves_confirmed_corridor_network")
                    continue
            validity = validate_path(
                grid, path, spacing=self.p.path_sample_spacing,
                initial_unknown_footprint_grace=
                self.initial_unknown_footprint_grace,
                check_footprint=strict_footprint)
            if path and validity.valid:
                self._atomic_json(os.path.join(output, "structured_region_filter.json"), {
                    "mode": mode, "selected_candidate_id": candidate.get("id"),
                    "rejected": rejected,
                })
                return {"position": target, "yaw": float(candidate.get("yaw", 0.0)),
                        "path": path, "source": "fuel_" + mode,
                        "candidate_id": candidate.get("id"), "planner_cycle": output,
                        "local_score": candidate.get("local_score"),
                        "corridor_progress_bonus": candidate.get("corridor_progress_bonus", 0.0),
                        "doorway_bonus": candidate.get("doorway_bonus", 0.0),
                        "room_entry_bonus": candidate.get("room_entry_bonus", 0.0),
                        "progress_guard": candidate.get("progress_guard"),
                        "recent_corridor_goal_distance": candidate.get(
                            "recent_corridor_goal_distance"),
                        "recent_corridor_duplicate": candidate.get(
                            "recent_corridor_duplicate", False),
                        "score_decomposition": candidate.get("score_decomposition")}
            rejected.append({"id": candidate.get("id"), "reason": validity.reason})
            self._record_rejected_candidate_path(
                path, mode, candidate.get("id"), validity.reason, validity)
        self._atomic_json(os.path.join(output, "structured_region_filter.json"), {
            "mode": mode, "selected_candidate_id": None, "rejected": rejected,
        })
        return None

    def _adaptive_exploration_step(self) -> None:
        """Use FUEL until a confirmed portal takes exclusive entry control."""
        if self._adopt_embodied_room_candidate_entry():
            return
        if self._run_door_candidate_entry_takeover():
            return
        candidate_door_ids = {
            candidate.door_id for candidate in self.room_candidates.values()
            if candidate.door_id
        }
        reachable_promoted = [
            door_id for door_id in self._build_reachable_room_queue()
            if door_id in candidate_door_ids
        ]
        if reachable_promoted:
            self.room_queue = reachable_promoted
            self.current_door_id = reachable_promoted[0]
            self._transition(MissionPhase.APPROACH_DOOR,
                             "validated_room_candidate_door_reachable")
            return
        corridor_ready = bool(self.current_corridor and self.current_corridor.confirmed)
        desired = (MissionPhase.EXPLORE_CORRIDOR_AWARE if corridor_ready
                   else MissionPhase.EXPLORE_GENERIC)
        if self.phase != desired:
            self._transition(desired, "corridor_scoring_enabled" if corridor_ready
                             else "generic_exploration_available")
        attention = self._door_attention_goal() if corridor_ready else None
        if attention is not None:
            self._execute_door_attention_goal(attention)
            return
        goal = self._select_fuel_goal("corridor_aware" if corridor_ready else "generic")
        if goal:
            self.corridor_no_goal_hold_sequences = []
            self.no_candidate_cycles = 0
            self.global_no_candidate_cycles = 0
            if goal.get("room_entry_bonus", 0.0) > 0.5:
                eligible = [door for door in self.topology.doors
                            if door.confirmed and door.traversable and not door.visited]
                if eligible:
                    self.current_door_id = min(
                        eligible, key=lambda door: distance(goal["position"], door.center)).door_id
                    self._transition(MissionPhase.APPROACH_DOOR,
                                     "unified_pool_selected_room_entry")
                    return
            self.speed_pub.publish(Float32(data=self.corridor_speed))
            if not self._execute_path(goal["path"], goal["source"], metadata={
                    key: goal.get(key) for key in (
                        "candidate_id", "planner_cycle", "local_score",
                        "score_decomposition", "progress_guard",
                        "recent_corridor_goal_distance",
                        "recent_corridor_duplicate")},
                    # A corridor centreline is soft directional evidence.  The
                    # selected path already has metric A* clearance and is
                    # checked against OctoMap before motion; do not turn the
                    # inferred centre strip back into a hard execution rail.
                    strict_footprint=False):
                self._transition(MissionPhase.RECOVERY, "generic_goal_execution_failed")
            return
        # Do not launch a long generic recovery route after one planner miss.
        # Hold for three fresh projections so motion-time door observations
        # can be fused or a temporarily blocked corridor candidate can recover.
        if (not self.corridor_no_goal_hold_sequences or
                self.corridor_no_goal_hold_sequences[-1] != self.grid_sequence):
            self.corridor_no_goal_hold_sequences.append(self.grid_sequence)
            self.corridor_no_goal_hold_sequences = \
                self.corridor_no_goal_hold_sequences[-3:]
        if len(self.corridor_no_goal_hold_sequences) < 2:
            self._event("corridor_no_goal_observation_hold",
                        grid_sequence=self.grid_sequence,
                        hold_cycle=len(self.corridor_no_goal_hold_sequences))
            time.sleep(0.5)
            return
        self.corridor_no_goal_hold_sequences = []
        self.no_candidate_cycles += 1
        self.global_no_candidate_cycles += 1
        self._transition(MissionPhase.RECOVERY, "no_safe_generic_candidate")

    def _record_rejected_candidate_path(
        self,
        path: Sequence[Point],
        mode: str,
        candidate_id,
        reason: str,
        validity=None,
    ) -> None:
        """Persist a proposed-but-never-authorized path for audit/rendering."""
        if not path:
            return
        if validity is None:
            validity = validate_path(
                self.grid, path, spacing=self.p.path_sample_spacing,
                initial_unknown_footprint_grace=
                self.initial_unknown_footprint_grace)
        self.path_history.append({
            "t": round(self.elapsed(), 3),
            "phase": self.phase.value,
            "source": "candidate_filter_" + mode,
            "candidate_id": candidate_id,
            "path": list(path),
            "execution_authorized": False,
            **validity.to_dict(),
            "valid": False,
            "reason": reason,
            "voxel_validation": {
                "safe": False,
                "skipped": "candidate_rejected_before_execution",
            },
        })

    def _execution_safety_check(self, context: dict) -> dict:
        """Fast live-map guard used while one controller goal is active."""
        with self.lock:
            grid = self.grid
            pose = dict(self.pose) if self.pose else None
            grid_sequence = self.grid_sequence
        if grid is None or pose is None:
            return {"safe": False, "reason": "live_safety_map_or_pose_missing"}
        current = (pose["x"], pose["y"])
        probe = segment_safety_probe(
            current, context["segment_start"], context["segment_target"],
            self.execution_safety_lookahead)
        strict_footprint = bool(context.get("strict_footprint", True))
        door = context.get("door")
        if (probe["cross_track_error"] >
                self.execution_max_cross_track_error):
            return {
                "safe": False,
                "reason": "online_path_deviation",
                "grid_sequence": grid_sequence,
                "position": current,
                **probe,
            }
        current_footprint_safe = bool(
            not strict_footprint or grid.footprint_safe(
                current, pose["yaw"], unknown_is_safe=True))
        # At a narrow door the controller initially retains its corridor yaw
        # while beginning a door-normal segment.  The already validated route
        # uses the segment tangent, so rejecting the current-yaw footprint in
        # the first 0.2 s cancels motion before the controller can align.  Only
        # permit the tangent-footprint fallback inside the finite, centred,
        # previously validated door channel.  Cross-track and the live forward
        # sweep below remain authoritative.
        tangent_footprint_fallback = bool(
            strict_footprint and not current_footprint_safe and door is not None
            and context.get("allow_door_tangent_footprint_fallback", False)
            and pose_within_validated_door_channel(current, door))
        if not current_footprint_safe and not tangent_footprint_fallback:
            return {
                "safe": False,
                "reason": "online_current_footprint_unsafe",
                "grid_sequence": grid_sequence,
                "position": current,
                "current_footprint_safe": False,
                **probe,
            }
        sweep = validate_path(
            grid, [current, probe["lookahead"]],
            [door] if door else [],
            spacing=self.p.path_sample_spacing,
            initial_unknown_footprint_grace=
            self.initial_unknown_footprint_grace,
            check_footprint=strict_footprint)
        door_sweep_jitter_override = bool(
            not sweep.valid and door is not None and
            context.get("allow_validated_door_sweep_jitter", False) and
            validated_door_sweep_jitter_eligible(
                current, probe["lookahead"], door, sweep.to_dict(),
                current_footprint_safe,
                self.door_sweep_jitter_max_footprint_collisions))
        sweep_safe = bool(sweep.valid or door_sweep_jitter_override)
        return {
            "safe": sweep_safe,
            "reason": (("safe_validated_door_sweep_jitter"
                        if door_sweep_jitter_override else
                        "safe_door_tangent_footprint_fallback"
                        if tangent_footprint_fallback else "safe")
                       if sweep_safe else
                       "online_forward_sweep_" + sweep.reason),
            "grid_sequence": grid_sequence,
            "position": current,
            "current_footprint_safe": current_footprint_safe,
            "door_tangent_footprint_fallback": tangent_footprint_fallback,
            "door_sweep_jitter_override": door_sweep_jitter_override,
            "sweep": sweep.to_dict(),
            **probe,
        }

    def _publish_goal_and_wait(self, point: Point, yaw: float, source: str,
                               metadata: Optional[dict] = None,
                               safety_context: Optional[dict] = None,
                               require_orientation: bool = False) -> bool:
        message = PoseStamped()
        message.header.frame_id = self.pose_frame
        message.pose.position.x, message.pose.position.y = point
        message.pose.position.z = self.pose["z"]
        message.pose.orientation.z = math.sin(0.5 * yaw)
        message.pose.orientation.w = math.cos(0.5 * yaw)
        with self.lock:
            self.goal_command_sequence += 1
            expected_goal_sequence = self.goal_command_sequence
            # Goal headers are not sensor timestamps.  Use an always-unique
            # wall-clock identity even when Gazebo /use_sim_time is paused.
            identity_nanoseconds = max(
                time.time_ns(), self.last_goal_identity_nanoseconds + 1000)
            self.last_goal_identity_nanoseconds = identity_nanoseconds
            message.header.stamp = rospy.Time(
                identity_nanoseconds // 1000000000,
                identity_nanoseconds % 1000000000)
            message.header.seq = expected_goal_sequence
            expected_goal_stamp = message.header.stamp.to_sec()
            baseline = self.result_sequence
            self.command_active = True
        (self.orientation_goal_pub if require_orientation else
         self.goal_pub).publish(message)
        deadline_limits = [
            self.goal_timeout,
            max(0.0, self.maximum_duration - self.elapsed()),
        ]
        if self.door_candidate_takeover is not None and not self.rooms:
            deadline_limits.append(max(
                0.0,
                float(self.door_candidate_takeover["deadline_t"]) -
                self.elapsed()))
        elif self.first_room_entry_timeout > 0.0 and not self.rooms:
            deadline_limits.append(max(
                0.0, self.first_room_entry_timeout - self.elapsed()))
        deadline = time.monotonic() + min(deadline_limits)
        result = None
        local_abort_reason = None
        inspected_results = set()
        last_motion_topology_wall = 0.0
        last_execution_safety_wall = 0.0
        consecutive_safety_risks = 0
        while not rospy.is_shutdown() and time.monotonic() < deadline:
            now = time.monotonic()
            with self.lock:
                new_results = [dict(item) for item in self.execution_results
                               if int(item.get("sequence", 0)) > baseline]
                pose_age = time.monotonic() - self.pose_stamp
            for candidate in new_results:
                result_sequence = int(candidate.get("sequence", 0))
                if result_sequence in inspected_results:
                    continue
                inspected_results.add(result_sequence)
                if self._goal_result_matches(
                        candidate, expected_goal_sequence,
                        expected_goal_stamp, point,
                        self.require_goal_result_identity):
                    result = candidate
                    break
                self._event(
                    "stale_goal_result_ignored",
                    expected_goal_sequence=expected_goal_sequence,
                    returned_goal_sequence=candidate.get("goal_sequence"),
                    result_sequence=result_sequence)
            if result is not None:
                break
            if pose_age > 0.8:
                result = {"success": False, "reason": "localization_stale"}
                local_abort_reason = "localization_stale"
                break
            if (self.enable_execution_safety_monitor and safety_context and
                    now - last_execution_safety_wall >=
                    self.execution_safety_interval):
                safety = self._execution_safety_check(safety_context)
                last_execution_safety_wall = now
                if safety.get("safe"):
                    consecutive_safety_risks = 0
                else:
                    consecutive_safety_risks += 1
                    if consecutive_safety_risks >= max(
                            1, self.execution_safety_confirmation_cycles):
                        local_abort_reason = str(safety.get(
                            "reason", "online_execution_safety_risk"))
                        result = {"success": False,
                                  "reason": local_abort_reason,
                                  "execution_safety": safety}
                        self._event(
                            "execution_safety_cancelled_goal",
                            source=source,
                            goal_sequence=expected_goal_sequence,
                            consecutive_risk_cycles=consecutive_safety_risks,
                            safety=safety)
                        break
            # Goal execution is synchronous and can last tens of seconds.  Do
            # not leave corridor/door perception asleep for the whole path:
            # consume fresh projection frames while the robot is moving.  The
            # expensive executable-channel promotion remains deferred to the
            # normal planning boundary.
            if now - last_motion_topology_wall >= self.motion_topology_interval:
                self._update_topology(
                    allow_promotion=False, update_source="motion")
                last_motion_topology_wall = now
            time.sleep(0.10)
        if result is None:
            if self._door_candidate_takeover_expired():
                result = {"success": False,
                          "reason": "door_candidate_entry_timeout"}
                local_abort_reason = "door_candidate_entry_timeout"
            elif self._first_room_entry_timeout_reached():
                result = {"success": False,
                          "reason": "first_room_entry_timeout"}
                local_abort_reason = "first_room_entry_timeout"
            else:
                result = {"success": False,
                          "reason": "structured_manager_goal_timeout"}
                local_abort_reason = "structured_manager_goal_timeout"
        if local_abort_reason is not None:
            cancel = self._cancel_goal_and_wait(
                expected_goal_sequence, expected_goal_stamp, point,
                local_abort_reason, baseline)
            result["cancel"] = cancel
            if not cancel["acknowledged"]:
                self._fail_mission("goal_cancel_not_acknowledged")
        with self.lock:
            self.command_active = False
        item = {"index": len(self.goal_history), "t": round(self.elapsed(), 3),
                "phase": self.phase.value, "source": source,
                "goal_sequence": expected_goal_sequence,
                "goal_stamp": expected_goal_stamp,
                "position": [point[0], point[1], self.pose["z"]],
                "required_yaw": yaw if require_orientation else None,
                "require_orientation": bool(require_orientation),
                "success": bool(result.get("success")), "result": result}
        if metadata:
            item["planning_metadata"] = metadata
        self.goal_history.append(item)
        if not item["success"]:
            self.last_path_execution_failure_reason = str(
                result.get("reason", "goal_execution_failed"))
        return item["success"]

    def _compress_path(self, grid: OccupancyMap, path: Sequence[Point],
                       door: Optional[Doorway] = None,
                       strict_footprint: bool = True,
                       maximum_segment_distance: float = 1.0) -> List[Point]:
        if len(path) < 2:
            return []
        output = [path[0]]
        index = 0
        allowed = [door] if door else []
        while index < len(path) - 1:
            chosen = index + 1
            for candidate in range(index + 1, len(path)):
                if distance(path[index], path[candidate]) > maximum_segment_distance:
                    break
                check = validate_path(grid, [path[index], path[candidate]], allowed,
                                      spacing=self.p.path_sample_spacing,
                                      check_footprint=strict_footprint)
                if check.valid:
                    chosen = candidate
            output.append(path[chosen])
            index = chosen
        return output

    def _voxel_validate_path(self, path: Sequence[Point], source: str,
                             required_clearance: float = 0.27) -> dict:
        samples = interpolate_polyline(path, self.p.path_sample_spacing)
        self.voxel_check_sequence += 1
        stem = "check_{:05d}_{}".format(
            self.voxel_check_sequence,
            "".join(character if character.isalnum() else "_" for character in source)[:48],
        )
        path_file = os.path.join(self.voxel_check_dir, stem + ".csv")
        with open(path_file, "w", newline="", encoding="utf-8") as stream:
            writer = csv.writer(stream)
            writer.writerow(["# x", "y", "yaw"])
            for index, point in enumerate(samples):
                if index + 1 < len(samples):
                    yaw = math.atan2(samples[index + 1][1] - point[1],
                                     samples[index + 1][0] - point[0])
                elif index > 0:
                    yaw = math.atan2(point[1] - samples[index - 1][1],
                                     point[0] - samples[index - 1][0])
                else:
                    yaw = 0.0
                writer.writerow([point[0], point[1], yaw])
        command = [
            "rosrun", "simenv_competitor", "octomap_path_validator",
            self.map_file, path_file, "{:.9f}".format(self.pose["z"]),
            "{:.9f}".format(required_clearance),
            "{:.9f}".format(self.p.path_sample_spacing + 1e-4),
            "{:.9f}".format(self.initial_unknown_footprint_grace),
        ]
        try:
            completed = subprocess.run(
                command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                universal_newlines=True, timeout=20.0, check=False)
            lines = [line for line in completed.stdout.splitlines() if line.strip()]
            payload = json.loads(lines[-1]) if lines else {}
            payload["return_code"] = completed.returncode
            payload["path_file"] = os.path.relpath(path_file, self.output_dir)
            payload["safe"] = bool(payload.get("safe")) and completed.returncode == 0
        except (OSError, subprocess.TimeoutExpired, ValueError) as error:
            payload = {"safe": False, "reason": "voxel_validator_error",
                       "error": repr(error),
                       "path_file": os.path.relpath(path_file, self.output_dir)}
        self._atomic_json(os.path.join(self.voxel_check_dir, stem + ".json"), payload)
        return payload

    def _audit_actual_trajectory(self) -> dict:
        """Validate the executed trajectory against the final 2-D and .bt maps."""
        with self.lock:
            grid = self.grid
            points = [(item["x"], item["y"]) for item in self.trajectory]
            doors = [door for door in self.topology.doors if door.confirmed]
        if grid is None or len(points) < 2:
            return {
                "performed": False, "safe": False,
                "reason": "insufficient_final_map_or_trajectory",
                "trajectory_points": len(points),
            }
        two_d = validate_path(
            grid, points, doors, spacing=self.p.path_sample_spacing)
        voxel = (self._voxel_validate_path(points, "final_actual_trajectory")
                 if os.path.isfile(self.map_file)
                 else {"safe": False, "reason": "final_voxel_map_missing"})
        illegal_events = sum(
            not bool(item.get("legal"))
            for item in self.door_traversal_history
            if isinstance(item, dict))
        safe = bool(two_d.valid and voxel.get("safe") and illegal_events == 0)
        return {
            "schema": "simenv_actual_trajectory_validation_v1",
            "performed": True,
            "safe": safe,
            "trajectory_points": len(points),
            "sample_spacing_m": self.p.path_sample_spacing,
            "final_grid_frame": self.grid_frame,
            "two_dimensional_validation": two_d.to_dict(),
            "voxel_validation": voxel,
            "illegal_actual_door_events": illegal_events,
            "reason": "safe" if safe else "final_actual_trajectory_unsafe",
        }

    def _execute_path(self, path: Sequence[Point], source: str,
                      door: Optional[Doorway] = None,
                      required_door: bool = False,
                      metadata: Optional[dict] = None,
                      strict_footprint: bool = True,
                      maximum_segment_distance: float = 1.0,
                      goal_tolerance: Optional[float] = None,
                      require_segment_heading: bool = False,
                      prealign_segment_heading: bool = False) -> bool:
        self.last_path_execution_failure_reason = None
        # A generic 0.30 m stopping radius is appropriate for frontier goals,
        # but can stop the body before a narrow door plane and make the next
        # segment cut diagonally into a frame.  Door entry/exit uses a tighter
        # tolerance so the alignment and plane-crossing waypoints are real.
        tolerance = (
            float(goal_tolerance) if goal_tolerance is not None else
            self.door_crossing_goal_tolerance
            if door is not None and required_door else
            self.generic_goal_tolerance)
        self.goal_tolerance_pub.publish(Float32(data=tolerance))
        time.sleep(0.05)
        with self.lock:
            grid = self.grid
            confirmed_doors = [item for item in self.topology.doors
                               if item.confirmed]
        validation_doors = list(confirmed_doors)
        if door is not None and all(
                item.door_id != door.door_id for item in validation_doors):
            validation_doors.append(door)
        validity = validate_path(grid, path, validation_doors,
                                 door.door_id if door and required_door else None,
                                 self.p.path_sample_spacing,
                                 self.initial_unknown_footprint_grace,
                                 strict_footprint,
                                 forbid_uncommanded_door_crossing=True)
        # Generic FUEL motion follows already-observed free center cells.  At
        # the 0.15 m live OctoMap resolution an isolated quantized return can
        # report 0.225 m clearance and permanently deadlock recovery against
        # the former 0.27 m threshold.  Keep the stricter threshold for every
        # topology manoeuvre (corridor/door/room) and the final audit.
        voxel_clearance = 0.27 if strict_footprint else 0.20
        voxel = (self._voxel_validate_path(
            path, source, required_clearance=voxel_clearance)
                 if validity.valid else {"safe": False, "skipped": "2d_path_invalid"})
        record = {"t": round(self.elapsed(), 3), "phase": self.phase.value,
                  "source": source, "path": list(path), "door_id": door.door_id if door else None,
                  **validity.to_dict(), "voxel_validation": voxel}
        record["valid"] = bool(validity.valid and voxel.get("safe"))
        record["execution_authorized"] = record["valid"]
        if validity.valid and not voxel.get("safe"):
            record["reason"] = "voxel_path_invalid"
        self.path_history.append(record)
        if not record["valid"]:
            self.last_path_execution_failure_reason = str(record["reason"])
            self._event("path_rejected", reason=record["reason"], source=source)
            return False
        waypoints = self._compress_path(
            grid, path, door, strict_footprint=strict_footprint,
            maximum_segment_distance=maximum_segment_distance)
        for _planned_start, target in zip(waypoints[:-1], waypoints[1:]):
            with self.lock:
                current_grid = self.grid
                actual_start = (self.pose["x"], self.pose["y"])
            segment = validate_path(current_grid, [actual_start, target],
                                    validation_doors,
                                    required_door_id=None,
                                    spacing=self.p.path_sample_spacing,
                                    initial_unknown_footprint_grace=
                                    self.initial_unknown_footprint_grace,
                                    check_footprint=strict_footprint,
                                    forbid_uncommanded_door_crossing=True,
                                    authorized_door_id=(
                                        door.door_id
                                        if door and required_door else None))
            segment_voxel = (self._voxel_validate_path(
                [actual_start, target], source + "_online_recheck",
                required_clearance=voxel_clearance)
                if segment.valid else {"safe": False, "skipped": "2d_path_invalid"})
            if not segment.valid or not segment_voxel.get("safe"):
                self.last_path_execution_failure_reason = (
                    segment.reason if not segment.valid else
                    "voxel_path_invalid")
                self.path_history.append({
                    "t": round(self.elapsed(), 3), "phase": self.phase.value,
                    "source": source + "_online_recheck",
                    "path": [actual_start, target],
                    "execution_authorized": False,
                    **segment.to_dict(),
                    "valid": False,
                    "reason": (segment.reason if not segment.valid
                               else "voxel_path_invalid"),
                    "voxel_validation": segment_voxel,
                })
                return False
            yaw = math.atan2(target[1] - actual_start[1],
                             target[0] - actual_start[0])
            if prealign_segment_heading:
                # The RL gait is holonomic, but a large body-frame lateral
                # command can settle without translating when the robot is
                # parked beside a door.  Rotate first so each short staging
                # segment becomes forward motion.  This uses the ordinary
                # orientation controller and does not weaken path safety.
                heading_error = wrap_angle(yaw - float(self.pose["yaw"]))
                if abs(heading_error) > self.door_heading_tolerance:
                    if not self._publish_goal_and_wait(
                            actual_start, yaw, source + "_segment_prealign",
                            metadata={
                                "parent_source": source,
                                "segment_target": list(target),
                                "initial_heading_error": heading_error,
                            },
                            require_orientation=True):
                        self.last_path_execution_failure_reason = \
                            "segment_heading_prealign_failed"
                        return False
                    with self.lock:
                        actual_start = (self.pose["x"], self.pose["y"])
            if not self._publish_goal_and_wait(
                    target, yaw, source, metadata,
                    safety_context={
                        "segment_start": actual_start,
                        "segment_target": target,
                        "door": door,
                        "strict_footprint": strict_footprint,
                        "allow_door_tangent_footprint_fallback": bool(
                            door is not None and required_door),
                        "allow_validated_door_sweep_jitter": bool(
                            door is not None and required_door),
                    },
                    # Door-attention routes may run back along a corridor.
                    # Settling each short waypoint at the route tangent keeps
                    # the omnidirectional RL gait from accumulating a large
                    # sideways/reverse heading error over several segments.
                    require_orientation=require_segment_heading):
                return False
        return True

    def _corridor_step(self) -> None:
        goal = self._select_fuel_goal("corridor")
        if goal:
            self.corridor_end_cycles = 0
            self.no_candidate_cycles = 0
            self.speed_pub.publish(Float32(data=self.corridor_speed))
            if not self._execute_path(goal["path"], goal["source"], metadata={
                    key: goal.get(key) for key in (
                        "candidate_id", "planner_cycle", "local_score",
                        "score_decomposition")}):
                self._transition(MissionPhase.GLOBAL_RECOVERY, "corridor_path_execution_failed")
            return
        end_geometry = bool(
            self.current_corridor and
            self.current_corridor.forward_extent < self.p.corridor_forward_depth_min and
            corridor_end_geometry_evidence(
                self.grid, self.current_corridor,
                (self.pose["x"], self.pose["y"])))
        if end_geometry:
            if self.grid_sequence != self.last_corridor_end_grid_sequence:
                self.last_corridor_end_grid_sequence = self.grid_sequence
                self.corridor_end_cycles += 1
                self._event("corridor_end_evidence", cycles=self.corridor_end_cycles,
                            grid_sequence=self.grid_sequence,
                            evidence="known_occupied_ahead")
        else:
            self.corridor_end_cycles = 0
            self.last_corridor_end_grid_sequence = -1
            self.no_candidate_cycles += 1
            if self.no_candidate_cycles >= 3:
                self._transition(MissionPhase.GLOBAL_RECOVERY,
                                 "forward_depth_exists_but_fuel_goal_missing")
                return
        if self.corridor_end_cycles >= self.p.corridor_end_confirmation_frames:
            self.ending_corridor_id = self.current_corridor.corridor_id
            self.branch_scan_cycles = 0
            self.last_branch_scan_grid_sequence = self.grid_sequence
            self._transition(MissionPhase.CORRIDOR_END_CONFIRM,
                             "no_forward_corridor_goal_confirmed")
        else:
            time.sleep(1.0)

    def _entrance_bootstrap(self) -> bool:
        """Cross the public entrance using only body pose and observed free cells."""
        with self.lock:
            grid = self.grid
            pose = dict(self.pose)
        target, path = select_forward_free_bootstrap(
            grid, (pose["x"], pose["y"]), pose["yaw"],
            minimum_distance=1.0, maximum_distance=4.0,
            spacing=self.p.path_sample_spacing)
        self.bootstrap_attempted = True
        if target is None:
            self._event("pose_relative_bootstrap_unavailable")
            return False
        self._event("pose_relative_bootstrap_selected", target=target,
                    definition="body-forward observed-free; no world/layout coordinate")
        self.speed_pub.publish(Float32(data=min(self.corridor_speed, 0.40)))
        return self._execute_path(path, "pose_relative_entrance_bootstrap")

    def _align_door_heading(self, door: Doorway) -> bool:
        """Rotate at the validated outside station before crossing the frame."""
        current = (self.pose["x"], self.pose["y"])
        initial_yaw = float(self.pose["yaw"])
        desired_yaw = float(door.normal_direction)
        initial_error = wrap_angle(desired_yaw - initial_yaw)
        if abs(initial_error) <= self.door_heading_tolerance:
            self._event(
                "door_heading_alignment_completed", door_id=door.door_id,
                initial_yaw=initial_yaw, final_yaw=initial_yaw,
                desired_yaw=desired_yaw, yaw_error=initial_error,
                already_aligned=True)
            return True

        # Validate the complete in-place footprint sweep, not just its final
        # orientation.  The outside station is deliberately far enough from
        # the frame for this rotation; if the current map disagrees, do not
        # command a potentially clipping turn.
        steps = max(2, int(math.ceil(abs(initial_error) / math.radians(5.0))))
        sweep_yaws = [wrap_angle(initial_yaw + initial_error * index / steps)
                      for index in range(steps + 1)]
        if not all(self.grid.footprint_safe(current, yaw)
                   for yaw in sweep_yaws):
            self._event(
                "door_heading_alignment_rejected", door_id=door.door_id,
                position=current, initial_yaw=initial_yaw,
                desired_yaw=desired_yaw, yaw_error=initial_error,
                reason="rotation_footprint_sweep_collision")
            self.last_path_execution_failure_reason = \
                "rotation_footprint_sweep_collision"
            return False

        self._event(
            "door_heading_alignment_started", door_id=door.door_id,
            position=current, initial_yaw=initial_yaw,
            desired_yaw=desired_yaw, yaw_error=initial_error)
        self.speed_pub.publish(Float32(data=self.door_speed))
        self.door_alignment_attempt_sequence += 1
        self.door_alignment_context_pub.publish(String(data=json.dumps({
            "attempt_id": self.door_alignment_attempt_sequence,
            "door_id": door.door_id,
            "target_yaw": desired_yaw,
            "published_wall_time": time.time(),
        }, sort_keys=True)))
        succeeded = self._publish_goal_and_wait(
            current, desired_yaw, "door_heading_alignment",
            metadata={"door_id": door.door_id,
                      "desired_yaw": desired_yaw,
                      "initial_yaw_error": initial_error},
            require_orientation=True)
        final_yaw = float(self.pose["yaw"])
        final_error = wrap_angle(desired_yaw - final_yaw)
        accepted = bool(
            succeeded and abs(final_error) <= self.door_heading_tolerance)
        self._event(
            "door_heading_alignment_completed" if accepted else
            "door_heading_alignment_failed",
            door_id=door.door_id, initial_yaw=initial_yaw,
            final_yaw=final_yaw, desired_yaw=desired_yaw,
            yaw_error=final_error, already_aligned=False,
            executor_succeeded=succeeded)
        return accepted

    def _authorize_door_staging_route_override(
            self, door: Doorway, outside: Point) -> bool:
        """Accept a safe door channel even if the staging goal timed out.

        The locomotion executor can settle just outside its tight success
        circle and report ``goal_unreachable_no_progress``.  Reissuing that
        same outside point does not improve safety or alignment.  Once the
        *actual* pose and a recentering route through the locked door have
        passed the normal 2-D footprint and 3-D clearance checks, allow the
        door traversal state machine to continue.  This deliberately does not
        relax collision, unknown-space, aperture, or voxel-clearance checks.
        """
        current = (self.pose["x"], self.pose["y"])
        nx, ny = door.normal
        inside = (
            door.center[0] + self.p.door_inside_distance * nx,
            door.center[1] + self.p.door_inside_distance * ny)
        inside = self._committed_goal(door, "cross_door", inside)
        # Recenter continuously while advancing.  Requiring the robot to first
        # return to the exact outside anchor would recreate the same stalled
        # goal that this override is intended to remove.
        route = [current, door.center, inside]
        route_eligible = bool(
            door.channel_validation.get("safe") and
            door.signed_depth(current) <= 0.05)
        validity = (validate_path(
            self.grid, route, [door], door.door_id,
            self.p.path_sample_spacing,
            self.initial_unknown_footprint_grace,
            True,
            forbid_uncommanded_door_crossing=True,
            authorized_door_id=door.door_id)
            if route_eligible else None)
        voxel = (self._voxel_validate_path(
            route, "door_staging_route_override", required_clearance=0.27)
            if validity is not None and validity.valid else
            {"safe": False, "skipped": "2d_path_invalid_or_outside_channel"})
        authorized = bool(
            route_eligible and validity is not None and validity.valid and
            voxel.get("safe"))
        if authorized:
            self.door_staging_route_overrides.add(door.door_id)
        record = {
            "t": round(self.elapsed(), 3),
            "phase": self.phase.value,
            "source": "door_staging_route_override",
            "door_id": door.door_id,
            "path": route,
            "execution_authorized": authorized,
            "valid": authorized,
            "reason": ("safe_locked_door_route" if authorized else
                       "staging_override_safety_rejected"),
            "current_position": current,
            "staging_distance": distance(current, outside),
            "signed_depth": door.signed_depth(current),
            "lateral_offset": abs(door.lateral_offset(current)),
            "locked_channel_safe": bool(
                door.channel_validation.get("safe")),
            "outside_or_at_door_plane": bool(
                door.signed_depth(current) <= 0.05),
            "aperture_projection_precondition_removed": True,
            "two_dimensional_validation": (
                validity.to_dict() if validity is not None else None),
            "voxel_validation": voxel,
        }
        self.path_history.append(record)
        self._event(
            "door_staging_executor_result_overridden" if authorized else
            "door_staging_override_rejected",
            door_id=door.door_id,
            executor_failure_reason=self.last_path_execution_failure_reason,
            staging_distance=record["staging_distance"],
            signed_depth=record["signed_depth"],
            lateral_offset=record["lateral_offset"],
            two_dimensional_safe=bool(
                validity is not None and validity.valid),
            voxel_safe=bool(voxel.get("safe")))
        return authorized

    def _approach_door(self) -> None:
        door = self._door(self.current_door_id)
        if not door:
            self._transition(MissionPhase.SELECT_NEXT_ROOM, "door_disappeared")
            return
        refresh = self._refresh_candidate_door_channel(door, "approach_door")
        if not refresh.get("safe"):
            if self._door_channel_retry_pending(door, "approach_door", refresh):
                return
            if self._handle_candidate_takeover_channel_failure(
                    door, "latest_map_door_channel_unavailable",
                    refresh.get("two_dimensional"), refresh.get("voxel")):
                if self.phase != MissionPhase.FINISHED:
                    door.geometry_locked = False
                    door.traversable = True
                    door.blacklist_until = 0.0
                return
            self._transition(MissionPhase.SELECT_NEXT_ROOM,
                             "latest_map_door_channel_unavailable")
            return
        self.door_channel_failure_cycles.pop(
            "{}:approach_door".format(door.door_id), None)
        nx, ny = door.normal
        outside = (
            door.center[0] - self.p.door_outside_distance * nx,
            door.center[1] - self.p.door_outside_distance * ny)
        outside = self._committed_goal(door, "approach_door", outside)
        current = (self.pose["x"], self.pose["y"])
        # First approach the ordinary outside staging point along short A*
        # segments.  Applying tolerance compensation from the distant
        # observation pose made the previous run demand one large, nearly
        # right-angle diagonal manoeuvre and the locomotion controller reported
        # no progress three times.  Precision compensation belongs only to the
        # final local alignment step below.
        path = astar_free_path(
            self.grid, current, outside,
            clearance_radius=self.corridor_network_clearance)
        already_near_staging = bool(
            not path and
            distance(current, outside) <= self.door_crossing_goal_tolerance)
        if not path and not already_near_staging:
            # A* can collapse nearby poses into one 0.15 m map cell.  Preserve
            # the metric approach command; _execute_path still applies normal
            # 2-D and voxel checks before publishing it.
            path = [current, outside]
        source_corridor = self._corridor(door.corridor_id)
        if source_corridor is not None:
            self.current_corridor = source_corridor
        self.speed_pub.publish(Float32(data=self.door_speed))
        approach_succeeded = already_near_staging or self._execute_path(
            path, "approach_door",
            strict_footprint=False,
            maximum_segment_distance=0.30,
            goal_tolerance=self.door_crossing_goal_tolerance,
            prealign_segment_heading=True)
        safe_route_override = False
        if not approach_succeeded:
            # Do not loop at a confirmed door solely because the executor
            # stopped a few centimetres outside its 0.12 m success circle.
            # The actual pose and the complete recentering/crossing route must
            # still pass all ordinary door safety checks.
            safe_route_override = self._authorize_door_staging_route_override(
                door, outside)
            approach_succeeded = safe_route_override
        if approach_succeeded and not safe_route_override:
            # Goal success means only that the body entered a tolerance circle.
            # Perform a separate short correction so the subsequent segment is
            # parallel to the validated door normal instead of clipping a frame.
            aligned_pose = (self.pose["x"], self.pose["y"])
            precise_anchor = self._committed_goal(
                door, "door_precise_alignment", outside)
            alignment_error = distance(aligned_pose, precise_anchor)
            lateral_error = abs(door.lateral_offset(aligned_pose))
            precise_tolerance = min(0.08, self.door_crossing_goal_tolerance)
            # The complete channel has already passed footprint and voxel
            # validation, and CROSS_DOOR performs another live check.  Do not
            # spend 26 s trying to correct harmless centimetre-scale residuals:
            # the staged-entry run was already only 4.7 cm off the centreline.
            precise_needed = bool(
                alignment_error > 0.10 or lateral_error > 0.06)
            precise_target = precise_anchor
            if precise_needed:
                precise_target = tolerance_compensated_target(
                    aligned_pose, precise_anchor, precise_tolerance)
                self._event(
                    "door_precise_alignment_started",
                    door_id=door.door_id,
                    position=aligned_pose,
                    desired_target=precise_anchor,
                    commanded_target=precise_target,
                    alignment_error=alignment_error,
                    lateral_error=lateral_error)
                approach_succeeded = self._execute_path(
                    [aligned_pose, precise_target],
                    "door_precise_alignment",
                    strict_footprint=False,
                    maximum_segment_distance=0.25,
                    goal_tolerance=precise_tolerance)
            if approach_succeeded:
                final_pose = (self.pose["x"], self.pose["y"])
                final_alignment_error = distance(final_pose, precise_anchor)
                final_lateral_error = abs(door.lateral_offset(final_pose))
                # If the controller reports success on an unexpected side of
                # its tolerance circle, keep the confirmed door local and align
                # again instead of attempting a diagonal crossing.
                approach_succeeded = bool(
                    final_alignment_error <= 0.12 and
                    final_lateral_error <= 0.09)
                self._event(
                    "door_waiting_point_alignment_completed",
                    door_id=door.door_id,
                    desired_target=precise_anchor,
                    commanded_target=precise_target,
                    final_position=final_pose,
                    final_alignment_error=final_alignment_error,
                    final_lateral_error=final_lateral_error,
                    accepted=approach_succeeded)
        if approach_succeeded:
            approach_succeeded = self._align_door_heading(door)
        if approach_succeeded:
            self.door_approach_failure_cycles.pop(door.door_id, None)
            self._transition(MissionPhase.CROSS_DOOR, "door_waiting_point_reached")
        else:
            approach_attempt = self.door_approach_failure_cycles.get(
                door.door_id, 0) + 1
            self.door_approach_failure_cycles[door.door_id] = approach_attempt
            if approach_attempt < self.p.door_entry_max_attempts:
                self._event("door_entry_retry_locked", door_id=door.door_id,
                            attempt=approach_attempt,
                            maximum_attempts=self.p.door_entry_max_attempts,
                            reason="door_approach_unreachable")
                self._transition(MissionPhase.APPROACH_DOOR,
                                 "retry_same_door_approach")
            elif self._door_owned_by_candidate_takeover(door):
                # The candidate-level deadline, not the legacy three-attempt
                # budget, owns this committed entry.  Keep the exact door and
                # retry its staged approach; never resume corridor FUEL.
                self.door_approach_failure_cycles[door.door_id] = 0
                self._event(
                    "door_entry_attempt_budget_overridden",
                    door_id=door.door_id,
                    candidate_id=door.source_room_candidate_id,
                    reason="active_candidate_takeover",
                    deadline_t=self.door_candidate_takeover["deadline_t"])
            else:
                door.blacklist_until = self.elapsed() + min(
                    120.0, 20.0 * approach_attempt)
                self._transition(MissionPhase.SELECT_NEXT_ROOM,
                                 "door_approach_attempts_exhausted")

    def _execute_traversable_portal_probe(self, door: Doorway) -> bool:
        """Cautiously cross a short distance through a frame-incomplete portal."""
        if door.channel_validation.get("entry_policy") != "low_speed_probe":
            return True
        if door.door_id in self.door_probe_completed:
            return True
        current = (self.pose["x"], self.pose["y"])
        nx, ny = door.normal
        probe_depth = 0.45
        probe_target = (door.center[0] + probe_depth * nx,
                        door.center[1] + probe_depth * ny)
        route = [current]
        if door.signed_depth(current) < -0.05:
            route.extend([door.center, probe_target])
        else:
            route.append(probe_target)
        validity = validate_path(
            self.grid, route, [door],
            door.door_id if door.signed_depth(current) < -0.05 else None,
            self.p.path_sample_spacing,
            self.initial_unknown_footprint_grace,
            True,
            forbid_uncommanded_door_crossing=True,
            authorized_door_id=door.door_id)
        voxel = (self._voxel_validate_path(
            route, "traversable_portal_probe", required_clearance=0.27)
                 if validity.valid else
                 {"safe": False, "reason": "two_dimensional_probe_invalid",
                  "skipped": True})
        record = {
            "t": round(self.elapsed(), 3),
            "door_id": door.door_id,
            "candidate_id": door.source_room_candidate_id,
            "entry_policy": "low_speed_probe",
            "start": current,
            "target": probe_target,
            "route": route,
            "two_dimensional": validity.to_dict(),
            "voxel": voxel,
            "authorized": bool(validity.valid and voxel.get("safe")),
            "success": False,
        }
        self.door_probe_history.append(record)
        if not record["authorized"]:
            record["failure_reason"] = (
                validity.reason if not validity.valid else
                str(voxel.get("reason", "voxel_probe_invalid")))
            self._event(
                "traversable_portal_probe_rejected",
                door_id=door.door_id,
                candidate_id=door.source_room_candidate_id,
                reason=record["failure_reason"])
            return False
        self._event(
            "traversable_portal_probe_started",
            door_id=door.door_id,
            candidate_id=door.source_room_candidate_id,
            target=probe_target,
            required_clearance_m=0.27)
        self.speed_pub.publish(Float32(data=min(self.door_speed, 0.20)))
        executed = self._execute_path(
            route, "traversable_portal_probe", door, required_door=True,
            strict_footprint=True, maximum_segment_distance=0.25,
            goal_tolerance=self.door_crossing_goal_tolerance)
        final = (self.pose["x"], self.pose["y"])
        final_depth = door.signed_depth(final)
        final_lateral = abs(door.lateral_offset(final))
        accepted = bool(
            executed and final_depth >= 0.25 and
            final_lateral <= max(0.0, 0.5 * door.width - 0.08))
        record.update({
            "executed": bool(executed),
            "final_position": final,
            "final_inside_depth": final_depth,
            "final_lateral_offset": final_lateral,
            "success": accepted,
            "failure_reason": (None if accepted else
                               "probe_pose_not_safely_inside"),
        })
        self._event(
            "traversable_portal_probe_completed" if accepted else
            "traversable_portal_probe_failed",
            door_id=door.door_id,
            candidate_id=door.source_room_candidate_id,
            final_inside_depth=final_depth,
            final_lateral_offset=final_lateral,
            success=accepted)
        if accepted:
            self.door_probe_completed.add(door.door_id)
        return accepted

    def _retreat_failed_portal_probe(self, door: Doorway) -> bool:
        """Return to the committed outside point after a partial probe."""
        current = (self.pose["x"], self.pose["y"])
        if door.signed_depth(current) <= 0.05:
            return True
        outside = tuple(door.corridor_side)
        route = [current, door.center, outside]
        self.speed_pub.publish(Float32(data=min(self.door_speed, 0.20)))
        retreated = self._execute_path(
            route, "traversable_portal_probe_retreat", door,
            required_door=True, strict_footprint=True,
            maximum_segment_distance=0.25,
            goal_tolerance=self.door_crossing_goal_tolerance)
        self._event(
            "traversable_portal_probe_retreat_completed" if retreated else
            "traversable_portal_probe_retreat_failed",
            door_id=door.door_id,
            final_position=(self.pose["x"], self.pose["y"]))
        return retreated

    def _cross_door(self) -> None:
        door = self._door(self.current_door_id)
        if not door:
            self._transition(MissionPhase.SELECT_NEXT_ROOM, "door_disappeared")
            return
        refresh = self._refresh_candidate_door_channel(door, "cross_door")
        if not refresh.get("safe"):
            if self._door_channel_retry_pending(door, "cross_door", refresh):
                return
            if self._handle_candidate_takeover_channel_failure(
                    door, "latest_map_door_channel_unavailable",
                    refresh.get("two_dimensional"), refresh.get("voxel")):
                if self.phase != MissionPhase.FINISHED:
                    door.geometry_locked = False
                    door.traversable = True
                    door.blacklist_until = 0.0
                    self._transition(
                        MissionPhase.APPROACH_DOOR,
                        "retry_candidate_door_after_channel_refresh")
                return
            self._transition(MissionPhase.SELECT_NEXT_ROOM,
                             "latest_map_door_channel_unavailable")
            return
        self.door_channel_failure_cycles.pop(
            "{}:cross_door".format(door.door_id), None)
        if refresh.get("geometry_changed"):
            # The robot is waiting at the old outside point.  Re-approach the
            # newly fitted entrance instead of cutting diagonally across its
            # frames from a stale pose.
            self._transition(MissionPhase.APPROACH_DOOR,
                             "door_geometry_refitted_reapproach_required")
            return
        heading_error = wrap_angle(
            door.normal_direction - float(self.pose["yaw"]))
        if abs(heading_error) > self.door_heading_tolerance:
            self._allow_door_geometry_refresh(door)
            self._event(
                "door_crossing_heading_guard_rejected",
                door_id=door.door_id, current_yaw=self.pose["yaw"],
                desired_yaw=door.normal_direction,
                yaw_error=heading_error,
                tolerance=self.door_heading_tolerance)
            self._transition(
                MissionPhase.APPROACH_DOOR,
                "door_heading_alignment_required_before_crossing")
            return
        # The latest complete 2-D + OctoMap channel is now the authority for
        # this one crossing attempt.  Motion-time corridor observations must
        # not move the portal while the body is between its frames.  A failed
        # attempt before the plane unlocks it for a fresh-map refit below.
        door.geometry_locked = True
        traversal_baseline = len(self.door_traversal_history)
        trajectory_baseline = max(0, len(self.trajectory) - 1)
        probe_policy = bool(
            door.channel_validation.get("entry_policy") == "low_speed_probe")
        if probe_policy and not self._execute_traversable_portal_probe(door):
            self._retreat_failed_portal_probe(door)
            probe_record = (self.door_probe_history[-1]
                            if self.door_probe_history else {})
            if self._handle_candidate_takeover_channel_failure(
                    door, "traversable_portal_probe_failed",
                    probe_record.get("two_dimensional"),
                    probe_record.get("voxel")):
                if self.phase != MissionPhase.FINISHED:
                    door.geometry_locked = False
                    door.traversable = True
                    door.blacklist_until = 0.0
                    self._transition(
                        MissionPhase.APPROACH_DOOR,
                        "retry_candidate_door_after_probe_failure")
                return
            door.traversable = False
            door.blacklist_until = self.elapsed() + 30.0
            candidate = self._candidate_for_door(door)
            if candidate is not None:
                invalidation = dict(candidate.channel_validation)
                invalidation.update({
                    "safe": False,
                    "stage": "traversable_portal_probe_failed",
                    "grid_sequence": int(self.grid_sequence),
                })
                candidate.channel_validation = invalidation
                door.channel_validation = dict(invalidation)
            self._unlock_door_commit("traversable_portal_probe_failed")
            self.current_door_id = None
            self._transition(MissionPhase.SELECT_NEXT_ROOM,
                             "traversable_portal_probe_failed")
            return
        nx, ny = door.normal
        inside = (
            door.center[0] + self.p.door_inside_distance * nx,
            door.center[1] + self.p.door_inside_distance * ny)
        inside = self._committed_goal(door, "cross_door", inside)
        current = (self.pose["x"], self.pose["y"])
        if probe_policy:
            route = [current, inside]
            validity = validate_path(
                self.grid, route, [door], spacing=self.p.path_sample_spacing,
                check_footprint=True,
                forbid_uncommanded_door_crossing=True,
                authorized_door_id=door.door_id)
        elif (door.door_id in self.door_staging_route_overrides or
              (door.signed_depth(current) <= 0.05 and
               pose_within_validated_door_channel(current, door))):
            # APPROACH_DOOR has already established that the body is in the
            # finite locked-door channel.  Go through the measured centre and
            # into the room; do not command the outside waiting point again.
            route = [current, door.center, inside]
            validity = validate_path(
                self.grid, route, [door], door.door_id,
                self.p.path_sample_spacing,
                self.initial_unknown_footprint_grace,
                True,
                forbid_uncommanded_door_crossing=True,
                authorized_door_id=door.door_id)
            self._event(
                "door_crossing_direct_from_validated_channel",
                door_id=door.door_id,
                start=current,
                center=door.center,
                inside=inside,
                staging_anchor_skipped=True,
                two_dimensional_safe=validity.valid)
        else:
            route, validity = plan_door_route(
                self.grid, current, inside, door, entering=True,
                sample_spacing=self.p.path_sample_spacing,
                outside_distance=self.p.door_outside_distance,
                inside_distance=self.p.door_inside_distance)
        # When already at the outside wait point, the generic route ends at
        # the same inside point and still proves the required door crossing.
        if not validity.valid:
            self._allow_door_geometry_refresh(door)
            validity_record = validity.to_dict()
            self.path_history.append({"t": round(self.elapsed(), 3),
                                      "source": "cross_door", "path": route,
                                      "execution_authorized": False,
                                      **validity_record})
            if self._handle_candidate_takeover_channel_failure(
                    door, "cross_door_planned_route_invalid",
                    validity_record, None):
                if self.phase != MissionPhase.FINISHED:
                    door.geometry_locked = False
                    door.traversable = True
                    door.blacklist_until = 0.0
                    self._transition(
                        MissionPhase.APPROACH_DOOR,
                        "retry_candidate_door_after_route_refresh")
                return
            candidate = self._candidate_for_door(door)
            if candidate is not None:
                door.traversable = False
                invalidation = dict(door.channel_validation)
                invalidation.update({
                    "safe": False,
                    "stage": "cross_door_planned_route",
                    "grid_sequence": int(self.grid_sequence),
                    "planned_route_validation": validity.to_dict(),
                })
                door.channel_validation = invalidation
                candidate.channel_validation = dict(invalidation)
                self._event("candidate_door_route_invalidated",
                            door_id=door.door_id,
                            candidate_id=candidate.candidate_id,
                            reason=validity.reason,
                            grid_sequence=self.grid_sequence)
                self._transition(MissionPhase.SELECT_NEXT_ROOM,
                                 "candidate_door_requires_new_map_refit")
                return
            door.attempt_count += 1
            if door.attempt_count < self.p.door_entry_max_attempts:
                self._event("door_entry_retry_locked", door_id=door.door_id,
                            attempt=door.attempt_count,
                            maximum_attempts=self.p.door_entry_max_attempts,
                            reason="door_crossing_path_invalid")
                self._transition(MissionPhase.APPROACH_DOOR,
                                 "retry_same_door_after_path_refresh")
            else:
                door.blacklist_until = self.elapsed() + min(
                    120.0, 20.0 * door.attempt_count)
                self._transition(MissionPhase.SELECT_NEXT_ROOM,
                                 "door_crossing_path_attempts_exhausted")
            return
        self.speed_pub.publish(Float32(data=self.door_speed))
        if not self._execute_path(
                route, "cross_door", door,
                required_door=not probe_policy,
                strict_footprint=True,
                maximum_segment_distance=(0.40 if probe_policy else 1.0),
                goal_tolerance=self.door_crossing_goal_tolerance):
            door.attempt_count += 1
            if door.signed_depth((self.pose["x"], self.pose["y"])) > 0.05:
                if door.attempt_count >= self.p.door_entry_max_attempts:
                    door.blacklist_until = self.elapsed() + min(
                        120.0, 20.0 * door.attempt_count)
                self._transition(MissionPhase.EXIT_ROOM,
                                 "door_crossing_failed_after_plane")
            else:
                self._allow_door_geometry_refresh(door)
                if self._door_owned_by_candidate_takeover(door):
                    # Motion no-progress is not geometric evidence that the
                    # door is blocked.  The candidate takeover deadline owns
                    # the retry budget and FUEL stays suspended.
                    door.attempt_count = 0
                    door.geometry_locked = False
                    door.traversable = True
                    door.blacklist_until = 0.0
                    self._event(
                        "door_crossing_attempt_budget_overridden",
                        door_id=door.door_id,
                        candidate_id=door.source_room_candidate_id,
                        reason=(self.last_path_execution_failure_reason or
                                "door_crossing_failed_before_plane"),
                        deadline_t=self.door_candidate_takeover["deadline_t"])
                    self._transition(
                        MissionPhase.APPROACH_DOOR,
                        "retry_candidate_door_after_execution_failure")
                elif door.attempt_count < self.p.door_entry_max_attempts:
                    self._event("door_entry_retry_locked", door_id=door.door_id,
                                attempt=door.attempt_count,
                                maximum_attempts=self.p.door_entry_max_attempts,
                                reason="door_crossing_failed_before_plane")
                    self._transition(MissionPhase.APPROACH_DOOR,
                                     "retry_same_door_after_execution_failure")
                else:
                    door.blacklist_until = self.elapsed() + min(
                        120.0, 20.0 * door.attempt_count)
                    self._transition(MissionPhase.SELECT_NEXT_ROOM,
                                     "door_crossing_attempts_exhausted")
            return
        actual_enter = any(
            item.get("door_id") == door.door_id and item.get("legal") and
            item.get("direction") == "enter"
            for item in self.door_traversal_history[traversal_baseline:])
        entry_evidence = door_entry_evidence(
            door, self.trajectory[trajectory_baseline:],
            inside_depth_min=self.p.inside_depth_min,
            minimum_inside_samples=self.p.door_inside_confirmation_samples)
        self._event("door_entry_evidence", door_id=door.door_id,
                    evidence=entry_evidence)
        if not actual_enter or not entry_evidence["confirmed"]:
            door.attempt_count += 1
            if door.attempt_count >= self.p.door_entry_max_attempts:
                door.blacklist_until = self.elapsed() + min(
                    120.0, 20.0 * door.attempt_count)
            self._transition(MissionPhase.EXIT_ROOM,
                             ("planned_crossing_lacks_actual_door_event"
                              if not actual_enter else
                              "door_entry_trajectory_not_confirmed"))
            return
        door.attempt_count = 0
        # This exact validated plane is now the only legal return portal.
        # Future wall/room observations may grow the room, but cannot move its
        # remembered entrance while the robot is inside.
        self._activate_entered_room(
            door, "door_crossed_and_room_expansion_confirmed")

    def _room_step(self) -> None:
        room = self.rooms[self.current_room_id]
        door = self._door(self.current_door_id)
        self._refresh_room_geometry(
            room, door, (self.pose["x"], self.pose["y"]))
        if room_lidar_envelope_complete(room):
            room.state = RoomState.COMPLETED
            room.unreachable_confirmed = False
            room.unreachable_reason = None
            self.pending_room_macro = None
            self._event(
                "lidar_room_envelope_complete",
                room_id=room.region_id,
                room_goal_count=room.local_goal_count,
                primary_goal_count=room.primary_goal_count,
                breadth_goal_count=room.breadth_goal_count,
                far_wall_seen=room.far_wall_seen,
                left_wall_seen=room.left_wall_seen,
                right_wall_seen=room.right_wall_seen)
            self._transition(
                MissionPhase.EXIT_ROOM,
                "primary_depth_and_room_wall_envelope_observed")
            return
        current = (self.pose["x"], self.pose["y"])
        goal = None
        # Establish room scale before asking local frontiers for refinements.
        # The first full path goes into the room depth; the following two fan
        # out laterally.  Keeping the full macro path prevents every rolling
        # FUEL waypoint from becoming a new high-level room target.
        attempts = self.room_macro_attempts.setdefault(room.region_id, 0)
        role = (None if attempts >= max(1, self.room_maximum_macro_goals) else
                "primary" if room.primary_goal_count == 0 else
                "breadth" if room.breadth_goal_count < 2 else None)
        failed_targets = self.room_macro_failed_targets.setdefault(
            room.region_id, [])
        coverage = None
        if role is not None and self.pending_room_macro is not None:
            pending = self.pending_room_macro
            if pending.get("room_id") == room.region_id and pending.get("role") == role:
                target = tuple(pending["position"])
                seed = (door.center[0] +
                        max(1.2, room.maximum_inside_depth) * door.normal[0],
                        door.center[1] +
                        max(1.2, room.maximum_inside_depth) * door.normal[1])
                room_cells = set(room_free_region(self.grid, door, seed))
                path = astar_free_path(
                    self.grid, current, target, clearance_radius=0.30,
                    allowed_side=(door, 1, 0.08), allow_unknown_at_start=True)
                validity = validate_path(
                    self.grid, path, spacing=self.p.path_sample_spacing,
                    initial_unknown_footprint_grace=
                    self.initial_unknown_footprint_grace)
                if (path and validity.valid and
                        all(self.grid.world_to_cell(point) in room_cells
                            for point in path[1:])):
                    coverage = dict(pending)
                    coverage["path"] = path
                    coverage["path_distance"] = sum(
                        distance(a, b) for a, b in zip(path[:-1], path[1:]))
                else:
                    failed_targets.append(target)
                    self._event("room_macro_replan_rejected", role=role,
                                target=target, reason=validity.reason)
                    self.pending_room_macro = None
        if role is not None and coverage is None:
            coverage = select_room_coverage_viewpoint(
                room, self.grid, door, current, role,
                minimum_baseline=self.p.room_goal_baseline_min,
                rejected_targets=failed_targets)
            if coverage is not None:
                self.pending_room_macro = {
                    key: value for key, value in coverage.items() if key != "path"
                }
                self.pending_room_macro.update({
                    "room_id": room.region_id, "attempts": 0,
                })
        if role is None and coverage is None and attempts >= max(
                1, self.room_maximum_macro_goals):
            # A room may have residual projection noise even after its bounded
            # LiDAR programme.  Never fall back to ordinary frontiers or wait
            # indefinitely inside it: return through the remembered entrance
            # and continue with the next queued room.
            room.unreachable_confirmed = True
            room.unreachable_reason = "bounded_room_macro_budget_exhausted"
            room.state = RoomState.TEMPORARILY_UNREACHABLE
            self.pending_room_macro = None
            self._event(
                "room_macro_budget_exhausted_exit",
                room_id=room.region_id,
                macro_goal_attempts=attempts,
                successful_room_goals=room.local_goal_count,
                primary_goal_count=room.primary_goal_count,
                breadth_goal_count=room.breadth_goal_count,
                far_wall_seen=room.far_wall_seen,
                left_wall_seen=room.left_wall_seen,
                right_wall_seen=room.right_wall_seen)
            self._transition(MissionPhase.EXIT_ROOM,
                             "bounded_room_macro_budget_exhausted")
            return
        if coverage is not None:
            target = coverage["position"]
            candidate = self._candidate_for_door(door)
            yaw = (math.atan2(candidate.centroid[1] - target[1],
                              candidate.centroid[0] - target[0])
                   if candidate is not None else door.normal_direction)
            metrics = {
                key: value for key, value in coverage.items()
                if key not in ("position", "path")
            }
            goal = {
                "position": target,
                "yaw": yaw,
                "path": coverage["path"],
                "source": ("room_depth_primary" if role == "primary" else
                           "room_breadth_expand"),
                "candidate_id": None,
                "planner_cycle": None,
                "local_score": None,
                "score_decomposition": metrics,
                "room_macro_role": role,
            }
        # Room LiDAR exploration is intentionally a bounded macro programme:
        # one depth target followed by at most two breadth targets.  Ordinary
        # room FUEL/recovery goals would turn already observed free space into
        # extra motion targets and recreate the local wandering seen in the
        # previous run.
        if goal:
            room.no_goal_cycles = 0
            room.no_goal_map_sequences = []
            self.speed_pub.publish(Float32(data=self.room_speed))
            if goal.get("room_macro_role"):
                self.room_macro_attempts[room.region_id] = attempts + 1
                self._event(
                    "room_macro_goal_started",
                    room_id=room.region_id,
                    role=goal["room_macro_role"],
                    target=goal["position"],
                    macro_goal_index=self.room_macro_attempts[room.region_id],
                    maximum_macro_goals=self.room_maximum_macro_goals)
            success = self._execute_path(goal["path"], goal["source"], door,
                                         metadata={key: goal.get(key) for key in (
                                             "candidate_id", "planner_cycle", "local_score",
                                             "score_decomposition")},
                                         maximum_segment_distance=(
                                             0.65 if goal.get("room_macro_role") else 1.0))
            if success:
                target = goal["position"]
                room.successful_goals.append(target)
                room.local_goal_count += 1
                if goal.get("room_macro_role") == "primary":
                    room.primary_goal_count += 1
                    self.pending_room_macro = None
                elif goal.get("room_macro_role") == "breadth":
                    room.breadth_goal_count += 1
                    room.breadth_goals.append(target)
                    self.pending_room_macro = None
                    if room.breadth_goal_count >= 2:
                        self._refresh_room_geometry(
                            room, door, (self.pose["x"], self.pose["y"]))
                        room.state = RoomState.COMPLETED
                        room.unreachable_confirmed = False
                        room.unreachable_reason = None
                        self._event(
                            "bilateral_room_scan_complete",
                            room_id=room.region_id,
                            far_wall_seen=room.far_wall_seen,
                            left_wall_seen=room.left_wall_seen,
                            right_wall_seen=room.right_wall_seen,
                            breadth_goals=room.breadth_goals)
                        self._transition(
                            MissionPhase.EXIT_ROOM,
                            "primary_and_bilateral_breadth_complete")
            else:
                room.no_goal_cycles += 1
                safety_abort = str(
                    self.last_path_execution_failure_reason or "").startswith(
                        ("online_current_footprint_unsafe",
                         "online_forward_sweep_",
                         "online_path_deviation"))
                if (safety_abort and goal.get("room_macro_role") and
                        self.pending_room_macro is not None):
                    failed_targets.append(tuple(goal["position"]))
                    self.pending_room_macro = None
                    self._event(
                        "room_macro_abandoned_for_execution_safety",
                        role=goal["room_macro_role"],
                        target=goal["position"],
                        reason=self.last_path_execution_failure_reason)
                elif goal.get("room_macro_role") and self.pending_room_macro is not None:
                    self.pending_room_macro["attempts"] = int(
                        self.pending_room_macro.get("attempts", 0)) + 1
                    self._event(
                        "room_macro_execution_retry",
                        role=goal["room_macro_role"],
                        target=goal["position"],
                        attempt=self.pending_room_macro["attempts"])
                    if self.pending_room_macro["attempts"] >= 2:
                        failed_targets.append(tuple(goal["position"]))
                        self.pending_room_macro = None
            return
        # Count only fresh map cycles. Re-running the planner against one
        # unchanged grid must not manufacture the three-cycle stability
        # evidence required by the room completion rule.
        if (not room.no_goal_map_sequences or
                room.no_goal_map_sequences[-1] != self.grid_sequence):
            room.no_goal_map_sequences.append(self.grid_sequence)
            room.no_goal_map_sequences = room.no_goal_map_sequences[-3:]
            room.no_goal_cycles = len(room.no_goal_map_sequences)
        else:
            time.sleep(0.5)
            return
        if room_complete(room):
            room.state = RoomState.COMPLETED
            room.unreachable_confirmed = False
            room.unreachable_reason = None
            self._transition(MissionPhase.EXIT_ROOM, "room_completion_evidence_satisfied")
        elif room.no_goal_cycles >= 3:
            room.unreachable_attempt_count += 1
            room.unreachable_confirmed = room.unreachable_attempt_count >= 3
            room.unreachable_reason = (
                "three_independent_room_visits_without_safe_local_viewpoint"
                if room.unreachable_confirmed else
                "room_revisit_required_after_no_safe_local_viewpoint")
            door.blacklist_until = self.elapsed() + min(
                120.0, 20.0 * room.unreachable_attempt_count)
            room.state = RoomState.TEMPORARILY_UNREACHABLE
            self._transition(MissionPhase.EXIT_ROOM, "room_local_goals_exhausted")
        else:
            time.sleep(1.0)

    def _exit_room(self) -> None:
        door = self._door(self.current_door_id)
        if not door:
            self._fail_mission("lost_entry_door_inside_room")
            return
        target = door.corridor_side
        route, validity = plan_door_route(
            self.grid, (self.pose["x"], self.pose["y"]), target, door, entering=False,
            sample_spacing=self.p.path_sample_spacing,
            outside_distance=self.p.door_outside_distance,
            inside_distance=self.p.door_inside_distance,
            clearance_radius=0.30)
        room = self.rooms.get(self.current_room_id)
        if room:
            seed = (door.center[0] + max(1.2, room.maximum_inside_depth) * door.normal[0],
                    door.center[1] + max(1.2, room.maximum_inside_depth) * door.normal[1])
            region = set(room_free_region(self.grid, door, seed))
            if any(door.signed_depth(point) > 0.05 and
                   self.grid.world_to_cell(point) not in region for point in route):
                validity.valid = False
                validity.reason = "exit_path_leaves_current_room_region"
        if not validity.valid:
            self.path_history.append({
                "t": round(self.elapsed(), 3), "phase": self.phase.value,
                "source": "exit_room", "path": route, "door_id": door.door_id,
                "execution_authorized": False,
                **validity.to_dict(),
                "voxel_validation": {"safe": False, "skipped": "2d_path_invalid"},
            })
            self.room_exit_failures += 1
            if self.room_exit_failures >= 3:
                self._fail_mission("room_exit_path_failed")
            else:
                time.sleep(1.0)
            return
        traversal_baseline = len(self.door_traversal_history)
        if not self._execute_path(
                route, "exit_room", door, required_door=True,
                maximum_segment_distance=0.65):
            self.room_exit_failures += 1
            if self.room_exit_failures >= 3:
                self._fail_mission("room_exit_path_failed")
            else:
                time.sleep(1.0)
            return
        actual_exit = any(
            item.get("door_id") == door.door_id and item.get("legal") and
            item.get("direction") == "exit"
            for item in self.door_traversal_history[traversal_baseline:])
        if not actual_exit:
            self._fail_mission("planned_exit_lacks_actual_door_event")
            return
        self.room_exit_failures = 0
        if room and self._room_resolved(room):
            door.visited = True
        self._transition(MissionPhase.RETURN_TO_CORRIDOR, "room_exit_door_crossed")

    def _return_corridor(self) -> None:
        door = self._door(self.current_door_id)
        target = door.corridor_side
        source_corridor = self._corridor(door.corridor_id)
        if source_corridor:
            self.current_corridor = source_corridor
            axis = unit(source_corridor.principal_direction)
            origin = source_corridor.centerline[0]
            station = ((target[0] - origin[0]) * axis[0] +
                       (target[1] - origin[1]) * axis[1])
            target = (origin[0] + station * axis[0], origin[1] + station * axis[1])
        path = astar_free_path(
            self.grid, (self.pose["x"], self.pose["y"]), target,
            clearance_radius=self.corridor_network_clearance)
        if not self._path_stays_in_corridor_union(path):
            path = []
        if self._execute_path(path, "return_to_corridor"):
            self.return_corridor_failures = 0
            attention = self.opposite_door_attentions.get(door.door_id)
            if attention is not None and door.visited:
                attention["status"] = "pending"
                attention["room_exit_t"] = round(self.elapsed(), 3)
                self._event(
                    "opposite_door_attention_activated",
                    source_door_id=door.door_id,
                    expected_center=attention["expected_center"],
                    observation_target=attention["observation_target"])
            self._unlock_door_commit(
                "door_traversal_completed_return_to_corridor")
            self.current_room_id = None
            self.current_door_id = None
            self._transition(MissionPhase.SELECT_NEXT_ROOM, "corridor_centerline_rejoined")
        else:
            self.return_corridor_failures += 1
            if self.return_corridor_failures >= 3:
                self._fail_mission("return_to_corridor_failed")
            else:
                time.sleep(1.0)

    def _global_recovery(self) -> None:
        corridor_incomplete = bool(
            self.current_corridor and self.current_corridor.confirmed and
            self.current_corridor.corridor_id not in self.completed_corridors)
        queue = self._build_reachable_room_queue()
        self.room_queue = queue
        if (corridor_incomplete and self.current_corridor and
                not self._point_in_corridor_region(
                    (self.pose["x"], self.pose["y"]), self.current_corridor)):
            current = (self.pose["x"], self.pose["y"])
            target = self._nearest_corridor_point(current, self.current_corridor)
            transfer = astar_free_path(
                self.grid, current, target,
                clearance_radius=self.corridor_network_clearance)
            if self._path_reenters_corridor_union(transfer):
                self.speed_pub.publish(Float32(data=self.corridor_speed))
                if self._execute_path(transfer, "corridor_branch_transfer"):
                    self._transition(MissionPhase.CORRIDOR_DISCOVERY,
                                     "corridor_branch_centerline_reached")
                    return
        if queue and not corridor_incomplete:
            self._transition(MissionPhase.SELECT_NEXT_ROOM, "unvisited_door_available")
            return
        # A recovery candidate is always drawn from the unrestricted generic
        # pool.  Corridor evidence may improve its score but cannot constrain
        # its region or make recovery loop waiting for recognition.
        goal = self._select_fuel_goal("generic_recovery")
        if goal:
            self.speed_pub.publish(Float32(data=self.corridor_speed))
            if self._execute_path(goal["path"], goal["source"], metadata={
                    key: goal.get(key) for key in (
                        "candidate_id", "planner_cycle", "local_score",
                        "score_decomposition")}, strict_footprint=False):
                self.no_candidate_cycles = 0
                self.global_no_candidate_cycles = 0
                self.recovery_failed_targets = []
                self._transition(MissionPhase.EXPLORE_GENERIC,
                                 "recovery_goal_reached_resume_generic")
                return
            failed_target = tuple((goal.get("path") or [goal["position"]])[-1])
            self.recovery_failed_targets.append(failed_target)
            self.recovery_failed_targets = self.recovery_failed_targets[-12:]
            self.no_candidate_cycles += 1
            self.global_no_candidate_cycles += 1
            self._event(
                "recovery_goal_blacklisted",
                target=failed_target,
                failure_cycles=self.no_candidate_cycles,
                reason=self.last_path_execution_failure_reason)
        else:
            self.no_candidate_cycles += 1
            self.global_no_candidate_cycles += 1
        # A stale/inaccurate corridor polygon must not leave the robot idle
        # for the remainder of the mission.  After a few strict re-entry
        # cycles, use the ordinary observed-free FUEL/A* pool once.  The
        # resulting path still passes 2-D, 3-D and uncommanded-door checks in
        # _execute_path; only the inferred corridor-union restriction is
        # relaxed.
        if self.no_candidate_cycles >= self.recovery_corridor_constraint_cycles:
            relaxed = self._select_fuel_goal("generic_recovery_relaxed")
            if relaxed:
                self._event(
                    "recovery_corridor_constraint_relaxed",
                    strict_cycles=self.no_candidate_cycles,
                    candidate_id=relaxed.get("candidate_id"))
                self.speed_pub.publish(Float32(data=self.corridor_speed))
                if self._execute_path(
                        relaxed["path"], relaxed["source"], metadata={
                            key: relaxed.get(key) for key in (
                                "candidate_id", "planner_cycle", "local_score",
                                "score_decomposition")}, strict_footprint=False):
                    self.no_candidate_cycles = 0
                    self.global_no_candidate_cycles = 0
                    self._transition(
                        MissionPhase.EXPLORE_GENERIC,
                        "relaxed_recovery_goal_reached_resume_generic")
                else:
                    failed_target = tuple(
                        (relaxed.get("path") or [relaxed["position"]])[-1])
                    self.recovery_failed_targets.append(failed_target)
                    self.recovery_failed_targets = self.recovery_failed_targets[-12:]
                    self.no_candidate_cycles += 1
                    self.global_no_candidate_cycles += 1
                    self._event(
                        "recovery_goal_blacklisted",
                        target=failed_target,
                        failure_cycles=self.no_candidate_cycles,
                        reason=self.last_path_execution_failure_reason)
                return
        rooms_resolved = all(self._room_resolved(room)
                             for room in self.rooms.values())
        unresolved_confirmed_doors = any(
            door.confirmed and not door.visited for door in self.topology.doors)
        complete, reason = completion_decision(CompletionEvidence(
            all_corridor_branches_complete=(
                bool(self.completed_corridors) and all(
                    (not corridor.confirmed or
                     corridor.corridor_id in self.completed_corridors)
                    for corridor in self.topology.corridors)),
            door_queue_empty=(not queue and not unresolved_confirmed_doors),
            rooms_resolved=rooms_resolved,
            large_reachable_unknown=self.large_reachable_unknown,
            no_candidate_cycles=self.global_no_candidate_cycles,
            visited_stagnant_seconds=time.monotonic() - self.last_visited_growth,
            elapsed_seconds=self.elapsed(),
        ))
        if complete:
            self.exploration_complete = True
            self.termination_reason = reason
            self._transition(MissionPhase.FINISHED, reason)
        else:
            time.sleep(2.0)

    def _dispatch(self) -> None:
        if self.phase in (MissionPhase.EXPLORE_GENERIC,
                          MissionPhase.EXPLORE_CORRIDOR_AWARE):
            self._adaptive_exploration_step()
        elif self.phase == MissionPhase.EXPLORE_ROOM_LOCAL:
            self._room_step()
        elif self.phase == MissionPhase.RECOVERY:
            if self._adopt_embodied_room_candidate_entry():
                return
            if self._run_door_candidate_entry_takeover():
                return
            # A stable room-scale expansion beside the robot is more useful
            # than another generic recovery frontier.  Acquire independent
            # 360-degree LiDAR maps at its portal station and run the strict
            # local framed-channel/voxel validator before any door motion.
            attention = self._door_attention_goal()
            if attention is not None:
                self._execute_door_attention_goal(attention)
                return
            # First undo the condition that triggered the safety stop.  A
            # short recenter/centreline step is independent of frontier
            # prefixes and cannot be filtered into an endless zero-command
            # loop merely because the long-range FUEL path leaves the current
            # corridor model.
            escape = self._corridor_recovery_escape_goal()
            if escape:
                self.speed_pub.publish(Float32(data=self.corridor_speed))
                self.recovery_escape_attempts += 1
                self._event(
                    "corridor_recovery_escape_started",
                    source=escape["source"], target=escape["position"],
                    corridor_id=escape["corridor_id"],
                    attempt=self.recovery_escape_attempts)
                if self._execute_path(
                        escape["path"], escape["source"],
                        metadata={"corridor_id": escape["corridor_id"],
                                  "recovery_escape": True},
                        strict_footprint=False,
                        maximum_segment_distance=0.50,
                        goal_tolerance=0.15):
                    self.no_candidate_cycles = 0
                    self.global_no_candidate_cycles = 0
                    self.recovery_escape_attempts = 0
                    self.recovery_escape_failed_targets = []
                    self._transition(
                        MissionPhase.EXPLORE_CORRIDOR_AWARE,
                        "corridor_recovery_escape_reached")
                else:
                    self.recovery_escape_failed_targets.append(
                        tuple(escape["position"]))
                    self._event(
                        "corridor_recovery_escape_failed",
                        source=escape["source"], target=escape["position"],
                        reason=self.last_path_execution_failure_reason)
                return
            # No local centreline escape survived map/voxel checks.  Run the
            # global recovery pool once (not twice per dispatch as before).
            self._global_recovery()
        elif self.phase == MissionPhase.CORRIDOR_INITIALIZE:
            if self.current_corridor and self.current_corridor.confirmed:
                self._transition(MissionPhase.CORRIDOR_DISCOVERY,
                                 "multi_frame_corridor_confirmed")
            else:
                self.no_candidate_cycles += 1
                if self.no_candidate_cycles >= self.p.corridor_confirmation_frames:
                    if not self.bootstrap_attempted and self._entrance_bootstrap():
                        self.no_candidate_cycles = 0
                        self._event("pose_relative_bootstrap_completed")
                    else:
                        self._transition(MissionPhase.GLOBAL_RECOVERY,
                                         "corridor_not_yet_observable")
                else:
                    time.sleep(0.8)
        elif self.phase == MissionPhase.CORRIDOR_DISCOVERY:
            self._corridor_step()
        elif self.phase == MissionPhase.CORRIDOR_END_CONFIRM:
            if self.grid_sequence != self.last_branch_scan_grid_sequence:
                self.last_branch_scan_grid_sequence = self.grid_sequence
                self.branch_scan_cycles += 1
            if self.branch_scan_cycles < self.p.corridor_confirmation_frames:
                time.sleep(0.5)
                return
            if self.ending_corridor_id:
                self.completed_corridors.add(self.ending_corridor_id)
            unfinished = [item for item in self.topology.corridors
                          if item.confirmed and
                          item.corridor_id not in self.completed_corridors]
            if unfinished:
                self.current_corridor = max(
                    unfinished, key=lambda item: (item.confidence,
                                                  item.forward_extent))
                self._transition(MissionPhase.GLOBAL_RECOVERY,
                                 "confirmed_corridor_branch_pending")
            else:
                self._transition(MissionPhase.BUILD_ROOM_QUEUE,
                                 "corridor_end_and_branch_scan_stable")
        elif self.phase == MissionPhase.BUILD_ROOM_QUEUE:
            self.room_queue = self._build_reachable_room_queue()
            self._event("room_queue_built", door_ids=self.room_queue)
            self._transition(MissionPhase.SELECT_NEXT_ROOM, "door_queue_ready")
        elif self.phase == MissionPhase.SELECT_NEXT_ROOM:
            if self._run_door_candidate_entry_takeover():
                return
            if self._run_opposite_door_attention():
                return
            self.room_queue = self._build_reachable_room_queue()
            if self.room_queue:
                self.current_door_id = self.room_queue[0]
                self._transition(MissionPhase.APPROACH_DOOR, "next_unvisited_door_selected")
            else:
                self._transition(MissionPhase.GLOBAL_RECOVERY, "room_queue_empty")
        elif self.phase == MissionPhase.APPROACH_DOOR:
            self._approach_door()
        elif self.phase == MissionPhase.CROSS_DOOR:
            self._cross_door()
        elif self.phase == MissionPhase.ROOM_LOCAL_EXPLORE:
            self._room_step()
        elif self.phase == MissionPhase.EXIT_ROOM:
            self._exit_room()
        elif self.phase == MissionPhase.RETURN_TO_CORRIDOR:
            self._return_corridor()
        elif self.phase == MissionPhase.GLOBAL_RECOVERY:
            if self._run_door_candidate_entry_takeover():
                return
            self._global_recovery()

    def _summary(self) -> dict:
        illegal_actual = sum(not item.get("legal", False)
                             for item in self.door_traversal_history)
        authorized_paths = [item for item in self.path_history
                            if item.get("execution_authorized")]
        rejected_paths = [item for item in self.path_history
                          if not item.get("execution_authorized")]
        path_walls = sum(int(item.get("occupied_intersections", 0))
                         for item in authorized_paths)
        path_unknown = sum(int(item.get("unknown_intersections", 0))
                           for item in authorized_paths)
        footprint_collisions = sum(int(item.get("footprint_collisions", 0))
                                   for item in authorized_paths)
        voxel_unknown = sum(int((item.get("voxel_validation") or {}).get(
            "unknown_samples", 0)) for item in authorized_paths)
        voxel_occupied = sum(int((item.get("voxel_validation") or {}).get(
            "occupied_samples", 0)) for item in authorized_paths)
        voxel_clearance = sum(int((item.get("voxel_validation") or {}).get(
            "clearance_failures", 0)) for item in authorized_paths)
        voxel_validator_errors = sum(
            bool(item.get("voxel_validation")) and
            not bool((item.get("voxel_validation") or {}).get("safe")) and
            not bool((item.get("voxel_validation") or {}).get("skipped")) and
            not any(int((item.get("voxel_validation") or {}).get(key, 0)) > 0
                    for key in ("unknown_samples", "occupied_samples",
                                "clearance_failures", "spacing_failures"))
            for item in authorized_paths)
        non_door = sum(int(item.get("non_door_crossings", 0))
                       for item in authorized_paths) + illegal_actual
        actual = self.actual_trajectory_validation or {}
        actual_2d = actual.get("two_dimensional_validation") or {}
        actual_voxel = actual.get("voxel_validation") or {}
        actual_safe = bool(actual.get("performed") and actual.get("safe"))
        snapshot_safe = bool(self.final_voxel_snapshot.get("complete"))
        confirmed_corridors = [corridor for corridor in self.topology.corridors
                               if corridor.confirmed]
        confirmed_doors = [door for door in self.topology.doors if door.confirmed]
        rooms_resolved = all(self._room_resolved(room)
                             for room in self.rooms.values())
        all_corridors_complete = bool(self.completed_corridors) and all(
            corridor.corridor_id in self.completed_corridors
            for corridor in confirmed_corridors)
        unresolved_doors = [door for door in confirmed_doors if not door.visited]
        visited_stagnant_seconds = max(
            0.0, time.monotonic() - self.last_visited_growth)
        completion_evidence = {
            "all_corridor_branches_complete": all_corridors_complete,
            "door_queue_empty": not unresolved_doors and not self.room_queue,
            "rooms_resolved": rooms_resolved,
            "large_reachable_unknown": self.large_reachable_unknown,
            "global_no_candidate_cycles": self.global_no_candidate_cycles,
            "visited_stagnant_seconds": round(visited_stagnant_seconds, 3),
        }
        complete = bool(self.exploration_complete and path_walls == 0 and
                        path_unknown == 0 and footprint_collisions == 0 and non_door == 0)
        complete = bool(complete and voxel_unknown == 0 and voxel_occupied == 0 and
                        voxel_clearance == 0 and voxel_validator_errors == 0)
        complete = bool(complete and snapshot_safe and actual_safe)
        return {
            "schema": "simenv_structured_exploration_summary_v1",
            "corridors_detected": sum(c.confirmed for c in self.topology.corridors),
            "corridors_completed": len(self.completed_corridors),
            "corridor_branch_edges": len(self.corridor_edges),
            "doors_confirmed": sum(d.confirmed for d in self.topology.doors),
            "room_candidates_detected": len(self.room_candidates),
            "room_candidates_confirmed": sum(
                candidate.confirmed for candidate in self.room_candidates.values()),
            "room_candidates_with_depth_confirmation": sum(
                candidate.depth_confirmations > 0
                for candidate in self.room_candidates.values()),
            "rooms_discovered": len(self.rooms),
            "rooms_entered": sum(r.maximum_inside_depth >= self.p.inside_depth_min
                                 for r in self.rooms.values()),
            "rooms_completed": sum(r.state == RoomState.COMPLETED
                                   for r in self.rooms.values()),
            "path_wall_intersections": path_walls,
            "path_unknown_intersections": path_unknown,
            "footprint_collisions": footprint_collisions,
            "voxel_unknown_samples": voxel_unknown,
            "voxel_occupied_samples": voxel_occupied,
            "voxel_clearance_failures": voxel_clearance,
            "voxel_validator_errors": voxel_validator_errors,
            "non_door_crossings": non_door,
            "rejected_path_count": len(rejected_paths),
            "rejected_path_wall_intersections": sum(
                int(item.get("occupied_intersections", 0))
                for item in rejected_paths),
            "rejected_path_unknown_intersections": sum(
                int(item.get("unknown_intersections", 0))
                for item in rejected_paths),
            "rejected_path_footprint_collisions": sum(
                int(item.get("footprint_collisions", 0))
                for item in rejected_paths),
            "final_voxel_snapshot_acknowledged": bool(
                self.final_voxel_snapshot.get("acknowledged")),
            "final_voxel_snapshot_complete": snapshot_safe,
            "actual_trajectory_safe": actual_safe,
            "actual_trajectory_occupied_intersections": int(
                actual_2d.get("occupied_intersections", 0)),
            "actual_trajectory_unknown_intersections": int(
                actual_2d.get("unknown_intersections", 0)),
            "actual_trajectory_footprint_collisions": int(
                actual_2d.get("footprint_collisions", 0)),
            "actual_trajectory_non_door_crossings": int(
                actual_2d.get("non_door_crossings", 0)) + int(
                    actual.get("illegal_actual_door_events", 0)),
            "actual_trajectory_voxel_unknown_samples": int(
                actual_voxel.get("unknown_samples", 0)),
            "actual_trajectory_voxel_occupied_samples": int(
                actual_voxel.get("occupied_samples", 0)),
            "actual_trajectory_voxel_clearance_failures": int(
                actual_voxel.get("clearance_failures", 0)),
            "global_no_candidate_cycles": self.global_no_candidate_cycles,
            "completion_evidence": completion_evidence,
            "door_traversal_successes": sum(item.get("legal", False)
                                            for item in self.door_traversal_history),
            "exploration_complete": complete,
            "termination_reason": self.termination_reason or (
                "ros_shutdown" if rospy.is_shutdown() else "running"),
            "first_room_entry_timeout_seconds": self.first_room_entry_timeout,
            "door_candidate_entry_timeout_seconds":
            self.door_candidate_entry_timeout,
            "door_candidate_takeover_active":
            self.door_candidate_takeover is not None,
            "door_candidate_takeover_attempts": sum(
                int(item.get("attention_attempts", 0))
                for item in self.door_candidate_takeover_history) +
            (int(self.door_candidate_takeover.get("attention_attempts", 0))
             if self.door_candidate_takeover else 0),
            "first_room_entry_timeout_triggered": (
                self.termination_reason == "first_room_entry_timeout"),
            "elapsed_seconds": round(self.elapsed(), 3),
            "final_phase": self.phase.value,
            "topology_map_source": "fastlio_octomap_projection",
            "topology_grid_topic": self.grid_topic,
            "voxel_map_file": self.map_file,
            "use_depth_door_confirmation": self.use_depth,
            "use_rgb_semantic_confirmation": self.use_rgb,
            "topology_updates_total": len(self.doorway_history),
            "motion_topology_updates": sum(
                item.get("update_source") == "motion"
                for item in self.corridor_history),
            "door_attention_attempts": len(self.door_attention_attempted),
            "opposite_door_attention_attempts": sum(
                int(item.get("attempts", 0))
                for item in self.opposite_door_attentions.values()),
            "execution_safety_cancellations": sum(
                item.get("event") == "execution_safety_cancelled_goal"
                for item in self.events),
            "room_macro_goal_attempts": sum(self.room_macro_attempts.values()),
            "room_maximum_macro_goals": self.room_maximum_macro_goals,
        }

    def _room_queue_records(self) -> List[dict]:
        records = []
        axis = unit(self.current_corridor.principal_direction) if self.current_corridor else (1.0, 0.0)
        left_normal = (-axis[1], axis[0])
        current = ((self.pose["x"], self.pose["y"])
                   if self.pose else (0.0, 0.0))
        for door_id in self.room_queue:
            door = self._door(door_id)
            if not door:
                continue
            side_dot = door.normal[0] * left_normal[0] + door.normal[1] * left_normal[1]
            records.append({
                "door_id": door.door_id,
                "door_pose": {"center": door.center,
                              "normal_direction": door.normal_direction},
                "left_or_right_side": "left" if side_dot >= 0.0 else "right",
                "adjacent_region_id": door.adjacent_region_id,
                "estimated_unknown_size": door.estimated_unknown_size,
                "distance_from_current": distance(current, door.center),
                "confidence": door.confidence,
                "visited": door.visited,
                "attempt_count": door.attempt_count,
                "blacklist_until": door.blacklist_until,
            })
        return records

    def _build_reachable_room_queue(self) -> List[str]:
        if self.pose is None or self.grid is None:
            return []
        current = (self.pose["x"], self.pose["y"])
        ordered = build_room_queue(self.topology.doors, current, self.elapsed())
        reachable = []
        for door_id in ordered:
            door = self._door(door_id)
            nx, ny = door.normal
            outside = (door.center[0] - 0.75 * nx,
                       door.center[1] - 0.75 * ny)
            path = astar_free_path(
                self.grid, current, outside,
                clearance_radius=self.corridor_network_clearance)
            validity = validate_path(
                self.grid, path, spacing=self.p.path_sample_spacing)
            # Corridor topology is a scheduling hint, not a collision layer.
            # A confirmed door can sit just outside a temporarily drifted or
            # truncated corridor polygon.  Known-free A*, full-footprint 2-D
            # validation and the execution-time OctoMap check remain the
            # authoritative safety gates for reaching its waiting point.
            if path and validity.valid:
                reachable.append(door_id)
        return reachable

    @staticmethod
    def _trajectory_length(samples: Sequence[dict]) -> float:
        return sum(math.hypot(b["x"] - a["x"], b["y"] - a["y"])
                   for a, b in zip(samples[:-1], samples[1:]))

    def _localization_diagnostic(self) -> Tuple[dict, List[dict], List[dict]]:
        """Initial-pose-align FAST-LIO with passive GT for evaluation only."""
        estimate = [item for item in self.trajectory
                    if item.get("stamp", 0.0) > 0.0]
        truth = [item for item in self.ground_truth_trajectory
                 if item.get("stamp", 0.0) > 0.0]
        unavailable = {
            "schema": "simenv_structured_localization_diagnostic_v1",
            "diagnostic_only": True,
            "available": False,
            "reason": "ground_truth_or_estimate_samples_missing",
            "estimate_samples": len(estimate),
            "ground_truth_samples": len(truth),
        }
        if len(estimate) < 2 or len(truth) < 2:
            return unavailable, [], []
        truth.sort(key=lambda item: item["stamp"])
        first_stamp, last_stamp = truth[0]["stamp"], truth[-1]["stamp"]
        estimate = [item for item in estimate
                    if first_stamp <= item["stamp"] <= last_stamp]
        if len(estimate) < 2:
            unavailable["reason"] = "estimate_and_ground_truth_do_not_overlap"
            return unavailable, [], []

        matched_truth = []
        truth_index = 0
        for item in estimate:
            stamp = item["stamp"]
            while (truth_index + 1 < len(truth) and
                   truth[truth_index + 1]["stamp"] < stamp):
                truth_index += 1
            first = truth[truth_index]
            second = truth[min(truth_index + 1, len(truth) - 1)]
            span = second["stamp"] - first["stamp"]
            alpha = 0.0 if span <= 1e-9 else (stamp - first["stamp"]) / span
            yaw_delta = wrap_angle(second["yaw"] - first["yaw"])
            matched_truth.append({
                "t": item["t"],
                "x": first["x"] + alpha * (second["x"] - first["x"]),
                "y": first["y"] + alpha * (second["y"] - first["y"]),
                "yaw": wrap_angle(first["yaw"] + alpha * yaw_delta),
            })
        estimate_origin, truth_origin = estimate[0], matched_truth[0]
        rotation = wrap_angle(truth_origin["yaw"] - estimate_origin["yaw"])
        cosine, sine = math.cos(rotation), math.sin(rotation)
        aligned = []
        for item in estimate:
            dx, dy = (item["x"] - estimate_origin["x"],
                      item["y"] - estimate_origin["y"])
            aligned.append({
                "t": item["t"],
                "x": truth_origin["x"] + cosine * dx - sine * dy,
                "y": truth_origin["y"] + sine * dx + cosine * dy,
                "yaw": wrap_angle(item["yaw"] + rotation),
            })
        errors = [math.hypot(a["x"] - b["x"], a["y"] - b["y"])
                  for a, b in zip(aligned, matched_truth)]
        yaw_errors = [abs(wrap_angle(a["yaw"] - b["yaw"]))
                      for a, b in zip(aligned, matched_truth)]
        report = {
            "schema": "simenv_structured_localization_diagnostic_v1",
            "diagnostic_only": True,
            "available": True,
            "alignment": "initial_pose_se2",
            "samples": len(errors),
            "duration_sec": round(aligned[-1]["t"] - aligned[0]["t"], 3),
            "position_error_m": {
                "mean": round(float(np.mean(errors)), 4),
                "rmse": round(math.sqrt(float(np.mean(np.square(errors)))), 4),
                "p95": round(float(np.percentile(errors, 95)), 4),
                "max": round(max(errors), 4),
                "end": round(errors[-1], 4),
            },
            "yaw_error_rad": {
                "mean": round(float(np.mean(yaw_errors)), 4),
                "rmse": round(math.sqrt(float(np.mean(np.square(yaw_errors)))), 4),
                "max": round(max(yaw_errors), 4),
            },
            "path_length_m": {
                "fast_lio": round(self._trajectory_length(aligned), 4),
                "ground_truth": round(self._trajectory_length(matched_truth), 4),
            },
        }
        return report, aligned, matched_truth

    def _selected_goal_records(self) -> List[dict]:
        """Return one record per authorized high-level path, not per waypoint."""
        records = []
        for item in self.path_history:
            path = item.get("path") or []
            if (not item.get("valid") or len(path) < 2 or
                    item.get("source") == "actual_trajectory_segment"):
                continue
            target = path[-1]
            records.append({
                "selection_index": len(records) + 1,
                "t": item.get("t"),
                "phase": item.get("phase"),
                "source": item.get("source"),
                "target": [float(target[0]), float(target[1])],
                "path_points": len(path),
                "door_id": item.get("door_id"),
            })
        return records

    def _write_artifacts(self) -> None:
        edges = []
        for first, second in sorted(self.corridor_edges):
            edges.append({"from": first, "to": second,
                          "type": "corridor_to_corridor"})
        for door in self.topology.doors:
            corridor_id = door.corridor_id
            if corridor_id:
                edges.append({"from": corridor_id, "to": door.door_id,
                              "type": "corridor_to_door"})
            if door.adjacent_region_id:
                edges.append({"from": door.door_id, "to": door.adjacent_region_id,
                              "type": "door_to_room"})
        topology = {
            "schema": "simenv_indoor_topology_v1",
            "map_provenance": {
                "source": "fastlio_octomap_projection",
                "grid_topic": self.grid_topic,
                "voxel_map_file": self.map_file,
                "frame_id": self.grid_frame,
            },
            "corridors": [item.to_dict() for item in self.topology.corridors],
            "doors": [item.to_dict() for item in self.topology.doors],
            "room_candidates": [item.to_dict()
                                for item in self.room_candidates.values()],
            "rooms": [item.to_dict() for item in self.rooms.values()],
            "edges": edges,
            "room_queue": self._room_queue_records(),
            "completed_corridor_ids": sorted(self.completed_corridors),
            "current_phase": self.phase.value,
        }
        self._atomic_json(os.path.join(self.output_dir, "indoor_topology.json"), topology)
        self._atomic_json(os.path.join(self.output_dir, "topology_evidence.json"), topology)
        self._atomic_json(os.path.join(self.output_dir, "corridor_history.json"),
                          self.corridor_history)
        self._atomic_json(os.path.join(self.output_dir, "doorway_history.json"),
                          self.doorway_history)
        self._atomic_json(os.path.join(
            self.output_dir, "door_attention_multiview.json"), {
                "schema": "simenv_door_attention_multiview_v1",
                "views": self.door_attention_multiview,
            })
        self._atomic_json(os.path.join(
            self.output_dir, "door_candidate_takeover.json"), {
                "schema": "simenv_door_candidate_takeover_v1",
                "timeout_seconds": self.door_candidate_entry_timeout,
                "active": self.door_candidate_takeover,
                "history": self.door_candidate_takeover_history,
            })
        self._atomic_json(os.path.join(
            self.output_dir, "door_probe_history.json"), {
                "schema": "simenv_traversable_room_portal_probe_v1",
                "completed_door_ids": sorted(self.door_probe_completed),
                "records": self.door_probe_history,
            })
        portal_tracks = {}
        for frame in self.room_candidate_history:
            for candidate in frame.get("observations", []):
                portal = candidate.get("portal_center")
                if portal is not None:
                    portal_tracks.setdefault(candidate.get("candidate_id"), []).append(
                        [float(portal[0]), float(portal[1])])
        portal_drift = {}
        for candidate_id, points in portal_tracks.items():
            portal_drift[candidate_id] = max(
                (distance(first, second) for first in points for second in points),
                default=0.0)
        attention_events = [
            event for event in self.events
            if (str(event.get("event", "")).startswith("door_attention_") or
                str(event.get("event", "")).startswith(
                    "opposite_door_attention_"))]
        execution_safety_events = [
            event for event in self.events
            if event.get("event") in (
                "execution_safety_cancelled_goal",
                "room_macro_abandoned_for_execution_safety")]
        self._atomic_json(os.path.join(
            self.output_dir, "execution_safety_diagnostic.json"), {
                "schema": "simenv_execution_safety_diagnostic_v1",
                "configuration": {
                    "enabled": self.enable_execution_safety_monitor,
                    "interval_seconds": self.execution_safety_interval,
                    "lookahead_m": self.execution_safety_lookahead,
                    "maximum_cross_track_error_m":
                    self.execution_max_cross_track_error,
                    "confirmation_cycles":
                    self.execution_safety_confirmation_cycles,
                },
                "cancellation_count": sum(
                    event.get("event") == "execution_safety_cancelled_goal"
                    for event in execution_safety_events),
                "events": execution_safety_events,
            })
        self._atomic_json(os.path.join(
            self.output_dir, "door_detection_diagnostic.json"), {
                "schema": "simenv_motion_door_detection_diagnostic_v2",
                "configuration": {
                    "motion_topology_interval": self.motion_topology_interval,
                    "door_confirmation_frames": self.p.door_confirmation_frames,
                    "enable_door_attention": self.enable_door_attention,
                    "door_attention_observation_frames":
                    self.door_attention_observation_frames,
                    "door_attention_timeout": self.door_attention_timeout,
                    "enable_opposite_door_attention":
                    self.enable_opposite_door_attention,
                    "opposite_door_station_tolerance":
                    self.opposite_door_station_tolerance,
                },
                "topology_updates_total": len(self.doorway_history),
                "motion_topology_updates": sum(
                    item.get("update_source") == "motion"
                    for item in self.corridor_history),
                "door_attention_events": attention_events,
                "opposite_door_attentions": list(
                    self.opposite_door_attentions.values()),
                "doors": [{
                    "door_id": door.door_id,
                    "center": door.center,
                    "corridor_id": door.corridor_id,
                    "observations": door.observations,
                    "confirmed": door.confirmed,
                    "traversable": door.traversable,
                    "confidence": door.confidence,
                    "last_observed_grid_sequence":
                    door.last_observed_grid_sequence,
                    "last_observer_position": door.last_observer_position,
                } for door in self.topology.doors],
                "room_candidates": [{
                    "candidate_id": candidate.candidate_id,
                    "corridor_id": candidate.corridor_id,
                    "side": candidate.side,
                    "portal_center": candidate.portal_center,
                    "observations": candidate.observations,
                    "confirmed": candidate.confirmed,
                    "portal_position_span_m": portal_drift.get(
                        candidate.candidate_id, 0.0),
                    "door_id": candidate.door_id,
                    "channel_validation": candidate.channel_validation,
                } for candidate in self.room_candidates.values()],
            })
        self._atomic_json(os.path.join(self.output_dir, "room_region_history.json"),
                          self.room_history)
        self._atomic_json(os.path.join(self.output_dir, "room_candidate_history.json"),
                          self.room_candidate_history)
        self._atomic_json(os.path.join(self.output_dir, "door_traversal_history.json"),
                          self.door_traversal_history)
        self._atomic_json(os.path.join(self.output_dir, "door_commit_debug.json"), {
            "schema": "simenv_door_commit_debug_v1",
            "configuration": {"enable_door_commit": self.enable_door_commit},
            "door_locked": bool(self.door_locked),
            "active_commit": self.door_commit,
            "records": self.door_commit_history,
        })
        self._atomic_json(os.path.join(self.output_dir, "path_validity_history.json"),
                          self.path_history)
        self._atomic_json(os.path.join(self.output_dir, "semantic_geometry_observation.json"), {
            "schema": "simenv_semantic_geometry_observation_v1",
            "latest": self.latest_depth, "observations": self.semantic_history,
        })
        self._atomic_json(os.path.join(self.output_dir, "goal_history.json"), self.goal_history)
        gt_payload = {
            "schema": "simenv_ground_truth_diagnostic_trajectory_v1",
            "diagnostic_only": True,
            "poses": [{key: item[key] for key in ("t", "stamp", "x", "y", "z", "yaw")}
                      for item in self.ground_truth_trajectory],
        }
        self._atomic_json(os.path.join(self.output_dir, "trajectory_ground_truth.json"),
                          gt_payload)
        localization, _, _ = self._localization_diagnostic()
        self._atomic_json(os.path.join(self.output_dir, "localization_error_gt.json"),
                          localization)
        self._atomic_json(os.path.join(self.output_dir, "selected_goal_sequence.json"), {
            "schema": "simenv_selected_high_level_goals_v1",
            "note": "one entry per authorized high-level path; executor waypoints omitted",
            "goals": self._selected_goal_records(),
        })
        self._atomic_json(os.path.join(self.output_dir, "structured_events.json"), self.events)
        self._atomic_json(os.path.join(self.output_dir, "state_history.json"), self.events)
        self._atomic_json(os.path.join(self.output_dir, "final_voxel_snapshot.json"),
                          self.final_voxel_snapshot)
        self._atomic_json(os.path.join(self.output_dir,
                                       "actual_trajectory_validation.json"),
                          self.actual_trajectory_validation)
        self._atomic_json(os.path.join(self.output_dir, "exploration_summary.json"),
                          self._summary())
        with open(os.path.join(self.output_dir, "trajectory.csv"), "w", newline="",
                  encoding="utf-8") as stream:
            writer = csv.DictWriter(stream, fieldnames=["t", "x", "y", "z", "yaw"])
            writer.writeheader()
            for item in self.trajectory:
                writer.writerow({key: item[key] for key in writer.fieldnames})
        self._render_images()

    def _draw_base(self, axis) -> None:
        if self.grid is None:
            return
        display = np.ones((*self.grid.data.shape, 3), dtype=np.float32)
        display[self.grid.data < 0] = (0.55, 0.55, 0.55)
        display[self.grid.data >= 50] = (0.05, 0.05, 0.05)
        axis.imshow(display, origin="lower", extent=(
            self.grid.origin_x, self.grid.origin_x + self.grid.width * self.grid.resolution,
            self.grid.origin_y, self.grid.origin_y + self.grid.height * self.grid.resolution),
                    interpolation="nearest")

    def _render_images(self) -> None:
        try:
            import matplotlib
            matplotlib.use("Agg")
            import matplotlib.pyplot as plt
            from matplotlib.lines import Line2D
            from matplotlib.patches import Patch, Polygon
        except Exception as error:
            rospy.logwarn("Structured rendering unavailable: %s", error)
            return
        # 1: topology graph.
        fig, axis = plt.subplots(figsize=(10, 9), dpi=130)
        self._draw_base(axis)
        for corridor in self.topology.corridors:
            if corridor.centerline:
                axis.plot(*zip(*corridor.centerline), color="#ff8c22", linewidth=2.2)
            if corridor.left_wall:
                axis.plot(*zip(*corridor.left_wall), color="#4a90e2", linewidth=1.2)
            if corridor.right_wall:
                axis.plot(*zip(*corridor.right_wall), color="#4a90e2", linewidth=1.2)
        for door in self.topology.doors:
            axis.plot([door.left_frame_point[0], door.right_frame_point[0]],
                      [door.left_frame_point[1], door.right_frame_point[1]],
                      color="#35c46a" if door.confirmed else "#e6c229", linewidth=4)
            axis.text(door.center[0], door.center[1], door.door_id, fontsize=7)
        for candidate in self.room_candidates.values():
            color = "#8e24aa" if candidate.confirmed else "#ab7ac1"
            axis.scatter(candidate.centroid[0], candidate.centroid[1],
                         color=color, marker="s", s=38, zorder=5)
            axis.text(candidate.centroid[0], candidate.centroid[1],
                      "{} R={:.2f}".format(
                          candidate.candidate_id, candidate.fused_confidence),
                      fontsize=7, color=color)
            if candidate.portal_center:
                axis.plot([candidate.portal_center[0], candidate.centroid[0]],
                          [candidate.portal_center[1], candidate.centroid[1]],
                          color=color, linestyle=":", linewidth=1.0)
                axis.scatter(candidate.portal_center[0], candidate.portal_center[1],
                             color=color, marker="x", s=30, zorder=5)
        for room in self.rooms.values():
            if room.estimated_boundary:
                axis.add_patch(Polygon(room.estimated_boundary, closed=True, fill=False,
                                       edgecolor="#b053d1", linewidth=1.4))
                centroid = (
                    sum(point[0] for point in room.estimated_boundary) /
                    len(room.estimated_boundary),
                    sum(point[1] for point in room.estimated_boundary) /
                    len(room.estimated_boundary),
                )
                entry = self._door(room.entry_door_id)
                if entry:
                    axis.plot([entry.center[0], centroid[0]],
                              [entry.center[1], centroid[1]],
                              color="#b053d1", linestyle="--", linewidth=0.9)
        for door in self.topology.doors:
            corridor = next((item for item in self.topology.corridors
                             if item.corridor_id == door.corridor_id), None)
            if corridor and corridor.centerline:
                start, end = corridor.centerline[0], corridor.centerline[-1]
                segment = (end[0] - start[0], end[1] - start[1])
                length_squared = segment[0] ** 2 + segment[1] ** 2
                alpha = 0.0 if length_squared < 1e-9 else float(np.clip(
                    ((door.center[0] - start[0]) * segment[0] +
                     (door.center[1] - start[1]) * segment[1]) /
                    length_squared, 0.0, 1.0))
                nearest = (start[0] + alpha * segment[0],
                           start[1] + alpha * segment[1])
                axis.plot([nearest[0], door.center[0]],
                          [nearest[1], door.center[1]],
                          color="#35c46a", linestyle="--", linewidth=0.8)
        axis.set_aspect("equal"); axis.set_title("Online corridor-door-room topology")
        fig.tight_layout(); fig.savefig(os.path.join(self.output_dir, "indoor_topology.png"))
        plt.close(fig)

        # A: one uncluttered map for room layout, actual motion and cumulative
        # LiDAR observation.  White/black are observed by LiDAR; gray remains
        # unknown.  This is coverage evidence, not the nominal 30 m range disk.
        fig, axis = plt.subplots(figsize=(12, 8), dpi=150)
        self._draw_base(axis)
        if self.grid is not None:
            observed = (self.grid.data >= 0).astype(np.uint8)
            x_values = (self.grid.origin_x +
                        (np.arange(self.grid.width) + 0.5) * self.grid.resolution)
            y_values = (self.grid.origin_y +
                        (np.arange(self.grid.height) + 0.5) * self.grid.resolution)
            if observed.min() != observed.max():
                axis.contour(x_values, y_values, observed, levels=[0.5],
                             colors=["#00a6d6"], linewidths=0.7, alpha=0.8)
            observed_area = float(np.count_nonzero(observed)) * self.grid.resolution ** 2
        else:
            observed_area = 0.0
        if self.visited_cells:
            axis.scatter([cell[0] * 0.25 for cell in self.visited_cells],
                         [cell[1] * 0.25 for cell in self.visited_cells],
                         s=10, color="#77c8ff", alpha=0.30, linewidths=0,
                         zorder=2)
        for room in self.rooms.values():
            if room.estimated_boundary:
                axis.add_patch(Polygon(
                    room.estimated_boundary, closed=True, fill=False,
                    edgecolor="#9c27b0", linewidth=2.0, linestyle="--", zorder=4))
                center = np.mean(np.asarray(room.estimated_boundary), axis=0)
                axis.text(center[0], center[1], room.region_id,
                          color="#7b1fa2", fontsize=8, ha="center", zorder=6)
        for door in self.topology.doors:
            axis.plot([door.left_frame_point[0], door.right_frame_point[0]],
                      [door.left_frame_point[1], door.right_frame_point[1]],
                      color="#22aa55", linewidth=4.0, zorder=5)
            axis.text(door.center[0], door.center[1], door.door_id,
                      color="#087f3f", fontsize=7, zorder=6)
        if self.trajectory:
            axis.plot([item["x"] for item in self.trajectory],
                      [item["y"] for item in self.trajectory],
                      color="#ff7f0e", linewidth=2.0, zorder=5)
            axis.scatter(self.trajectory[0]["x"], self.trajectory[0]["y"],
                         marker="o", color="#1b5e20", s=45, zorder=7)
            axis.scatter(self.trajectory[-1]["x"], self.trajectory[-1]["y"],
                         marker="X", color="#b71c1c", s=55, zorder=7)
        axis.legend(handles=[
            Patch(facecolor="0.55", label="LiDAR unknown"),
            Patch(facecolor="white", edgecolor="0.7", label="LiDAR observed free"),
            Patch(facecolor="0.05", label="LiDAR observed occupied"),
            Patch(facecolor="#77c8ff", alpha=0.30, label="robot-visited footprint"),
            Line2D([0], [0], color="#00a6d6", label="cumulative LiDAR coverage edge"),
            Line2D([0], [0], color="#ff7f0e", linewidth=2, label="FAST-LIO trajectory"),
            Line2D([0], [0], color="#9c27b0", linestyle="--",
                   label="estimated room boundary"),
            Line2D([0], [0], color="#22aa55", linewidth=4, label="confirmed door"),
        ], loc="upper left", fontsize=8)
        axis.set_aspect("equal")
        axis.set_xlabel("x [m]"); axis.set_ylabel("y [m]")
        axis.set_title("Room layout, robot trajectory and cumulative LiDAR coverage\n"
                       "observed map area = {:.1f} m²".format(observed_area))
        fig.tight_layout()
        fig.savefig(os.path.join(
            self.output_dir, "room_layout_trajectory_lidar_coverage.png"))
        plt.close(fig)

        # B: passive GT localization diagnostic.  It is deliberately rendered
        # separately from exploration outputs so it cannot be mistaken for a
        # planning input.
        localization, aligned_estimate, matched_truth = self._localization_diagnostic()
        fig, axes = plt.subplots(1, 2, figsize=(13, 5.5), dpi=150)
        if localization.get("available"):
            axes[0].plot([item["x"] for item in matched_truth],
                         [item["y"] for item in matched_truth],
                         color="#222222", linewidth=2.2, label="Gazebo GT")
            axes[0].plot([item["x"] for item in aligned_estimate],
                         [item["y"] for item in aligned_estimate],
                         color="#ff7f0e", linewidth=1.4,
                         label="FAST-LIO (initial-pose aligned)")
            errors = [math.hypot(a["x"] - b["x"], a["y"] - b["y"])
                      for a, b in zip(aligned_estimate, matched_truth)]
            times = [item["t"] - aligned_estimate[0]["t"]
                     for item in aligned_estimate]
            axes[1].plot(times, errors, color="#d62728", linewidth=1.2)
            rmse = localization["position_error_m"]["rmse"]
            axes[1].axhline(rmse, color="#9467bd", linestyle="--",
                            label="RMSE = {:.3f} m".format(rmse))
            axes[0].axis("equal"); axes[0].legend(fontsize=8)
            axes[1].legend(fontsize=8)
            axes[1].set_xlabel("mission time [s]")
            axes[1].set_ylabel("position error [m]")
            axes[0].set_title("Estimated motion versus GT")
            axes[1].set_title("Position error over time")
        else:
            for axis in axes:
                axis.axis("off")
            axes[0].text(0.05, 0.55,
                         "GT diagnostic unavailable\n{}\nestimate={}  GT={}".format(
                             localization.get("reason"),
                             localization.get("estimate_samples", 0),
                             localization.get("ground_truth_samples", 0)),
                         transform=axes[0].transAxes, fontsize=12)
        for axis in axes:
            axis.grid(True, alpha=0.25)
        fig.suptitle("Localization diagnostic only — GT is never used for planning")
        fig.tight_layout()
        fig.savefig(os.path.join(
            self.output_dir, "trajectory_estimate_vs_ground_truth.png"))
        plt.close(fig)

        # C: one marker per high-level path selection.  Intermediate executor
        # waypoints in goal_history.json are intentionally absent.
        selections = self._selected_goal_records()
        fig, (axis, table_axis) = plt.subplots(
            1, 2, figsize=(17, 9), dpi=150, gridspec_kw={"width_ratios": [1.45, 1.0]})
        self._draw_base(axis)
        if self.trajectory:
            axis.plot([item["x"] for item in self.trajectory],
                      [item["y"] for item in self.trajectory],
                      color="0.55", linewidth=1.0, alpha=0.8)
        phase_colors = {
            "EXPLORE_ROOM_LOCAL": "#9c27b0", "APPROACH_DOOR": "#2ca02c",
            "CROSS_DOOR": "#17becf", "EXIT_ROOM": "#8c564b",
            "RECOVERY": "#d62728",
        }
        rows = []
        for record in selections:
            x, y = record["target"]
            color = phase_colors.get(record["phase"], "#1f77b4")
            axis.scatter(x, y, marker="*", s=90, color=color,
                         edgecolor="white", linewidth=0.5, zorder=6)
            axis.annotate("G{}".format(record["selection_index"]), (x, y),
                          xytext=(4, 4), textcoords="offset points",
                          fontsize=7, color=color, fontweight="bold", zorder=7)
            rows.append([
                "G{}".format(record["selection_index"]),
                "{:.1f}".format(record["t"] or 0.0),
                record["source"],
                "({:.2f}, {:.2f})".format(x, y),
            ])
        axis.set_aspect("equal"); axis.set_xlabel("x [m]"); axis.set_ylabel("y [m]")
        axis.set_title("Numbered high-level next-goal selections")
        table_axis.axis("off")
        if rows:
            table = table_axis.table(
                cellText=rows, colLabels=["ID", "t [s]", "source", "target (x,y)"],
                loc="center", cellLoc="left", colWidths=[0.10, 0.15, 0.38, 0.30])
            table.auto_set_font_size(False)
            table.set_fontsize(max(5.0, min(8.0, 150.0 / len(rows))))
            table.scale(1.0, max(0.55, min(1.15, 24.0 / len(rows))))
        else:
            table_axis.text(
                0.5, 0.5,
                "No authorized high-level goal was selected.\n"
                "The run ended during startup or before planning.",
                ha="center", va="center", fontsize=12,
                transform=table_axis.transAxes)
        table_axis.set_title(
            "One row = one planning decision\n(executor path waypoints are not selections)")
        fig.tight_layout()
        fig.savefig(os.path.join(self.output_dir, "selected_goal_sequence.png"))
        plt.close(fig)

        # 2: strict path/door validation.
        fig, axis = plt.subplots(figsize=(10, 9), dpi=130)
        self._draw_base(axis)
        if self.trajectory:
            axis.plot([p["x"] for p in self.trajectory], [p["y"] for p in self.trajectory],
                      color="#ff8c22", linewidth=1.6, label="actual trajectory")
            actual_unsafe = []
            if self.grid is not None:
                actual_samples = interpolate_polyline(
                    [(p["x"], p["y"]) for p in self.trajectory],
                    self.p.path_sample_spacing)
                for sample_index, point in enumerate(actual_samples):
                    if sample_index + 1 < len(actual_samples):
                        following = actual_samples[sample_index + 1]
                        yaw = math.atan2(following[1] - point[1],
                                         following[0] - point[0])
                    elif sample_index > 0:
                        previous = actual_samples[sample_index - 1]
                        yaw = math.atan2(point[1] - previous[1],
                                         point[0] - previous[0])
                    else:
                        yaw = 0.0
                    if (self.grid.state(point) != 0 or
                            not self.grid.footprint_safe(point, yaw)):
                        actual_unsafe.append(point)
            if actual_unsafe:
                axis.scatter([point[0] for point in actual_unsafe],
                             [point[1] for point in actual_unsafe],
                             s=18, c="red", marker="x", alpha=0.9)
        for item in self.path_history:
            path = item.get("path") or []
            if len(path) >= 2:
                axis.plot(*zip(*path), color="#42d4f4" if item.get("valid") else "red",
                          alpha=0.65, linewidth=0.9)
                unsafe = []
                if self.grid is not None:
                    samples = interpolate_polyline(path, self.p.path_sample_spacing)
                    for sample_index, point in enumerate(samples):
                        if sample_index + 1 < len(samples):
                            following = samples[sample_index + 1]
                            yaw = math.atan2(following[1] - point[1],
                                             following[0] - point[0])
                        elif sample_index > 0:
                            previous = samples[sample_index - 1]
                            yaw = math.atan2(point[1] - previous[1],
                                             point[0] - previous[0])
                        else:
                            yaw = 0.0
                        if (self.grid.state(point) != 0 or
                                not self.grid.footprint_safe(point, yaw)):
                            unsafe.append(point)
                if unsafe:
                    axis.scatter([point[0] for point in unsafe],
                                 [point[1] for point in unsafe],
                                 s=12, c="red", marker="x", alpha=0.8)
        for door in self.topology.doors:
            nx, ny = door.normal; tx, ty = door.tangent
            half = 0.5 * door.width
            polygon = [
                (door.center[0] - half * tx - 0.18 * nx,
                 door.center[1] - half * ty - 0.18 * ny),
                (door.center[0] + half * tx - 0.18 * nx,
                 door.center[1] + half * ty - 0.18 * ny),
                (door.center[0] + half * tx + 0.18 * nx,
                 door.center[1] + half * ty + 0.18 * ny),
                (door.center[0] - half * tx + 0.18 * nx,
                 door.center[1] - half * ty + 0.18 * ny),
            ]
            axis.add_patch(Polygon(polygon, closed=True, fill=False,
                                   edgecolor="#35c46a", linewidth=1.6))
        for crossing in self.door_traversal_history:
            axis.scatter(crossing["point"][0], crossing["point"][1], s=25,
                         c="#35c46a" if crossing["legal"] else "red", marker="x")
        axis.legend(handles=[
            Line2D([0], [0], color="#ff8c22", linewidth=1.6,
                   label="actual trajectory"),
            Line2D([0], [0], color="#42d4f4", linewidth=1.2,
                   label="execution-authorized path"),
            Line2D([0], [0], color="red", linewidth=1.2,
                   label="rejected / never executed"),
            Line2D([0], [0], color="red", marker="x", linestyle="None",
                   label="unsafe sample"),
            Patch(facecolor="none", edgecolor="#35c46a",
                  label="confirmed door channel"),
        ], loc="best", fontsize=8)
        axis.set_aspect("equal"); axis.set_title("Path and confirmed-door validation")
        fig.tight_layout(); fig.savefig(os.path.join(
            self.output_dir, "path_and_door_validation.png")); plt.close(fig)
        # 3: queue, local goals and observed/unknown map.
        fig, axis = plt.subplots(figsize=(10, 9), dpi=130)
        self._draw_base(axis)
        if self.visited_cells:
            visited_x = [cell[0] * 0.25 for cell in self.visited_cells]
            visited_y = [cell[1] * 0.25 for cell in self.visited_cells]
            axis.scatter(visited_x, visited_y, s=28, c="#77c8ff", marker="s",
                         alpha=0.45, linewidths=0, label="visited area")
        if self.trajectory:
            axis.plot([p["x"] for p in self.trajectory], [p["y"] for p in self.trajectory],
                      color="#ff8c22", linewidth=1.7)
        for room in self.rooms.values():
            goals = room.successful_goals
            if goals:
                axis.scatter([p[0] for p in goals], [p[1] for p in goals],
                             s=35, c="#b053d1", marker="*")
        for index, door_id in enumerate(self.room_queue):
            door = self._door(door_id)
            if door:
                axis.text(door.center[0], door.center[1], "Q{}".format(index + 1),
                          color="#ffdd33", fontsize=8, fontweight="bold")
        legend = [
            Patch(facecolor="0.55", label="unknown"),
            Patch(facecolor="white", edgecolor="0.7",
                  label="observed free / unvisited"),
            Patch(facecolor="#77c8ff", alpha=0.45, label="visited area"),
        ]
        axis.legend(handles=legend, loc="best", fontsize=8)
        axis.set_aspect("equal"); axis.set_title(
            "Structured exploration | phase={}".format(self.phase.value))
        fig.tight_layout(); fig.savefig(os.path.join(
            self.output_dir, "structured_exploration_map.png")); plt.close(fig)
        shutil.copyfile(os.path.join(self.output_dir, "structured_exploration_map.png"),
                        os.path.join(self.output_dir,
                                     "adaptive_structured_exploration.png"))
    def run(self) -> None:
        self.complete_pub.publish(Bool(data=False))
        if not self._wait_ready():
            self.termination_reason = "startup_timeout_or_frame_mismatch"
            self._write_artifacts()
            return
        self.start_wall = time.monotonic()
        self.last_visited_growth = self.start_wall
        self._event("structured_exploration_started")
        try:
            while not rospy.is_shutdown() and self.phase != MissionPhase.FINISHED:
                if self._door_candidate_takeover_expired():
                    self._finish_door_candidate_takeover_failure(
                        "door_candidate_entry_timeout")
                    break
                if self._first_room_entry_timeout_reached():
                    self.termination_reason = "first_room_entry_timeout"
                    self.exploration_complete = False
                    self._event(
                        "first_room_entry_timeout_reached",
                        timeout_seconds=self.first_room_entry_timeout,
                        rooms_entered=len(self.rooms))
                    self._transition(
                        MissionPhase.FINISHED,
                        "first_room_entry_deadline_exceeded")
                    break
                if self.elapsed() >= self.maximum_duration:
                    self.termination_reason = "safety_timeout"
                    self.exploration_complete = False
                    self._transition(MissionPhase.FINISHED, "1800_second_safety_limit")
                    break
                self._update_topology()
                self._dispatch()
                if time.monotonic() - self.last_artifact_write >= 10.0:
                    self.last_artifact_write = time.monotonic()
                    self._write_artifacts()
        except Exception as error:  # preserve complete diagnostics on runtime faults
            self.termination_reason = "exception:" + type(error).__name__
            self.exploration_complete = False
            rospy.logerr("Structured exploration exception: %r", error)
            self._event("runtime_exception", error=repr(error))
            self.phase = MissionPhase.FINISHED
        finally:
            snapshot_ok = self._request_final_voxel_snapshot()
            if snapshot_ok:
                self.actual_trajectory_validation = self._audit_actual_trajectory()
            else:
                self.actual_trajectory_validation = {
                    "performed": False, "safe": False,
                    "reason": "final_voxel_snapshot_unavailable",
                }
            if self.exploration_complete and not snapshot_ok:
                self.exploration_complete = False
                self.termination_reason = "final_voxel_snapshot_failed"
            elif self.exploration_complete and not self.actual_trajectory_validation.get(
                    "safe", False):
                self.exploration_complete = False
                self.termination_reason = "final_actual_trajectory_validation_failed"
            self._write_artifacts()
            self.finalized = True
            self.complete_pub.publish(Bool(
                data=bool(self._summary()["exploration_complete"])))

    def _shutdown(self) -> None:
        if not self.finalized:
            if self.termination_reason is None:
                self.termination_reason = "ros_shutdown"
            self._write_artifacts()


if __name__ == "__main__":
    rospy.init_node("structured_exploration_manager")
    StructuredExplorationManager().run()
