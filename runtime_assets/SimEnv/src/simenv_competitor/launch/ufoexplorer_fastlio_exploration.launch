<launch>
  <!-- FAST-LIO/UFOMap/UFOExplorer generate exploration paths only.
       Execution remains UFO path adapter -> FAR/A* -> SCAN-lite -> Goal
       Executor -> RL locomotion. No TARE node and no UFO velocity controller
       are started by this launch. -->
  <arg name="output_dir"
       default="$(find simenv_competitor)/../../results/ufoexplorer_run1"/>
  <arg name="world_file"
       default="$(find simenv_competitor)/../../generated_building/competition_scene.world"/>
  <arg name="rl_policy"
       default="$(find unitree_guide)/../../logs/policy_act_inference_stair.pt"/>
  <arg name="maximum_duration" default="700.0"/>
  <arg name="explorer_backend" default="ufoexplorer"/>
  <arg name="start_native_ufoexplorer" default="true"/>
  <!-- This repository always provides the online A* fallback. Enable the
       external Official FAR process only when its workspace is sourced. -->
  <arg name="start_official_far" default="false"/>
  <arg name="world_frame" default="map"/>
  <arg name="robot_spawn_x" default="0.0"/>
  <arg name="robot_spawn_y" default="0.8"/>
  <arg name="robot_spawn_z" default="0.6"/>
  <arg name="robot_spawn_yaw" default="1.5708"/>
  <arg name="backend_config"
       default="$(find simenv_competitor)/config/exploration_backend.yaml"/>

  <rosparam command="load" file="$(arg backend_config)"/>
  <param name="/explorer_backend" value="$(arg explorer_backend)"/>

  <include file="$(find simenv_competitor)/launch/fastlio_mapping.launch">
    <arg name="output_dir" value="$(arg output_dir)"/>
    <arg name="world_file" value="$(arg world_file)"/>
    <arg name="rl_policy" value="$(arg rl_policy)"/>
    <arg name="robot_spawn_x" value="$(arg robot_spawn_x)"/>
    <arg name="robot_spawn_y" value="$(arg robot_spawn_y)"/>
    <arg name="robot_spawn_z" value="$(arg robot_spawn_z)"/>
    <arg name="robot_spawn_yaw" value="$(arg robot_spawn_yaw)"/>
  </include>

  <node pkg="simenv_competitor" type="ufo_map_bridge.py"
        name="ufo_map_bridge" output="screen" required="true">
    <param name="map_frame" value="$(arg world_frame)"/>
    <param name="base_frame" value="base_link"/>
    <param name="odom_topic" value="/Odometry"/>
    <param name="cloud_topic" value="/cloud_registered"/>
    <param name="output_cloud_topic" value="/simenv/ufo/cloud_filtered"/>
    <param name="output_odom_topic" value="/simenv/ufo/odometry"/>
    <param name="ufo_cloud_range" value="8.0"/>
    <param name="min_z" value="-0.5"/>
    <param name="max_z" value="2.5"/>
    <param name="maximum_cloud_rate" value="5.0"/>
  </node>

  <group if="$(arg start_native_ufoexplorer)">
    <node pkg="ufomap_mapping" type="ufomap_mapping_server_node"
          name="ufomap_mapping_server_node" output="screen" required="true">
      <remap from="cloud_in" to="/simenv/ufo/cloud_filtered"/>
      <param name="frame_id" value="$(arg world_frame)"/>
      <param name="resolution" value="0.10"/>
      <param name="depth_levels" value="16"/>
      <param name="color_map" value="false"/>
      <param name="max_range" value="8.0"/>
      <param name="insert_depth" value="1"/>
      <param name="simple_ray_casting" value="true"/>
      <param name="clear_robot" value="true"/>
      <param name="robot_frame_id" value="base_link"/>
      <param name="robot_radius" value="0.45"/>
      <param name="robot_height" value="0.65"/>
      <param name="clearing_depth" value="1"/>
      <param name="update_part_of_map" value="true"/>
      <param name="update_rate" value="5.0"/>
      <param name="publish_depth" value="1"/>
      <param name="pub_rate" value="0.2"/>
      <param name="map_queue_size" value="10"/>
    </node>

    <node pkg="ufoexplorer" type="ufoexplorer_node"
          name="ufoexplorer_graph_node" output="screen" required="true">
      <!-- Verified from upstream Explorer: map_in is UFOMapStamped, odom is
           nav_msgs/Odometry, and the patched private path is nav_msgs/Path. -->
      <remap from="map_in" to="/ufomap_mapping_server_node/map_depth_1"/>
      <remap from="odom" to="/simenv/ufo/odometry"/>
      <param name="start_immediately" value="true"/>
      <param name="exit_at_complete" value="false"/>
      <param name="graph/max_num_neighbors" value="2"/>
      <param name="graph/max_neighbor_dist" value="1.0"/>
      <param name="graph/max_edge_length" value="1.25"/>
      <!-- Use UFOExplorer's native closest-gain graph path for this local
           execution architecture; a full multi-cluster TSP tour is neither
           required nor handed to the executor in one batch. -->
      <param name="graph/max_exact_tsp" value="1"/>
      <param name="graph/zero_gain_fallback" value="true"/>
      <param name="map/automatic_pruning" value="false"/>
      <param name="map/occupied_thres" value="0.6"/>
      <param name="map/free_thres" value="0.5"/>
      <param name="map/collision_depth" value="1"/>
      <!-- UFO's 3-D default treats every vertically unobserved voxel as a
           collision. Ground LiDAR cannot clear that volume densely. The
           executable path remains constrained by the 2-D known-free map,
           online A*/FAR, and SCAN-lite below. -->
      <param name="map/collision_unknown_as_occupied" value="false"/>
      <param name="map/gain_depth" value="1"/>
      <!-- Online safety extent only; these are not room/layout coordinates. -->
      <rosparam param="map/bbx_min">[-50.0, -50.0, -1.0]</rosparam>
      <rosparam param="map/bbx_max">[50.0, 50.0, 3.0]</rosparam>
      <param name="map/continue_outside" value="true"/>
      <param name="robot/frame_id" value="base_link"/>
      <param name="robot/radius" value="0.45"/>
      <param name="robot/height" value="0.65"/>
      <!-- Ground-robot adapter: sample the FAST-LIO initialization plane
           rather than arbitrary airborne z values from the 3-D update AABB. -->
      <param name="robot/lock_sampling_height" value="true"/>
      <param name="robot/sampling_height" value="0.0"/>
      <param name="sensor/horizontal_fov" value="360.0"/>
      <param name="sensor/vertical_fov" value="90.0"/>
      <param name="sensor/range_min" value="0.3"/>
      <param name="sensor/range_max" value="8.0"/>
      <param name="min_gain_thres" value="0.2"/>
      <param name="verbose" value="false"/>
    </node>
  </group>

  <node pkg="simenv_competitor" type="ufo_corridor_semantic.py"
        name="ufo_corridor_semantic" output="screen">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="odom_topic" value="/simenv/ufo/odometry"/>
    <param name="map_topic" value="/simenv/voxel_floor_projection"/>
    <param name="search_radius" value="8.0"/>
    <param name="minimum_width" value="1.0"/>
    <param name="maximum_width" value="4.0"/>
    <param name="minimum_visible_length" value="4.0"/>
    <param name="confirmation_frames" value="3"/>
    <param name="angle_step_degrees" value="10.0"/>
  </node>

  <!-- Layout-free side-room queue.  A mission is admitted only after three
       map updates show a door-width aperture and a larger reachable region
       beyond it.  It executes depth + left breadth + right breadth, then
       returns through the remembered entry portal. -->
  <node pkg="simenv_competitor" type="ufo_room_semantic_scheduler.py"
        name="ufo_room_semantic_scheduler" output="screen">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="world_frame" value="$(arg world_frame)"/>
    <param name="odom_topic" value="/simenv/ufo/odometry"/>
    <param name="map_topic" value="/simenv/voxel_floor_projection"/>
    <param name="enabled" value="true"/>
    <param name="doorway_width_min" value="0.75"/>
    <param name="doorway_width_max" value="2.30"/>
    <param name="expansion_margin" value="0.80"/>
    <param name="candidate_confirmation_count" value="3"/>
    <param name="entry_depth" value="1.50"/>
    <param name="side_depth" value="3.00"/>
    <param name="minimum_goal_separation" value="1.00"/>
    <param name="coverage_minimum_observations" value="3"/>
    <param name="room_budget_seconds" value="75.0"/>
  </node>

  <node pkg="simenv_competitor" type="ufoexplorer_interface.py"
        name="ufoexplorer_interface" output="screen" required="true">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="world_frame" value="$(arg world_frame)"/>
    <param name="raw_path_topic" value="/ufoexplorer_graph_node/path"/>
    <param name="raw_goal_topic" value="/ufoexplorer/goal"/>
    <param name="odom_topic" value="/simenv/ufo/odometry"/>
    <param name="map_topic" value="/simenv/voxel_floor_projection"/>
    <param name="map_file" value="$(arg output_dir)/voxel_map.bt"/>
    <param name="ufo_output_timeout" value="5.0"/>
    <param name="ufo_failure_limit" value="3"/>
    <param name="fallback_recover_after_seconds" value="30.0"/>
    <param name="corridor_path_selection_window" value="1.0"/>
    <param name="corridor_semantic_startup_wait" value="6.0"/>
    <rosparam param="explorer_fallback_order">
      [ufoexplorer, fuel_lite, astar_frontier]
    </rosparam>
  </node>

  <node pkg="simenv_competitor" type="ufo_path_adapter.py"
        name="ufo_path_adapter" output="screen" required="true">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="world_frame" value="$(arg world_frame)"/>
    <param name="odom_topic" value="/simenv/ufo/odometry"/>
    <param name="map_topic" value="/simenv/voxel_floor_projection"/>
    <param name="output_goal_topic" value="/ufo_local_exploration_goal"/>
    <param name="min_effective_waypoint_distance" value="0.6"/>
    <param name="max_local_execution_horizon" value="3.0"/>
    <param name="waypoint_spacing" value="0.45"/>
    <param name="scan_service"
           value="/tare_far_voxel_mapper/check_twin_cylinder"/>
  </node>

  <include file="$(find simenv_competitor)/launch/far_navigation.launch">
    <arg name="output_dir" value="$(arg output_dir)"/>
    <arg name="maximum_duration" value="$(arg maximum_duration)"/>
    <arg name="world_frame" value="$(arg world_frame)"/>
    <arg name="tare_goal_topic" value="/ufo_local_exploration_goal"/>
    <arg name="odom_topic" value="/simenv/ufo/odometry"/>
    <arg name="start_official_far" value="$(arg start_official_far)"/>
  </include>

  <include file="$(find simenv_competitor)/launch/goal_executor.launch">
    <arg name="output_dir" value="$(arg output_dir)"/>
    <arg name="start_rl_mode" value="true"/>
    <arg name="shutdown_on_result" value="false"/>
    <arg name="command_topic" value="/cmd_vel"/>
    <arg name="odom_topic" value="/simenv/ufo/odometry"/>
    <arg name="enable_takeover_monitor" value="false"/>
    <arg name="enable_rl_guard" value="false"/>
    <arg name="arm_rl_guard" value="false"/>
    <arg name="goal_tolerance" value="0.15"/>
    <arg name="minimum_speed" value="0.32"/>
    <arg name="maximum_speed" value="0.42"/>
    <arg name="acceleration" value="0.24"/>
    <arg name="log_file" value="goal_execution_history.json"/>
  </include>

  <node pkg="simenv_competitor" type="velocity_watchdog.py"
        name="velocity_watchdog" output="screen">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="odom_topic" value="/simenv/ufo/odometry"/>
    <param name="stall_timeout" value="5.0"/>
    <param name="linear_threshold" value="0.03"/>
    <param name="angular_threshold" value="0.05"/>
    <param name="displacement_threshold" value="0.05"/>
  </node>

  <node pkg="simenv_competitor" type="ufoexplorer_status_monitor.py"
        name="ufoexplorer_status_monitor" output="screen">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="odom_topic" value="/simenv/ufo/odometry"/>
  </node>

  <node pkg="simenv_competitor" type="baseline_telemetry.py"
        name="ufoexplorer_telemetry" output="screen" required="false">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="ground_truth_topic" value="/gazebo/model_states"/>
    <param name="ground_truth_model" value="a1_gazebo"/>
  </node>
</launch>
