<launch>
  <!-- Step 2.1 only: the verified Room0 RL + FAST-LIO route plus an OctoMap
       occupancy mapper. No frontier, navigation, goal planning or DWA. -->
  <arg name="output_dir"/>
  <arg name="resolution" default="0.15"/>
  <arg name="rl_policy"
       default="$(find unitree_guide)/../../logs/policy_act_inference_stair.pt"/>
  <arg name="mapping_controller_required" default="true"/>
  <arg name="rl_guard_recovery_minimum_height" default="0.285"/>

  <include file="$(find simenv_competitor)/launch/room0_official_rl_mapping.launch">
    <arg name="output_dir" value="$(arg output_dir)"/>
    <arg name="rl_policy" value="$(arg rl_policy)"/>
    <arg name="route_waypoint_limit" value="0"/>
    <arg name="mapping_controller_required" value="$(arg mapping_controller_required)"/>
    <arg name="rl_guard_recovery_minimum_height"
         value="$(arg rl_guard_recovery_minimum_height)"/>
  </include>

  <node pkg="simenv_competitor" type="fastlio_voxel_mapper"
        name="fastlio_voxel_mapper" output="screen" required="false">
    <param name="cloud_topic" value="/cloud_registered"/>
    <param name="odom_topic" value="/Odometry"/>
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="resolution" value="$(arg resolution)"/>
    <param name="minimum_range" value="0.30"/>
    <param name="maximum_range" value="30.0"/>
    <param name="maximum_scan_points" value="12000"/>
    <param name="save_every_updates" value="20"/>
    <param name="hit_probability" value="0.70"/>
    <param name="miss_probability" value="0.40"/>
    <param name="occupancy_threshold" value="0.50"/>
  </node>
</launch>
