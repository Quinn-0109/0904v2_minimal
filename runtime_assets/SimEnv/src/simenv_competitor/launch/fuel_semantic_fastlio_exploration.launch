<launch>
  <!-- ROS normally prefixes every line with the global Gazebo simulation
       clock.  That clock includes startup and must not be confused with the
       mission budget, which is printed explicitly as [MISSION] t=... below. -->
  <env name="ROSCONSOLE_FORMAT" value="[${severity}] ${message}"/>
  <!-- Gazebo server must inherit this too: RGB-D rendering is server-side. -->
  <env name="DISPLAY" value=":99"/>
  <!-- Production FUEL semantic chain.  UFOMap/UFOExplorer and TARE are not
       started.  Online semantics only rank/commit FUEL candidates; execution
       remains A* + SCAN-lite + Goal Executor + RL locomotion. -->
  <arg name="output_dir"
       default="$(find simenv_competitor)/../../results/fuel_semantic_run1"/>
  <arg name="maximum_duration" default="400.0"/>
  <arg name="first_floor_room_phase_target_seconds" default="150.0"/>
  <arg name="first_floor_room_phase_deadline_minimum_exited_rooms" default="4"/>
  <arg name="first_floor_room_phase_deadline_hard_overrun_seconds" default="250.0"/>
  <arg name="first_floor_room_entry_replan_wait_seconds" default="1.5"/>
  <!-- ENTRY has already crossed an A*/SCAN-lite verified portal.  One fresh
       in-memory projection callback is sufficient to replan G3; waiting for
       three callbacks added up to 1.5 simulated seconds in every run153 room
       without changing the selected endpoint.  G3/G4 still perform their
       mandatory physical motion and >=210-degree visual sweeps. -->
  <arg name="first_floor_room_entry_replan_minimum_grid_updates" default="1"/>
  <arg name="maximum_goals" default="100"/>
  <arg name="enable_second_floor_exploration" default="true"/>
  <!-- Upper-floor room discovery starts only after stair settling, corridor
       ingress and localization recovery. Keep a generous floor-local budget
       while validating the complete four-room route. -->
  <arg name="second_floor_maximum_duration" default="400.0"/>
  <arg name="second_floor_pre_handoff_wait_timeout_sec" default="0.0"/>
  <arg name="second_floor_maximum_goals" default="100"/>
  <arg name="enable_third_floor_exploration" default="true"/>
  <arg name="enable_third_floor_descent" default="true"/>
  <!-- Explicitly expose the accepted F3->F1 profile at the public full-flow
       entry point so a nested-launch default cannot silently drift. -->
  <arg name="descent_speed_mps" default="0.52"/>
  <arg name="descent_maximum_speed_mps" default="0.52"/>
  <arg name="descent_segment_timeout_sec" default="120.0"/>
  <arg name="descent_pre_stand_seconds" default="1.5"/>
  <arg name="truth_descent_landing_heading_tolerance_rad" default="0.28"/>
  <arg name="truth_descent_landing_settle_seconds" default="1.5"/>
  <arg name="truth_descent_landing_yaw_stall_sec" default="2.5"/>
  <arg name="truth_descent_step_pause_seconds" default="0.10"/>
  <arg name="first_floor_home_return_wall_timeout_sec" default="180.0"/>
  <!-- A first-floor acceptance run keeps the real detector and locomotion
       stack, but may disable passive whole-map logging and stop at the stair
       entrance. These switches do not alter the simulator or sensor model. -->
  <arg name="enable_truth_lidar_coverage_logger" default="false"/>
  <arg name="first_floor_auto_generate_visualization" default="false"/>
  <arg name="enable_visual_coverage_mapper" default="false"/>
  <arg name="stair_approach_only" default="false"/>
  <arg name="second_to_third_stair_approach_only" default="false"/>
  <arg name="third_floor_maximum_duration" default="400.0"/>
  <arg name="third_floor_maximum_goals" default="100"/>
  <arg name="enable_third_floor_truth_corridor_guide" default="true"/>
  <arg name="third_floor_truth_corridor_guide_timeout_sec" default="45.0"/>
  <arg name="third_floor_pre_handoff_wait_timeout_sec" default="0.0"/>
  <arg name="enable_second_floor_truth_corridor_guide" default="true"/>
  <arg name="second_floor_truth_corridor_guide_timeout_sec" default="45.0"/>
  <arg name="second_floor_truth_corridor_ingress_depth_m" default="1.0"/>
  <!-- Keep the preload experiment available, but do not enable it by
       default.  run117 shortened stair-to-corridor handoff by 10.6 sim s,
       then spent 21.5 sim s extra in the F2 room phase (including a 50.7 s
       wait for the first ENTRY).  The proven live floor-local map is faster
       end-to-end until preload can be installed as a planning-neutral seed. -->
  <arg name="truth_pose_authoritative_fast_handoff" default="false"/>
  <arg name="preloaded_map_file"
       default=""/>
  <arg name="preloaded_map_manifest"
       default=""/>
  <arg name="enable_realsense" default="true"/>
  <!-- Optional dog-eye RGB recording. It is disabled by default so ordinary
       benchmark runs retain their current CPU and disk profile. -->
  <arg name="record_rgb_video" default="false"/>
  <arg name="rgb_video_fps" default="5.0"/>
  <arg name="rgb_video_codec" default="mp4v"/>
  <arg name="rgb_video_overlay_phase" default="true"/>
  <!-- Starts a virtual-display Gazebo client so the RGB-D depth camera can
       render. This is startup/simulator work, not mission planning time. -->
  <arg name="gazebo_gui" default="false"/>
  <arg name="enable_danger_detection" default="true"/>
  <!-- The validated 135 to 150 s room profile uses the 12 Hz classical RGB-D
       detector from baseline_fastlio_exploration.launch. Keep YOLO as an
       explicit A/B option; never start both front ends in one run. -->
  <arg name="use_optimized_builtin_danger_pipeline" default="true"/>
  <arg name="enable_yolo_semantic_detection" default="false"/>
  <arg name="enable_classical_red_ball_detection" default="false"/>
  <arg name="yolo_semantic_model_path"
       default="$(find simenv_competitor)/../../model/red_ball_yolov8s/weights/best.pt"/>
  <arg name="yolo_semantic_python_executable"
       default="/root/miniconda3/bin/python3"/>
  <arg name="yolo_semantic_python_site_packages"
       default="/root/miniconda3/lib/python3.8/site-packages"/>
  <arg name="yolo_semantic_device" default="auto"/>
  <arg name="yolo_semantic_processing_rate" default="2.0"/>
  <arg name="yolo_publish_red_ball_observations" default="true"/>
  <!-- The active RGB-D detector/tracker below is the production path.  Keep
       the older detector opt-in only for A/B diagnostics, not parallel work. -->
  <arg name="enable_legacy_danger_detector" default="false"/>
  <!-- The full mission now uses the same motion envelope as the nine
       validated 135-150 s floor-local runs.  Per-goal room/corridor limits
       remain stricter where lateral or yaw load is combined. -->
  <arg name="goal_executor_minimum_speed" default="0.65"/>
  <arg name="goal_executor_maximum_speed" default="2.00"/>
  <arg name="goal_executor_dynamic_speed_cap"
       default="$(arg goal_executor_maximum_speed)"/>
  <arg name="goal_executor_distance_gain" default="0.40"/>
  <arg name="goal_executor_heading_gain" default="0.0"/>
  <arg name="goal_executor_maximum_yaw_rate" default="0.35"/>
  <arg name="goal_executor_maximum_visual_sweep_angular_speed" default="2.10"/>
  <arg name="goal_executor_visual_sweep_completion_tolerance_rad" default="0.08"/>
  <arg name="goal_executor_lateral_speed_limit"
       default="$(arg goal_executor_maximum_speed)"/>
  <arg name="goal_executor_heading_slowdown_threshold" default="0.45"/>
  <arg name="goal_executor_turning_speed_limit" default="1.20"/>
  <arg name="goal_executor_navigation_turning_translation_limit_mps" default="0.90"/>
  <arg name="goal_executor_navigation_turning_lateral_limit_mps" default="0.30"/>
  <arg name="goal_executor_localization_degraded_speed_cap" default="1.20"/>
  <!-- The exact-lock portal, sparse EXIT and bounded partial-room recovery
       are now part of the full flow.  Reuse the floor-local throughput
       envelope here instead of silently falling back to the old 0.75 m/s
       room profile.  The doorway lateral/yaw and dense 3-D audits remain
       stricter than the straight-line speed request. -->
  <!-- The plane gait becomes intermittently unstable above about 1.2 m/s
       during furniture-side turns. run156 physically fell in room 2 at
       1.49 m/s, then revisited aliases and lost more than 100 simulation
       seconds. Straight corridor travel retains its separate fast envelope. -->
  <arg name="goal_executor_room_transaction_degraded_speed_cap" default="1.35"/>
  <arg name="goal_executor_room_exit_degraded_speed_cap" default="1.35"/>
  <arg name="goal_executor_return_degraded_speed_cap" default="1.20"/>
  <!-- 1.35 m/s corridor degraded cap was tested in the latest A/B and
       stopped F1 after only one room with unstable replanning. Keep the
       validated 1.20 m/s corridor envelope until a complete regression
       proves a faster value without sacrificing four-room completion. -->
  <arg name="goal_executor_corridor_degraded_speed_cap" default="1.20"/>
  <arg name="goal_executor_acceleration" default="1.00"/>
  <arg name="goal_executor_deceleration" default="1.20"/>
  <arg name="goal_executor_preemption_deceleration" default="1.10"/>
  <arg name="goal_executor_preemption_timeout" default="1.50"/>
  <!-- These are the repeatedly exercised corridor_rooms_140s motion
       settings.  They are exposed at the public full-flow entry point so
       F1 and freshly-created F2/F3 managers receive one policy. -->
  <arg name="first_floor_room_entry_speed" default="1.20"/>
  <arg name="first_floor_room_lateral_speed_limit" default="0.30"/>
  <arg name="first_floor_room_open_transition_speed" default="1.20"/>
  <arg name="first_floor_room_open_transition_lateral_speed" default="0.30"/>
  <!-- run156 disproved the former 1.9 m/s room envelope: room 2 fell at
       1.49 m/s and then revisited aliases. Keep every F1 furniture/portal
       maneuver inside the measured stable envelope. -->
  <arg name="first_floor_room_exit_speed" default="0.95"/>
  <arg name="first_floor_room_exit_lateral_speed_limit" default="0.30"/>
  <arg name="first_floor_room_fast_exit_approach_speed" default="1.10"/>
  <arg name="first_floor_room_fast_exit_lateral_speed_limit" default="0.30"/>
  <arg name="first_floor_room_portal_crossing_speed" default="0.90"/>
  <arg name="first_floor_room_portal_crossing_lateral_speed" default="0.20"/>
  <arg name="first_floor_room_obstacle_transition_speed" default="0.90"/>
  <arg name="first_floor_room_obstacle_transition_minimum_speed" default="0.30"/>
  <arg name="first_floor_room_obstacle_transition_lateral_speed" default="0.25"/>
  <arg name="first_floor_room_obstacle_transition_heading_gain" default="0.80"/>
  <arg name="first_floor_room_obstacle_transition_maximum_yaw_rate" default="0.35"/>
  <arg name="first_floor_room_obstacle_transition_distance_gain" default="0.85"/>
  <arg name="first_floor_room_two_pose_blended_turn_maximum_yaw_rate" default="0.75"/>
  <arg name="first_floor_room_exit_blended_turn_maximum_yaw_rate" default="0.55"/>
  <arg name="first_floor_room_exit_corridor_extension_m" default="0.35"/>
  <!-- Full F1-to-F3 mission requires the preserved three-floor scene.  Its
       lower two floors are copied from the already validated artifact, so
       enabling floor 3 does not change F1/F2 walls, rooms or furniture.  The
       former competition_scene.world contains only the stairwell shell and
       no physical treads, so a stair policy cannot climb it. -->
  <arg name="world_file"
       default="$(find simenv_competitor)/../../generated_building/elevator_three_floor_official_count/competition_scene_with_dangers.world"/>
  <arg name="rl_policy"
       default="$(find unitree_guide)/../../logs/policy_act_inference_plane.pt"/>
  <arg name="plane_rl_action_scale" default="0.25"/>
  <arg name="two_flight_stair" default="true"/>
  <arg name="stair_ascent_timeout_sec" default="45.0"/>
  <arg name="upper_landing_clearance_grace_sec" default="15.0"/>
  <arg name="stair_truth_entry_guide" default="true"/>
  <arg name="second_to_third_flight_b_timeout_sec" default="120.0"/>
  <arg name="second_to_third_flight_b_recovery_heading_error_rad" default="0.15"/>
  <arg name="second_to_third_flight_b_recovery_release_heading_error_rad" default="0.08"/>
  <arg name="second_to_third_flight_b_stall_policy_reset" default="true"/>
  <arg name="second_to_third_flight_b_stall_nudge_enabled" default="false"/>
  <arg name="second_to_third_flight_b_stall_nudge_after_recoveries" default="1"/>
  <arg name="second_to_third_flight_b_stall_nudge_forward_m" default="0.260"/>
  <arg name="second_to_third_flight_b_stall_nudge_upward_m" default="0.130"/>
  <arg name="enable_visual_corridor_to_stair_entry" default="false"/>
  <arg name="stair_truth_entry_timeout_sec" default="60.0"/>
  <arg name="stair_truth_entry_corridor_max_speed_mps" default="1.60"/>
  <arg name="stair_truth_entry_side_max_speed_mps" default="1.00"/>
  <arg name="stair_truth_entry_final_max_speed_mps" default="0.55"/>
  <arg name="stair_truth_side_entry_offset_m" default="1.65"/>
  <!-- Four first-floor ROOM_EXIT confirmations hand control directly to the
       corridor-entry/stair stage.  The truth-entry flag below only chooses
       how the stair controller reaches the physical first tread. -->
  <arg name="stair_handoff_on_corridor_exit" default="true"/>

  <include file="$(find simenv_competitor)/launch/baseline_fastlio_exploration.launch">
    <arg name="output_dir" value="$(arg output_dir)"/>
    <arg name="maximum_duration" value="$(arg maximum_duration)"/>
    <arg name="first_floor_room_phase_target_seconds"
         value="$(arg first_floor_room_phase_target_seconds)"/>
    <arg name="first_floor_room_phase_deadline_minimum_exited_rooms"
         value="$(arg first_floor_room_phase_deadline_minimum_exited_rooms)"/>
    <arg name="first_floor_room_phase_deadline_hard_overrun_seconds"
         value="$(arg first_floor_room_phase_deadline_hard_overrun_seconds)"/>
    <arg name="first_floor_room_entry_replan_wait_seconds"
         value="$(arg first_floor_room_entry_replan_wait_seconds)"/>
    <arg name="first_floor_room_entry_replan_minimum_grid_updates"
         value="$(arg first_floor_room_entry_replan_minimum_grid_updates)"/>
    <arg name="maximum_goals" value="$(arg maximum_goals)"/>
    <arg name="enable_second_floor_exploration"
         value="$(arg enable_second_floor_exploration)"/>
    <arg name="second_floor_maximum_duration"
         value="$(arg second_floor_maximum_duration)"/>
    <arg name="second_floor_pre_handoff_wait_timeout_sec"
         value="$(arg second_floor_pre_handoff_wait_timeout_sec)"/>
    <arg name="second_floor_maximum_goals"
         value="$(arg second_floor_maximum_goals)"/>
    <arg name="enable_third_floor_exploration"
         value="$(arg enable_third_floor_exploration)"/>
    <arg name="enable_third_floor_descent"
         value="$(arg enable_third_floor_descent)"/>
    <arg name="descent_speed_mps" value="$(arg descent_speed_mps)"/>
    <arg name="descent_maximum_speed_mps"
         value="$(arg descent_maximum_speed_mps)"/>
    <arg name="descent_segment_timeout_sec"
         value="$(arg descent_segment_timeout_sec)"/>
    <arg name="descent_pre_stand_seconds"
         value="$(arg descent_pre_stand_seconds)"/>
    <arg name="truth_descent_landing_heading_tolerance_rad"
         value="$(arg truth_descent_landing_heading_tolerance_rad)"/>
    <arg name="truth_descent_landing_settle_seconds"
         value="$(arg truth_descent_landing_settle_seconds)"/>
    <arg name="truth_descent_landing_yaw_stall_sec"
         value="$(arg truth_descent_landing_yaw_stall_sec)"/>
    <arg name="truth_descent_step_pause_seconds"
         value="$(arg truth_descent_step_pause_seconds)"/>
    <arg name="first_floor_home_return_wall_timeout_sec"
         value="$(arg first_floor_home_return_wall_timeout_sec)"/>
    <arg name="enable_truth_lidar_coverage_logger" value="$(arg enable_truth_lidar_coverage_logger)"/>
    <arg name="first_floor_auto_generate_visualization"
         value="$(arg first_floor_auto_generate_visualization)"/>
    <arg name="stair_approach_only" value="$(arg stair_approach_only)"/>
    <arg name="second_to_third_stair_approach_only"
         value="$(arg second_to_third_stair_approach_only)"/>
    <arg name="third_floor_maximum_duration"
         value="$(arg third_floor_maximum_duration)"/>
    <arg name="third_floor_maximum_goals"
         value="$(arg third_floor_maximum_goals)"/>
    <arg name="enable_third_floor_truth_corridor_guide"
         value="$(arg enable_third_floor_truth_corridor_guide)"/>
    <arg name="third_floor_truth_corridor_guide_timeout_sec"
         value="$(arg third_floor_truth_corridor_guide_timeout_sec)"/>
    <arg name="third_floor_pre_handoff_wait_timeout_sec"
         value="$(arg third_floor_pre_handoff_wait_timeout_sec)"/>
    <arg name="enable_second_floor_truth_corridor_guide"
         value="$(arg enable_second_floor_truth_corridor_guide)"/>
    <arg name="second_floor_truth_corridor_guide_timeout_sec"
         value="$(arg second_floor_truth_corridor_guide_timeout_sec)"/>
    <arg name="second_floor_truth_corridor_ingress_depth_m"
         value="$(arg second_floor_truth_corridor_ingress_depth_m)"/>
    <arg name="truth_pose_authoritative_fast_handoff"
         value="$(arg truth_pose_authoritative_fast_handoff)"/>
    <arg name="preloaded_map_file" value="$(arg preloaded_map_file)"/>
    <arg name="preloaded_map_manifest" value="$(arg preloaded_map_manifest)"/>
    <arg name="enable_realsense" value="$(arg enable_realsense)"/>
    <arg name="enable_builtin_danger_pipeline"
         value="$(eval arg('enable_danger_detection') and arg('use_optimized_builtin_danger_pipeline'))"/>
    <arg name="enable_recording_camera" value="$(arg record_rgb_video)"/>
    <arg name="recording_camera_update_rate" value="$(arg rgb_video_fps)"/>
    <arg name="gazebo_gui" value="$(arg gazebo_gui)"/>
    <arg name="goal_executor_minimum_speed"
         value="$(arg goal_executor_minimum_speed)"/>
    <arg name="goal_executor_maximum_speed"
         value="$(arg goal_executor_maximum_speed)"/>
    <arg name="goal_executor_dynamic_speed_cap"
         value="$(arg goal_executor_dynamic_speed_cap)"/>
    <arg name="goal_executor_distance_gain"
         value="$(arg goal_executor_distance_gain)"/>
    <arg name="goal_executor_heading_gain"
         value="$(arg goal_executor_heading_gain)"/>
    <arg name="goal_executor_maximum_yaw_rate"
         value="$(arg goal_executor_maximum_yaw_rate)"/>
    <arg name="goal_executor_lateral_speed_limit"
         value="$(arg goal_executor_lateral_speed_limit)"/>
    <arg name="goal_executor_maximum_visual_sweep_angular_speed"
         value="$(arg goal_executor_maximum_visual_sweep_angular_speed)"/>
    <arg name="goal_executor_visual_sweep_completion_tolerance_rad"
         value="$(arg goal_executor_visual_sweep_completion_tolerance_rad)"/>
    <arg name="goal_executor_navigation_turning_translation_limit_mps"
         value="$(arg goal_executor_navigation_turning_translation_limit_mps)"/>
    <arg name="goal_executor_navigation_turning_lateral_limit_mps"
         value="$(arg goal_executor_navigation_turning_lateral_limit_mps)"/>
    <arg name="goal_executor_heading_slowdown_threshold"
         value="$(arg goal_executor_heading_slowdown_threshold)"/>
    <arg name="goal_executor_turning_speed_limit"
         value="$(arg goal_executor_turning_speed_limit)"/>
    <arg name="goal_executor_localization_degraded_speed_cap"
         value="$(arg goal_executor_localization_degraded_speed_cap)"/>
    <arg name="goal_executor_room_transaction_degraded_speed_cap"
         value="$(arg goal_executor_room_transaction_degraded_speed_cap)"/>
    <arg name="goal_executor_room_exit_degraded_speed_cap"
         value="$(arg goal_executor_room_exit_degraded_speed_cap)"/>
    <arg name="goal_executor_return_degraded_speed_cap"
         value="$(arg goal_executor_return_degraded_speed_cap)"/>
    <arg name="goal_executor_corridor_degraded_speed_cap"
         value="$(arg goal_executor_corridor_degraded_speed_cap)"/>
    <arg name="goal_executor_acceleration"
         value="$(arg goal_executor_acceleration)"/>
    <arg name="goal_executor_deceleration"
         value="$(arg goal_executor_deceleration)"/>
    <arg name="goal_executor_preemption_deceleration"
         value="$(arg goal_executor_preemption_deceleration)"/>
    <arg name="goal_executor_preemption_timeout"
         value="$(arg goal_executor_preemption_timeout)"/>
    <arg name="first_floor_room_entry_speed"
         value="$(arg first_floor_room_entry_speed)"/>
    <arg name="first_floor_room_lateral_speed_limit"
         value="$(arg first_floor_room_lateral_speed_limit)"/>
    <arg name="first_floor_room_open_transition_speed"
         value="$(arg first_floor_room_open_transition_speed)"/>
    <arg name="first_floor_room_open_transition_lateral_speed"
         value="$(arg first_floor_room_open_transition_lateral_speed)"/>
    <arg name="first_floor_room_exit_speed"
         value="$(arg first_floor_room_exit_speed)"/>
    <arg name="first_floor_room_exit_lateral_speed_limit"
         value="$(arg first_floor_room_exit_lateral_speed_limit)"/>
    <arg name="first_floor_room_fast_exit_approach_speed"
         value="$(arg first_floor_room_fast_exit_approach_speed)"/>
    <arg name="first_floor_room_fast_exit_lateral_speed_limit"
         value="$(arg first_floor_room_fast_exit_lateral_speed_limit)"/>
    <arg name="first_floor_room_portal_crossing_speed"
         value="$(arg first_floor_room_portal_crossing_speed)"/>
    <arg name="first_floor_room_portal_crossing_lateral_speed"
         value="$(arg first_floor_room_portal_crossing_lateral_speed)"/>
    <arg name="first_floor_room_obstacle_transition_speed"
         value="$(arg first_floor_room_obstacle_transition_speed)"/>
    <arg name="first_floor_room_obstacle_transition_minimum_speed"
         value="$(arg first_floor_room_obstacle_transition_minimum_speed)"/>
    <arg name="first_floor_room_obstacle_transition_lateral_speed"
         value="$(arg first_floor_room_obstacle_transition_lateral_speed)"/>
    <arg name="first_floor_room_obstacle_transition_heading_gain"
         value="$(arg first_floor_room_obstacle_transition_heading_gain)"/>
    <arg name="first_floor_room_obstacle_transition_maximum_yaw_rate"
         value="$(arg first_floor_room_obstacle_transition_maximum_yaw_rate)"/>
    <arg name="first_floor_room_obstacle_transition_distance_gain"
         value="$(arg first_floor_room_obstacle_transition_distance_gain)"/>
    <arg name="first_floor_room_two_pose_blended_turn_maximum_yaw_rate"
         value="$(arg first_floor_room_two_pose_blended_turn_maximum_yaw_rate)"/>
    <arg name="first_floor_room_exit_blended_turn_maximum_yaw_rate"
         value="$(arg first_floor_room_exit_blended_turn_maximum_yaw_rate)"/>
    <arg name="first_floor_room_exit_corridor_extension_m"
         value="$(arg first_floor_room_exit_corridor_extension_m)"/>
    <arg name="world_file" value="$(arg world_file)"/>
    <arg name="rl_policy" value="$(arg rl_policy)"/>
    <arg name="plane_rl_action_scale" value="$(arg plane_rl_action_scale)"/>
    <arg name="two_flight_stair" value="$(arg two_flight_stair)"/>
    <arg name="stair_ascent_timeout_sec" value="$(arg stair_ascent_timeout_sec)"/>
    <arg name="upper_landing_clearance_grace_sec"
         value="$(arg upper_landing_clearance_grace_sec)"/>
    <arg name="stair_truth_entry_guide" value="$(arg stair_truth_entry_guide)"/>
    <arg name="second_to_third_flight_b_timeout_sec" value="$(arg second_to_third_flight_b_timeout_sec)"/>
    <arg name="second_to_third_flight_b_recovery_heading_error_rad" value="$(arg second_to_third_flight_b_recovery_heading_error_rad)"/>
    <arg name="second_to_third_flight_b_recovery_release_heading_error_rad" value="$(arg second_to_third_flight_b_recovery_release_heading_error_rad)"/>
    <arg name="second_to_third_flight_b_stall_policy_reset" value="$(arg second_to_third_flight_b_stall_policy_reset)"/>
    <arg name="second_to_third_flight_b_stall_nudge_enabled" value="$(arg second_to_third_flight_b_stall_nudge_enabled)"/>
    <arg name="second_to_third_flight_b_stall_nudge_after_recoveries" value="$(arg second_to_third_flight_b_stall_nudge_after_recoveries)"/>
    <arg name="second_to_third_flight_b_stall_nudge_forward_m" value="$(arg second_to_third_flight_b_stall_nudge_forward_m)"/>
    <arg name="second_to_third_flight_b_stall_nudge_upward_m" value="$(arg second_to_third_flight_b_stall_nudge_upward_m)"/>
    <arg name="enable_visual_corridor_to_stair_entry"
         value="$(arg enable_visual_corridor_to_stair_entry)"/>
    <arg name="stair_truth_entry_timeout_sec"
         value="$(arg stair_truth_entry_timeout_sec)"/>
    <arg name="stair_truth_entry_corridor_max_speed_mps"
         value="$(arg stair_truth_entry_corridor_max_speed_mps)"/>
    <arg name="stair_truth_entry_side_max_speed_mps"
         value="$(arg stair_truth_entry_side_max_speed_mps)"/>
    <arg name="stair_truth_entry_final_max_speed_mps"
         value="$(arg stair_truth_entry_final_max_speed_mps)"/>
    <arg name="stair_truth_side_entry_offset_m"
         value="$(arg stair_truth_side_entry_offset_m)"/>
    <arg name="stair_handoff_on_corridor_exit"
         value="$(arg stair_handoff_on_corridor_exit)"/>
    <arg name="offline_truth_layout_metadata"
         value="$(find simenv_competitor)/../../generated_building/elevator_three_floor_official_count/layout_metadata.json"/>
    <arg name="offline_stair_model_sdf"
         value="$(find simenv_competitor)/../../generated_building/elevator_three_floor_official_count/model.sdf"/>
    <arg name="stair_ascent_speed_mps" value="0.8"/>
    <arg name="stair_ascent_maximum_speed_mps" value="0.8"/>
    <arg name="config_file"
         value="$(find simenv_competitor)/config/fuel_semantic_fastlio_exploration.yaml"/>
    <arg name="navigation_odom_topic"
         value="/simenv/fastlio_stabilized_odometry"/>
  </include>

  <!-- Passive observer only: subscribes to the robot-mounted RGB camera and
       never publishes motion, planning, map, or mission-state messages. -->
  <node if="$(arg record_rgb_video)" pkg="simenv_competitor"
        type="rgb_video_recorder.py" name="rgb_video_recorder"
        output="screen" required="false">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="rgb_topic" value="/recording_camera/image_raw"/>
    <param name="fallback_rgb_topic" value="/real_sense/rgb/image_raw"/>
    <param name="source_stall_timeout_sec" value="1.5"/>
    <param name="video_fps" value="$(arg rgb_video_fps)"/>
    <param name="video_codec" value="$(arg rgb_video_codec)"/>
    <param name="overlay_phase" value="$(arg rgb_video_overlay_phase)"/>
    <param name="video_basename" value="robot_camera_rgb"/>
  </node>

  <!-- RGB-D is deliberately passive: it only evaluates frames while the
       room scheduler has an active room portal.  It never owns cmd_vel. -->
  <node if="$(arg enable_legacy_danger_detector)"
        pkg="simenv_competitor" type="danger_detector.py"
        name="danger_detector" output="screen" required="false">
    <param name="result_file" value="$(arg output_dir)/detected_danger.json"/>
    <param name="relative_result_file"
           value="$(arg output_dir)/detected_danger_relative.json"/>
    <param name="diagnostic_file"
           value="$(arg output_dir)/danger_detection_diagnostics.json"/>
    <param name="diagnostic_dir" value="$(arg output_dir)/danger_detection_debug"/>
    <param name="timeout_seconds" value="$(arg maximum_duration)"/>
    <param name="room_only_gate" value="true"/>
    <!-- At 5 Hz a fast doorway-to-G1 transit can yield only three frames of
         a ball.  Eight Hz still runs well below the RGB-D stream rate and
         confirms the same three-hit track before the return begins. -->
    <param name="processing_rate_hz" value="8.0"/>
    <param name="minimum_circularity" value="0.80"/>
    <param name="maximum_fill_ratio" value="0.83"/>
    <!-- FUEL's authoritative online localization stream is FAST-LIO.  This
         launch does not start the optional localization-health monitor. -->
    <param name="odom_topic" value="/simenv/fastlio_stabilized_odometry"/>
    <param name="require_localization_healthy" value="false"/>
    <param name="rgb_topic" value="/real_sense/rgb/image_raw"/>
    <param name="depth_topic" value="/real_sense/depth/image_raw"/>
    <param name="camera_fov_deg" value="60.0"/>
    <!-- The efficient room route can expose a sphere in only two
         well-separated frames before it returns to the doorway.  Both frames
         still pass colour, compact-depth, metric diameter and 3-D sphere
         checks, so this does not weaken those false-positive defences. -->
    <param name="minimum_hits" value="2"/>
    <param name="minimum_views" value="1"/>
    <param name="minimum_view_angle_deg" value="6.0"/>
    <!-- Room 2 accumulated 24 qualified hits but only 0.212 m translation
         on its short G1 pass. Keep a physical parallax gate while accepting
         that valid route. -->
    <param name="minimum_viewpoint_baseline_m" value="0.18"/>
    <!-- Far/oblique spheres become pixelated and can fall just below the
         ideal 2-D circle score.  Admit them to the subsequent RGB-D
         sphere-vs-plane test; red boxes still fail that geometric test,
         compact-depth check, metric diameter check, and multi-view gate. -->
    <param name="minimum_circularity" value="0.64"/>
    <param name="minimum_fill_ratio" value="0.58"/>
    <param name="minimum_extent" value="0.42"/>
    <param name="max_depth" value="6.5"/>
    <!-- The simulator's aligned depth is reliable to 6.5 m.  Keeping this
         below that limit recovers sphere observations from the normal G1
         transit without adding a stop or a camera sweep. -->
    <param name="max_detection_range" value="6.2"/>
    <!-- FAST-LIO's transient body pitch can bias the vertical projection of
         a floor-level sphere during a fast trot.  Shape, depth compactness,
         metric diameter, and multi-view confirmation remain mandatory, so a
         wider vertical acceptance avoids discarding valid spheres solely for
         that pose bias. -->
    <param name="world_z_min" value="-0.25"/>
    <param name="world_z_max" value="1.50"/>
  </node>

  <!-- Primary learned RGB-D detector. YOLOv8s supplies the red-ball class and
       bounding box; aligned depth plus FAST-LIO supply the map position. It
       publishes the same tracker topic as the former classical detector. -->
  <node if="$(eval arg('enable_danger_detection') and arg('enable_yolo_semantic_detection') and not arg('use_optimized_builtin_danger_pipeline'))"
        pkg="simenv_competitor" type="yolo_semantic_detector.py"
        name="yolo_semantic_detector" output="screen" required="false"
        respawn="true" respawn_delay="3.0"
        launch-prefix="$(arg yolo_semantic_python_executable)">
    <!-- env.sh must put ROS Debian modules on the global PYTHONPATH for the
         system-Python nodes.  A Conda-launched YOLO node must reverse that
         precedence or it imports Debian numpy 1.17 before its matching
         numpy/cv2/torch wheels.  Keep ROS modules available after the
         isolated Conda site-packages. -->
    <env name="PYTHONPATH"
         value="$(arg yolo_semantic_python_site_packages):/opt/ros/noetic/lib/python3/dist-packages:/usr/lib/python3/dist-packages"/>
    <!-- The RL/C++ stack exports a standalone libtorch directory globally.
         It is a different build from the Miniconda PyTorch used by
         Ultralytics; if it wins the loader search, torch._C lacks cuDNN ABI
         symbols such as has_cudnn.  Scope the matching wheel libraries to
         this process only, preserving the controller's global environment. -->
    <env name="LD_LIBRARY_PATH"
         value="$(arg yolo_semantic_python_site_packages)/torch/lib:$(env LD_LIBRARY_PATH)"/>
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="model_path" value="$(arg yolo_semantic_model_path)"/>
    <param name="python_site_packages"
           value="$(arg yolo_semantic_python_site_packages)"/>
    <param name="device" value="$(arg yolo_semantic_device)"/>
    <param name="confidence" value="0.35"/>
    <param name="red_ball_min_confidence" value="0.70"/>
    <param name="processing_rate_hz"
           value="$(arg yolo_semantic_processing_rate)"/>
    <param name="room_only_gate" value="true"/>
    <param name="publish_red_ball_observations"
           value="$(arg yolo_publish_red_ball_observations)"/>
    <param name="odom_topic" value="/simenv/fastlio_stabilized_odometry"/>
    <param name="rgb_topic" value="/real_sense/rgb/image_raw"/>
    <param name="depth_topic" value="/real_sense/depth/image_raw"/>
    <param name="camera_info_topic" value="/real_sense/rgb/camera_info"/>
    <param name="maximum_pose_sync_error_sec" value="0.20"/>
    <param name="maximum_depth_sync_error_sec" value="0.25"/>
    <param name="maximum_pose_jump_m" value="0.75"/>
    <param name="pose_jump_hold_seconds" value="1.0"/>
    <param name="max_depth" value="8.0"/>
  </node>

  <!-- Optional classical A/B fallback. It is disabled by default now that
       YOLO is authoritative. Never enable both front ends in one run. -->
  <node if="$(eval arg('enable_danger_detection') and arg('enable_classical_red_ball_detection') and not arg('enable_yolo_semantic_detection') and not arg('use_optimized_builtin_danger_pipeline'))"
        pkg="simenv_competitor"
        type="red_ball_detector.py" name="red_ball_detector" output="screen" required="false">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="room_only_gate" value="true"/>
    <param name="odom_topic" value="/simenv/fastlio_stabilized_odometry"/>
    <param name="rgb_topic" value="/real_sense/rgb/image_raw"/>
    <param name="depth_topic" value="/real_sense/depth/image_raw"/>
    <param name="camera_info_topic" value="/real_sense/rgb/camera_info"/>
    <param name="processing_rate_hz" value="8.0"/>
    <!-- Keep far room-side spheres that are visible to RGB-D; shape, metric
         diameter and multi-frame confirmation still reject red boxes. -->
    <param name="max_depth" value="8.0"/>
    <param name="maximum_ball_diameter_m" value="0.40"/>
    <param name="edge_hint_margin_px" value="20"/>
    <!-- Keep RGB-D output quiet during a detected FAST-LIO frame jump. -->
    <param name="maximum_pose_jump_m" value="0.75"/>
    <param name="pose_jump_hold_seconds" value="1.0"/>
    <param name="fallback_maximum_depth_mad_m" value="0.18"/>
    <param name="oblique_minimum_depth_convexity_m" value="0.018"/>
  </node>
  <node if="$(eval arg('enable_danger_detection') and not arg('use_optimized_builtin_danger_pipeline'))" pkg="simenv_competitor"
        type="hazard_candidate_tracker.py" name="hazard_candidate_tracker" output="screen" required="false">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="result_file" value="$(arg output_dir)/detected_danger.json"/>
    <param name="confirmed_file" value="$(arg output_dir)/confirmed_hazards.json"/>
    <param name="diagnostic_file" value="$(arg output_dir)/danger_detection_diagnostics.json"/>
    <!-- Learned detections of the same sphere shifted by up to ~0.9 m in the
         August reference run. The nearest two real balls are about 2.5 m
         apart, so 1.05 m merges duplicates without merging real hazards. -->
    <param name="cluster_radius_m" value="1.05"/>
    <param name="cross_room_duplicate_radius_m" value="0.60"/>
    <param name="cross_room_duplicate_max_vertical_m" value="0.80"/>
    <param name="minimum_observations" value="3"/>
    <!-- Confirm a physical sphere from either short translational parallax
         or the deliberate room sweep's angular parallax. -->
    <param name="minimum_view_baseline_m" value="0.12"/>
    <param name="minimum_view_yaw_diversity_deg" value="8.0"/>
    <!-- The short in-place sweep provides the planned re-observations. Keep
         translational verify goals off for the timed profile; they remain
         available for a diagnostic run through this explicit parameter. -->
    <param name="enable_verify_goal" value="false"/>
  </node>
  <node if="$(eval arg('enable_danger_detection') and arg('enable_visual_coverage_mapper'))" pkg="simenv_competitor"
        type="visual_coverage_mapper.py" name="visual_coverage_mapper" output="screen" required="false">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="odom_topic" value="/simenv/fastlio_stabilized_odometry"/>
    <param name="occupancy_topic" value="/simenv/voxel_floor_projection"/>
    <param name="camera_fov_deg" value="60.0"/>
    <param name="depth_topic" value="/real_sense/depth/image_raw"/>
    <param name="minimum_depth_valid_fraction" value="0.20"/>
  </node>
  <node if="$(arg enable_danger_detection)" pkg="simenv_competitor"
        type="room_visual_sweep_manager.py" name="room_visual_sweep_manager" output="screen" required="false">
    <param name="output_dir" value="$(arg output_dir)"/>
  </node>
</launch>
