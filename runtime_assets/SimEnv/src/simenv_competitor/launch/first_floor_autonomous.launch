<launch>
  <!--
    Formal first-floor stack.  Online decisions consume only onboard sensors,
    FAST-LIO pose and the public start pose used by compliant_tare_bridge.
    TARE, the legacy structure state machine, oracle nodes and GT recorders are
    intentionally not launched here.
  -->
  <arg name="run_dir" default="$(env PWD)/results/runs/manual_seed77"/>
  <arg name="timeout_seconds" default="150.0"/>
  <arg name="max_speed" default="2.0"/>
  <arg name="lio_odom_topic" default="/Odometry"/>
  <arg name="lio_cloud_topic" default="/cloud_registered"/>

  <node pkg="simenv_competitor" type="localization_health_monitor.py"
        name="localization_health_monitor" output="screen" required="true">
    <param name="output_file" value="$(arg run_dir)/localization_health_runtime.json"/>
    <param name="odom_topic" value="$(arg lio_odom_topic)"/>
    <param name="imu_topic" value="/trunk_imu"/>
    <param name="rolling_window_s" value="5.0"/>
    <param name="recovery_seconds" value="2.0"/>
    <param name="odom_stale_seconds" value="0.40"/>
    <param name="max_speed_mps" value="2.60"/>
  </node>

  <node pkg="simenv_competitor" type="controller_mode_bootstrap.py"
        name="controller_mode_bootstrap" output="screen" required="true">
    <param name="stand_after_seconds" value="0.5"/>
    <param name="rl_after_seconds" value="2.0"/>
    <param name="rl_repeat_seconds" value="40.0"/>
  </node>

  <node pkg="simenv_competitor" type="compliant_tare_bridge.py"
        name="compliant_tare_bridge" output="screen" required="true">
    <param name="lio_odom_topic" value="$(arg lio_odom_topic)"/>
    <param name="lio_cloud_topic" value="$(arg lio_cloud_topic)"/>
    <param name="base_frame" value="base"/>
    <param name="flip_loam_axes" value="false"/>
    <param name="forward_cmd_vel" value="false"/>
    <param name="planar_stabilize" value="true"/>
    <param name="use_imu_yaw" value="true"/>
    <param name="lock_z" value="0.28"/>
    <param name="max_pose_jump_m" value="1.0"/>
    <param name="max_yaw_jump_rad" value="1.40"/>
    <param name="max_lio_speed_mps" value="2.60"/>
    <param name="cmd_vel_dead_reckon" value="true"/>
    <param name="dr_stale_seconds" value="0.50"/>
    <param name="dr_max_speed" value="0.30"/>
    <param name="dr_max_burst_seconds" value="0.50"/>
  </node>

  <node pkg="simenv_competitor" type="online_floor_mapper.py"
        name="online_floor_mapper" output="screen" required="true">
    <param name="resolution" value="0.15"/>
    <param name="map_span_m" value="50.0"/>
    <param name="lidar_range" value="20.0"/>
    <param name="camera_range" value="6.0"/>
    <param name="camera_fov_deg" value="60.0"/>
    <param name="online_map_file" value="$(arg run_dir)/online_map.png"/>
    <param name="coverage_file" value="$(arg run_dir)/coverage_status.json"/>
  </node>

  <node pkg="move_base" type="move_base" name="move_base"
        output="screen" required="true">
    <rosparam command="load" file="$(find simenv_competitor)/config/navigation/move_base.yaml"/>
    <rosparam command="load" file="$(find simenv_competitor)/config/navigation/dwa.yaml"/>
    <rosparam command="load" file="$(find simenv_competitor)/config/navigation/global_costmap.yaml"/>
    <rosparam command="load" file="$(find simenv_competitor)/config/navigation/local_costmap.yaml"/>
    <rosparam command="load" file="$(find simenv_competitor)/config/navigation/costmap_common.yaml"
              ns="global_costmap"/>
    <rosparam command="load" file="$(find simenv_competitor)/config/navigation/costmap_common.yaml"
              ns="local_costmap"/>
    <remap from="cmd_vel" to="/simenv/desired_cmd_vel"/>
  </node>

  <node pkg="simenv_competitor" type="first_floor_mission_manager.py"
        name="first_floor_mission_manager" output="screen" required="true">
    <param name="mission_limit" value="$(arg timeout_seconds)"/>
    <param name="maximum_rooms" value="4"/>
    <param name="room_first_pass_limit" value="14.0"/>
    <param name="home_tolerance" value="0.7"/>
    <param name="room_status_file" value="$(arg run_dir)/room_status.json"/>
    <param name="route_file" value="$(arg run_dir)/topological_route.json"/>
    <param name="corridor_lookahead" value="6.0"/>
    <param name="door_confirmations" value="3"/>
  </node>

  <node pkg="simenv_competitor" type="adaptive_speed_guard.py"
        name="adaptive_speed_guard" output="screen" required="true">
    <param name="maximum_speed" value="$(arg max_speed)"/>
    <param name="maximum_yaw_rate" value="0.80"/>
    <param name="acceleration" value="0.70"/>
    <param name="deceleration" value="2.50"/>
  </node>

  <node pkg="simenv_competitor" type="compliant_fall_recovery.py"
        name="compliant_fall_recovery" output="screen">
    <param name="recover_cooldown" value="15.0"/>
    <param name="start_grace_seconds" value="20.0"/>
    <param name="confirm_count" value="10"/>
    <param name="use_gazebo_reset" value="false"/>
  </node>

  <node pkg="simenv_competitor" type="trajectory_recorder.py"
        name="online_trajectory_recorder" output="screen">
    <param name="output_file" value="$(arg run_dir)/trajectory_estimate.json"/>
    <param name="odom_topic" value="/state_estimation"/>
    <param name="min_spacing" value="0.08"/>
  </node>

  <node pkg="simenv_competitor" type="danger_detector.py"
        name="danger_detector" output="screen" required="true">
    <param name="result_file" value="$(arg run_dir)/detected_danger.json"/>
    <param name="relative_result_file" value="$(arg run_dir)/detected_danger_relative.json"/>
    <param name="timeout_seconds" value="$(arg timeout_seconds)"/>
    <param name="deadline_margin_s" value="0.10"/>
    <param name="timeout_fallback_seconds" value="5.0"/>
    <param name="home_tolerance" value="0.7"/>
    <param name="minimum_hits" value="3"/>
    <param name="minimum_views" value="2"/>
    <param name="minimum_view_angle_deg" value="12.0"/>
    <param name="minimum_viewpoint_baseline_m" value="0.4"/>
    <param name="minimum_area" value="40.0"/>
    <param name="minimum_circularity" value="0.72"/>
    <param name="minimum_fill_ratio" value="0.66"/>
    <param name="minimum_extent" value="0.48"/>
    <param name="diameter_min" value="0.10"/>
    <param name="diameter_max" value="0.34"/>
    <param name="max_detection_range" value="6.0"/>
    <param name="dedup_radius" value="0.6"/>
  </node>
</launch>
