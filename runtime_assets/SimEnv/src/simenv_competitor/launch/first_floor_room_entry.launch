<launch>
  <!--
    Room-entry focused compliant stack (do not sync-overwrite this file).
    fixed-stand during LIO -> joy RL -> cmd_vel_guard -> TARE + lobby seed
  -->
  <arg name="result_file" default="$(env PWD)/results/detected_danger.json"/>
  <arg name="trajectory_file" default="$(env PWD)/results/compliant_trajectory.json"/>
  <arg name="gt_trajectory_file" default="$(env PWD)/results/compliant_trajectory_gt.json"/>
  <arg name="raw_lio_trajectory_file" default="$(env PWD)/results/compliant_lio_raw.json"/>
  <arg name="timeout_seconds" default="150.0"/>
  <arg name="max_speed" default="2.0"/>
  <arg name="sensor_range" default="9.0"/>
  <arg name="lio_odom_topic" default="/Odometry"/>
  <arg name="lio_cloud_topic" default="/cloud_registered"/>
  <arg name="localization_health_file" default="$(env PWD)/results/localization_health_runtime.json"/>
  <arg name="online_coverage_file" default="$(env PWD)/results/compliant_online_coverage.json"/>
  <arg name="speed_audit_file" default="$(env PWD)/results/compliant_speed_audit.json"/>

  <node pkg="simenv_competitor" type="localization_health_monitor.py"
        name="localization_health_monitor" output="screen" required="true">
    <param name="output_file" value="$(arg localization_health_file)"/>
    <param name="odom_topic" value="$(arg lio_odom_topic)"/>
    <param name="imu_topic" value="/trunk_imu"/>
    <param name="rolling_window_s" value="5.0"/>
    <param name="recovery_seconds" value="2.0"/>
    <param name="odom_stale_seconds" value="0.40"/>
    <param name="max_speed_mps" value="2.60"/>
  </node>

  <node pkg="simenv_competitor" type="speed_audit.py"
        name="speed_audit" output="screen">
    <param name="output_file" value="$(arg speed_audit_file)"/>
    <param name="target_max_speed" value="$(arg max_speed)"/>
  </node>

  <node pkg="simenv_competitor" type="controller_mode_bootstrap.py"
        name="controller_mode_bootstrap" output="screen" required="true">
    <param name="stand_after_seconds" value="0.5"/>
    <param name="rl_after_seconds" value="2.0"/>
    <param name="rl_repeat_seconds" value="40.0"/>
  </node>

  <node pkg="simenv_competitor" type="compliant_tare_bridge.py"
        name="compliant_tare_bridge" output="screen" required="true">
    <param name="lio_odom_topic" value="$(arg lio_odom_topic)"/>
    <param name="lio_cloud_topic" value="$(arg lio_cloud_topic)"/>
    <param name="flip_loam_axes" value="false"/>
    <param name="forward_cmd_vel" value="false"/>
    <param name="planar_stabilize" value="true"/>
    <param name="lock_z" value="0.28"/>
    <!-- Reject hard jumps/Y-flips; allow normal crawl (~0.5m/s) without freeze. -->
    <param name="max_pose_jump_m" value="1.0"/>
    <param name="max_yaw_jump_rad" value="1.40"/>
    <param name="max_lio_speed_mps" value="2.60"/>
    <!-- Dead-reckon invents wall-crossing paths when LIVO stalls (run5). -->
    <param name="cmd_vel_dead_reckon" value="false"/>
    <param name="dr_stale_seconds" value="0.80"/>
    <param name="dr_max_speed" value="0.46"/>
    <param name="dr_max_burst_seconds" value="35.0"/>
  </node>

  <node pkg="simenv_competitor" type="cmd_vel_guard.py"
        name="cmd_vel_guard" output="screen" required="true">
    <param name="start_delay" value="0.5"/>
    <param name="ramp_seconds" value="3.0"/>
    <param name="max_linear_speed" value="$(arg max_speed)"/>
    <param name="max_yaw_rate" value="0.45"/>
    <param name="max_lateral_speed" value="0.0"/>
    <param name="max_linear_acceleration" value="0.70"/>
    <param name="max_linear_deceleration" value="2.50"/>
    <param name="turn_linear_scale" value="0.55"/>
    <param name="turn_yaw_threshold" value="0.20"/>
    <param name="egress_turn_linear_scale" value="0.95"/>
    <param name="turn_yaw_threshold" value="0.28"/>
  </node>

  <node pkg="simenv_competitor" type="structure_aware_explorer.py"
        name="structure_aware_explorer" output="screen">
    <param name="cruise_speed" value="0.52"/>
    <param name="boost_speed" value="$(arg max_speed)"/>
    <param name="crawl_speed" value="0.24"/>
    <param name="max_yaw_rate" value="0.45"/>
    <param name="corridor_half_min" value="0.45"/>
    <param name="corridor_half_max" value="1.6"/>
    <param name="corridor_width_max" value="3.2"/>
    <param name="door_open_range" value="2.1"/>
    <param name="door_closed_range" value="2.15"/>
    <param name="door_asym_m" value="0.95"/>
    <param name="room_width_min" value="5.0"/>
    <param name="wall_follow_dist" value="0.90"/>
    <param name="enter_min_depth" value="1.0"/>
    <param name="enter_timeout_s" value="14.0"/>
    <param name="enter_abort_cooldown_s" value="3.0"/>
    <!-- Coverage is bounded by at most three qualified viewpoints, not time. -->
    <param name="room_timeout_s" value="0.0"/>
    <param name="room_target_depth_m" value="3.0"/>
    <param name="room_target_span_m" value="1.7"/>
    <param name="room_min_path_m" value="4.0"/>
    <param name="exit_timeout_s" value="12.0"/>
    <param name="scan_period_s" value="8.0"/>
    <param name="scan_duration_s" value="1.8"/>
    <param name="max_rooms" value="4"/>
    <param name="min_door_spacing_y" value="8.0"/>
    <param name="min_door_y" value="0.0"/>
    <param name="min_corridor_travel_m" value="3.5"/>
    <param name="pair_door_window_m" value="3.5"/>
    <param name="prefer_open_min" value="1.70"/>
    <param name="cover_exit_ratio" value="0.40"/>
    <param name="look_max_s" value="2.0"/>
    <param name="look_hold_s" value="0.85"/>
    <param name="max_looks_per_room" value="5"/>
    <param name="relative_room_sweep" value="true"/>
    <param name="adaptive_room_viewpoints" value="true"/>
    <param name="room_grid_resolution_m" value="0.15"/>
    <param name="robot_inflation_m" value="0.45"/>
    <param name="first_view_depth_m" value="3.4"/>
    <param name="room_min_viewpoints" value="2"/>
    <param name="room_max_viewpoints" value="3"/>
    <param name="room_min_viewpoint_baseline_m" value="1.2"/>
    <param name="room_min_lateral_span_m" value="1.4"/>
    <param name="room_viewpoint_speed" value="0.65"/>
    <param name="room_lidar_complete_ratio" value="0.92"/>
    <param name="room_viewpoint_min_gain" value="0.08"/>
    <param name="room_shadow_max_m2" value="0.50"/>
    <param name="room_boundary_min_directions" value="2"/>
    <param name="viewpoint_tolerance_m" value="0.35"/>
    <param name="pan_yaw_rate" value="0.35"/>
    <param name="pan_heading_dwell_s" value="0.40"/>
    <param name="corridor_anchor_offset_m" value="0.90"/>
    <param name="exit_anchor_tolerance_m" value="0.35"/>
    <param name="exit_alignment_radius_m" value="0.80"/>
    <param name="camera_range" value="5.8"/>
    <param name="camera_fov_deg" value="60.0"/>
    <param name="room_diagnostic_file" value="$(arg online_coverage_file)"/>
    <!-- Unknown-scene policy: enter the first geometrically valid doorway. -->
    <param name="prefer_side" value="0"/>
  </node>

  <node pkg="simenv_competitor" type="lobby_egress_seed.py"
        name="lobby_egress_seed" output="screen">
    <!-- Lobby y&lt;7.85; corridor mouth |x|&lt;1.1. Stay active until past mouth. -->
    <param name="exit_y" value="12.0"/>
    <param name="exit_distance" value="10.0"/>
    <param name="min_travel_m" value="8.0"/>
    <param name="structure_hits_needed" value="3"/>
    <param name="front_clear_m" value="1.8"/>
    <param name="goal_x" value="0.0"/>
    <param name="goal_y" value="15.5"/>
    <param name="mouth_y" value="8.2"/>
    <param name="mouth_half_width" value="1.0"/>
    <param name="min_north_finish" value="5.5"/>
    <param name="max_seconds" value="40.0"/>
    <param name="crawl_speed" value="0.55"/>
    <param name="straight_speed" value="$(arg max_speed)"/>
    <param name="motion_delay" value="1.0"/>
    <param name="max_yaw" value="0.42"/>
    <param name="yaw_gain" value="1.40"/>
    <param name="x_gain" value="0.95"/>
    <param name="reverse_if_no_progress_s" value="12.0"/>
    <param name="corridor_yaw" value="1.5708"/>
  </node>

  <node pkg="simenv_competitor" type="compliant_fall_recovery.py"
        name="compliant_fall_recovery" output="screen">
    <param name="recover_cooldown" value="15.0"/>
    <param name="start_grace_seconds" value="40.0"/>
    <param name="confirm_count" value="10"/>
    <param name="use_gazebo_reset" value="false"/>
  </node>

  <group>
    <!-- Direct pure-pursuit follower: CMU localPlanner stalls on sparse Livox. -->
    <node pkg="simenv_competitor" type="compliant_waypoint_follower.py"
          name="compliant_waypoint_follower" output="screen" required="true">
      <param name="start_delay" value="2.0"/>
      <param name="max_speed" value="$(arg max_speed)"/>
      <param name="max_yaw_rate" value="0.30"/>
      <param name="goal_tolerance" value="0.65"/>
      <param name="min_speed" value="0.08"/>
      <param name="heading_align_rad" value="0.50"/>
      <param name="scan_enable" value="false"/>
      <param name="scan_period" value="10.0"/>
      <param name="scan_duration" value="2.4"/>
      <param name="scan_yaw_rate" value="0.40"/>
    </node>
  </group>

  <node pkg="tare_planner" type="tare_planner_node"
        name="tare_planner_node" output="screen" required="true"
        ns="sensor_coverage_planner">
    <rosparam command="load" file="$(find tare_planner)/config/indoor.yaml"/>
    <rosparam command="load"
              file="$(find simenv_competitor)/config/fast_indoor_unknown.yaml"/>
    <param name="kAutoStart" value="true"/>
    <param name="kRushHome" value="true"/>
    <param name="kNoExplorationReturnHome" value="true"/>
    <param name="kAtHomeDistThreshold" value="1.0"/>
    <param name="kSensorRange" value="$(arg sensor_range)"/>
    <param name="kLookAheadDistance" value="4.0"/>
    <param name="kExtendWayPointDistanceBig" value="4.0"/>
    <param name="kExtendWayPointDistanceSmall" value="2.0"/>
    <param name="viewpoint_manager/number_z" value="1"/>
  </node>

  <node pkg="simenv_competitor" type="radar_camera_attention.py"
        name="radar_camera_attention" output="screen">
    <!-- Keep false: own /cmd_vel fights cmd_vel_guard. Follower does scan spins. -->
    <param name="own_cmd_vel" value="false"/>
    <param name="attention_spacing" value="4.0"/>
    <param name="min_viewpoint_score" value="0.15"/>
  </node>

  <node pkg="simenv_competitor" type="trajectory_recorder.py"
        name="trajectory_recorder" output="screen">
    <param name="output_file" value="$(arg trajectory_file)"/>
    <param name="odom_topic" value="/state_estimation"/>
    <!-- Diagnostic only: not used by exploration stack. -->
    <param name="gt_output_file" value="$(arg gt_trajectory_file)"/>
    <param name="gt_odom_topic" value="/ground_truth/base_w"/>
    <param name="min_spacing" value="0.08"/>
  </node>

  <node pkg="simenv_competitor" type="trajectory_recorder.py"
        name="raw_lio_trajectory_recorder" output="screen">
    <param name="output_file" value="$(arg raw_lio_trajectory_file)"/>
    <param name="odom_topic" value="$(arg lio_odom_topic)"/>
    <param name="min_spacing" value="0.08"/>
  </node>

  <node pkg="simenv_competitor" type="danger_detector.py"
        name="danger_detector" output="screen" required="true">
    <param name="result_file" value="$(arg result_file)"/>
    <param name="timeout_seconds" value="$(arg timeout_seconds)"/>
    <param name="home_tolerance" value="0.8"/>
    <param name="deadline_margin_s" value="0.30"/>
    <!-- Spheres are round+compact; red-box distractors fail circularity/fill. -->
    <!-- Timestamped projection + distinct-yaw confirmation replaces the old
         drift-masking 1.7 m merge radius. -->
    <param name="minimum_hits" value="3"/>
    <param name="minimum_views" value="2"/>
    <param name="minimum_view_angle_deg" value="12.0"/>
    <param name="pose_history_seconds" value="2.5"/>
    <param name="max_pose_skew_s" value="0.12"/>
    <param name="minimum_area" value="40.0"/>
    <param name="minimum_circularity" value="0.74"/>
    <param name="minimum_fill_ratio" value="0.66"/>
    <param name="minimum_extent" value="0.48"/>
    <param name="min_depth_samples" value="6"/>
    <param name="max_depth" value="5.8"/>
    <param name="aspect_min" value="0.72"/>
    <param name="aspect_max" value="1.35"/>
    <param name="hsv_s_min" value="90"/>
    <param name="hsv_v_min" value="50"/>
    <param name="diameter_min" value="0.10"/>
    <param name="diameter_max" value="0.34"/>
    <param name="world_z_min" value="0.06"/>
    <param name="world_z_max" value="0.42"/>
    <param name="dedup_radius" value="0.6"/>
    <param name="max_detection_range" value="6.2"/>
    <param name="skip_dead_reckon_detections" value="false"/>
    <param name="world_x_min" value="-9.8"/>
    <param name="world_x_max" value="9.8"/>
    <param name="world_y_min" value="0.5"/>
    <param name="world_y_max" value="36.0"/>
  </node>
</launch>
