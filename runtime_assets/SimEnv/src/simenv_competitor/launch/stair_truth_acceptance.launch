<launch>
  <!-- Physical two-flight acceptance test.  It reuses the known-stable
       official A1 stair harness, then starts only the stair transition
       manager's explicit truth bridge.  No exploration, mapping or planner
       node is present. -->
  <arg name="output_dir" default="$(find simenv_competitor)/../../results/stair_truth_acceptance_run1"/>
  <arg name="ascent_timeout_sec" default="45.0"/>
  <include file="$(find simenv_competitor)/../../refer/stair_climb_test.launch">
    <arg name="world_file" value="$(find simenv_competitor)/../../generated_building/stair_test/competition_scene.world"/>
    <arg name="rl_policy" value="$(find unitree_guide)/../../logs/policy_act_inference_stair.pt"/>
  </include>
  <node pkg="simenv_competitor" type="stair_transition_manager.py"
        name="stair_transition_manager" output="screen" required="true">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="stair_policy" value="$(find unitree_guide)/../../logs/policy_act_inference_stair.pt"/>
    <param name="auto_start" value="true"/>
    <param name="truth_entry_guide" value="true"/>
    <param name="policy_preloaded" value="true"/>
    <param name="two_flight_stair" value="true"/>
    <param name="ascent_speed_mps" value="0.80"/>
    <param name="ascent_maximum_speed_mps" value="0.80"/>
    <param name="ascent_timeout_sec" value="$(arg ascent_timeout_sec)"/>
    <!-- Parameters copied from the successful official two-flight harness. -->
    <param name="landing_turn_speed_rps" value="0.35"/>
    <param name="landing_heading_tolerance_rad" value="0.15"/>
    <param name="landing_timeout_sec" value="30.0"/>
    <param name="world_frame_ascent" value="true"/>
    <param name="offline_stair_model_sdf" value="$(find simenv_competitor)/../../generated_building/stair_test/competition_scene.world"/>
  </node>
</launch>
